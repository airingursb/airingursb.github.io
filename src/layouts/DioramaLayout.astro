---
import Icon from '../components/diorama/Icon.astro';
import '../diorama/world.css';
interface Props { title: string; description: string; number?: string; comicIssue?: number; }
const { title, description, number, comicIssue } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · 日常箱庭 · Airing</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#f1efe8" data-dw-theme-color />
  <script is:inline>
    // M3: follow the reader's site-wide choice (BaseLayout keys). The diorama
    // sheet itself stays light on purpose (DESIGN.md, print surfaces in dark
    // mode); only the desk around it, the masthead and footer go dark.
    (function () {
      var m = null;
      try { if (localStorage.getItem('blog-mode-set')) m = localStorage.getItem('blog-mode'); } catch (e) {}
      var mode = m === 'dark' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-mode', mode);
      var meta = document.querySelector('meta[data-dw-theme-color]');
      if (meta) meta.setAttribute('content', mode === 'dark' ? '#0d1117' : '#f1efe8');
    })();
  </script>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=avatar48-v2" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=avatar48-v2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=avatar48-v2" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=avatar48-v2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=avatar48-v2" />
</head>
<body>
  <a class="skip-link" href="#main-content">跳到正文</a>
  <header class="masthead">
    <a href="/diorama/" class="brand" aria-label="日常箱庭 · 全部收藏"><span class="brand-mark"><Icon name="cube" /></span><span>日常箱庭<small>LITTLE KEEPSAKES</small></span></a>
    <div class="mast-center"><span class="small-dot"></span> AIRING’S COLLECTION <span class="mast-slash">/</span> {number ?? 'INDEX'}</div>
    <nav class="collection-nav" aria-label="箱庭导航">
      {number && <a class="back-link" href="/diorama/">全部箱庭</a>}
      <a class="back-link" href={comicIssue ? `/comics/${comicIssue}/` : '/'}><Icon name="arrow" /><span>{comicIssue ? '回到四格' : '回到主页'}</span></a>
      <button type="button" class="dw-mode" data-dw-mode aria-label="切换深色 / 浅色" title="切换深色 / 浅色">
        <svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3.5"/><path d="M8 .5v2M8 13.5v2M.5 8h2M13.5 8h2M2.7 2.7l1.4 1.4M11.9 11.9l1.4 1.4M2.7 13.3l1.4-1.4M11.9 4.1l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.5a5.5 5.5 0 01-7-7 5.5 5.5 0 107 7z"/></svg>
      </button>
    </nav>
  </header>
  <slot />
  <footer><span>MADE OF DAYS WE WANT TO KEEP.</span><span>Airing & Moflow <span class="footer-dot">·</span> 日常箱庭</span></footer>
  <script is:inline>
    (function () {
      var button = document.querySelector('[data-dw-mode]');
      if (!button) return;
      button.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-mode', next);
        try { localStorage.setItem('blog-mode', next); localStorage.setItem('blog-mode-set', '1'); } catch (e) {}
        var meta = document.querySelector('meta[data-dw-theme-color]');
        if (meta) meta.setAttribute('content', next === 'dark' ? '#0d1117' : '#f1efe8');
        if (typeof umami !== 'undefined') umami.track('dark-mode-toggle', { mode: next, surface: 'diorama' });
      });
    })();
  </script>
</body>
</html>
<style>
  .collection-nav { display:flex; gap:24px; align-items:center; }
  .back-link:hover { text-decoration:underline; }
  .dw-mode { display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px; padding:0; border:0; border-radius:50%; background:transparent; color:var(--dw-ink); }
  .dw-mode:hover { background:var(--dw-soft); }
  .dw-mode svg { width:16px; height:16px; }
  .dw-mode .moon { display:none; }
  :global(html[data-mode="dark"]) .dw-mode .sun { display:none; }
  :global(html[data-mode="dark"]) .dw-mode .moon { display:block; }
  .back-link { white-space:nowrap; }
  @media(max-width:540px) { .collection-nav { gap:8px; } .back-link svg { display:none; } }
  @media(max-width:420px) { .masthead :global(.brand small) { display:none; } .collection-nav { gap:4px; } .dw-mode { margin-right:-10px; } }
</style>
