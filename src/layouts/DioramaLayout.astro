---
import Icon from '../components/diorama/Icon.astro';
import '../diorama/world.css';
interface Props { title: string; description: string; number?: string; comicIssue?: number; }
const { title, description, number, comicIssue } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · 日常箱庭 · Airing</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#f1efe8" />
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
  <a class="skip-link" href="#main-content">跳到正文</a>
  <header class="masthead">
    <a href="/diorama/" class="brand" aria-label="日常箱庭 · 全部收藏"><span class="brand-mark"><Icon name="cube" /></span><span>日常箱庭<small>LITTLE KEEPSAKES</small></span></a>
    <div class="mast-center"><span class="small-dot"></span> AIRING’S COLLECTION <span class="mast-slash">/</span> {number ?? 'INDEX'}</div>
    <nav class="collection-nav" aria-label="箱庭导航">
      {number && <a class="back-link" href="/diorama/">全部箱庭</a>}
      <a class="back-link" href={comicIssue ? `/comics/${comicIssue}/` : '/'}><Icon name="arrow" /><span>{comicIssue ? '回到四格' : '回到主页'}</span></a>
    </nav>
  </header>
  <slot />
  <footer><span>MADE OF DAYS WE WANT TO KEEP.</span><span>Airing & Moflow <span class="footer-dot">·</span> 日常箱庭</span></footer>
</body>
</html>
<style>
  .collection-nav { display:flex; gap:24px; align-items:center; }
  .back-link:hover { text-decoration:underline; }
  @media(max-width:540px) { .collection-nav { gap:12px; } .back-link svg { display:none; } }
</style>
