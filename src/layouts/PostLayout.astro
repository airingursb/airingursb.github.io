<script is:inline>
(function() {
  var API = 'https://chat.ursb.me';
  // Normalize both /posts/foo/ and /en/posts/foo/ to the same slug so EN and ZH
  // pages share view counts, likes, comments, and inline comments.
  var POST_SLUG = location.pathname.replace(/^\/(?:en\/)?posts\//, '').replace(/\/$/, '');
  var USER_KEY = 'blog-user-identity';
  // zh and en share one inline-comment pool (same slug). A highlight is
  // anchored to a language-independent block id (data-aid) + the quoted text.
  // PAGE_LANG lets us decide: same language → paint the exact words; other
  // language → mark the corresponding block (words can't match across langs).
  var PAGE_LANG = (function() {
    var pp = document.querySelector('.post-page');
    return (pp && pp.getAttribute('data-lang') === 'en') ? 'en' : 'zh';
  })();
  function hasCJK(s) { return /[\u3400-\u9fff\uf900-\ufaff]/.test(s || ''); }
  // Origin language of a comment: explicit column if present, else inferred
  // from the quoted text's script (legacy rows created before the lang column).
  function commentLang(c) { return c.lang || (hasCJK(c.selected_text) ? 'zh' : 'en'); }

  // Track pageview (fire-and-forget). Never write local-dev traffic to prod.
  var host = location.hostname;
  if (host === 'ursb.me' || host === 'www.ursb.me' || host === 'airingursb.github.io') {
    fetch(API + '/api/posts/' + encodeURIComponent(POST_SLUG) + '/view', { method: 'POST' }).catch(function() {});
  }

  // Fetch and display view count (only show if >= 1000)
  fetch(API + '/api/posts/' + encodeURIComponent(POST_SLUG) + '/views')
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var pv = d.pv || 0;
      if (pv >= 1000) {
        var el = document.getElementById('postViews');
        var block = document.getElementById('postViewsBlock');
        if (el) el.textContent = pv.toLocaleString();
        if (block) block.style.display = '';
      }
    })
    .catch(function() {});

  // Article like
  var articleLikeBtn = document.getElementById('articleLikeBtn');
  var articleLikeCount = document.getElementById('articleLikeCount');

  // --- API helpers (likes; comments live in components/comments) ---
  function handleResponse(r) {
    return r.json().then(function(data) {
      if (!r.ok) return Promise.reject(data);
      return data;
    });
  }
  function apiGet(path) {
    return fetch(API + path, { headers: { 'Origin': location.origin } }).then(handleResponse);
  }
  function apiPost(path, body) {
    return fetch(API + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).then(handleResponse);
  }

  // =====================================================================
  // ARTICLE LIKES
  // =====================================================================
  var articleLiked = false;

  function loadArticleLikes() {
    apiGet('/api/posts/' + encodeURIComponent(POST_SLUG) + '/likes').then(function(res) {
      articleLikeCount.textContent = res.count;
      articleLiked = res.liked;
      if (articleLiked) articleLikeBtn.classList.add('liked');
      // Populate sidebar likes
      if (res.count > 0) {
        var lkEl = document.getElementById('postLikesCount');
        var lkBlock = document.getElementById('postLikesBlock');
        if (lkEl) lkEl.textContent = res.count.toLocaleString();
        if (lkBlock) lkBlock.style.display = '';
      }
      renderLikeRegions(res.regions, res.regionCount, res.located);
      // Sync localStorage with server state
      try {
        var stored = JSON.parse(localStorage.getItem('post_likes') || '[]');
        var set = new Set(stored);
        if (res.liked) set.add(POST_SLUG); else set.delete(POST_SLUG);
        localStorage.setItem('post_likes', JSON.stringify(Array.from(set)));
      } catch(e) {}
    });
  }

  // Region distribution under the like button. The displayed like count mixes in
  // synthetic baselines and pre-2026-03 migration placeholders that can never be
  // geo-located, so the distribution only ever covers the *locatable* likes — and
  // we only show it when that sample is substantial enough to be representative
  // (>=8 located likes across >=3 regions). The popover footer states the basis.
  var AL_MIN_LOCATED = 8;
  var AL_MIN_REGIONS = 3;
  var alRegions = document.getElementById('alRegions');
  var alRegionsFlags = document.getElementById('alRegionsFlags');
  var alRegionsLabel = document.getElementById('alRegionsLabel');
  var alRegionsPop = document.getElementById('alRegionsPop');

  function ccFlagImg(cc, label) {
    var up = String(cc || '').toUpperCase();
    if (!/^[A-Z]{2}$/.test(up)) return '';
    return '<img class="c-flag" src="/flags/' + up.toLowerCase() + '.svg" alt="' + esc(up) +
      '" title="' + esc(label || up) + '" loading="lazy" onerror="this.style.display=\'none\'" />';
  }
  function ccName(cc) {
    var up = String(cc || '').toUpperCase();
    if (_regionNames) { try { return _regionNames.of(up) || up; } catch (e) {} }
    return up;
  }

  // Sidebar "Readers" module — region distribution of (deduped, bot-filtered)
  // viewers. Shows top 5; clicking "+N 个地区" expands the full list. Hidden
  // unless the sample is substantial (>=20 located readers across >=3 regions).
  var VG_TOP = 5, VG_MIN_LOCATED = 20, VG_MIN_REGIONS = 3;
  function loadViewRegions() {
    var block = document.getElementById('viewGeoBlock');
    if (!block) return;
    apiGet('/api/posts/' + encodeURIComponent(POST_SLUG) + '/view-regions').then(function (res) {
      var regions = (res && res.regions) || [];
      var located = (res && res.located) || 0;
      var regionCount = (res && res.regionCount) || regions.length;
      if (regionCount < VG_MIN_REGIONS || located < VG_MIN_LOCATED) return;

      var list = document.getElementById('vgList');
      var toggle = document.getElementById('vgToggle');
      var expanded = false;

      function rowHtml(r) {
        var pct = Math.round(r.count / located * 100);
        var pctStr = (pct < 1 ? '<1%' : pct + '%');
        return '<div class="vg-row">' + ccFlagImg(r.cc, ccName(r.cc)) +
          '<span class="vg-name">' + esc(ccName(r.cc)) + '</span>' +
          '<span class="vg-pct">' + pctStr + '</span></div>';
      }
      function render() {
        var shown = expanded ? regions : regions.slice(0, VG_TOP);
        list.innerHTML = shown.map(rowHtml).join('');
        if (regionCount > VG_TOP) {
          toggle.style.display = '';
          toggle.textContent = expanded ? '收起' : '+ ' + (regionCount - VG_TOP) + ' 个地区';
        }
      }
      toggle.addEventListener('click', function () { expanded = !expanded; render(); });
      render();
      block.style.display = '';
    }).catch(function () {});
  }

  function renderLikeRegions(regions, regionCount, located) {
    if (!alRegions || !regions) return;
    located = located || regions.reduce(function (s, r) { return s + r.count; }, 0);
    if (regionCount < AL_MIN_REGIONS || located < AL_MIN_LOCATED) return;
    // Up to 5 flags inline; the rest live in the hover popover.
    alRegionsFlags.innerHTML = regions.slice(0, 5).map(function (r) {
      return ccFlagImg(r.cc, ccName(r.cc) + ' · ' + r.count);
    }).join('');
    alRegionsLabel.textContent = '来自 ' + regionCount + ' 个地区';
    alRegionsPop.innerHTML =
      '<span class="al-rp-title">点赞地区分布</span>' +
      regions.map(function (r) {
        var pct = Math.round(r.count / located * 100);
        return '<span class="al-rp-row">' +
          '<span class="al-rp-name">' + ccFlagImg(r.cc, ccName(r.cc)) + esc(ccName(r.cc)) + '</span>' +
          '<span class="al-rp-bar"><span class="al-rp-fill" style="width:' + pct + '%"></span></span>' +
          '<span class="al-rp-count">' + r.count + '</span>' +
        '</span>';
      }).join('') +
      '<span class="al-rp-foot">基于 ' + located + ' 个可定位的赞</span>';
    alRegions.style.display = '';
  }

  articleLikeBtn.addEventListener('click', function() {
    // Optimistic update — instant UI feedback
    var prevLiked = articleLiked;
    var prevCount = parseInt(articleLikeCount.textContent) || 0;
    var newLiked = !prevLiked;
    var newCount = newLiked ? prevCount + 1 : Math.max(0, prevCount - 1);

    articleLiked = newLiked;
    articleLikeCount.textContent = newCount;
    articleLikeBtn.classList.toggle('liked', newLiked);
    var icon = articleLikeBtn.querySelector('.al-icon path');
    icon.setAttribute('fill', newLiked ? 'currentColor' : 'none');

    apiPost('/api/posts/' + encodeURIComponent(POST_SLUG) + '/like', {}).then(function(res) {
      // Sync with server truth
      articleLiked = res.liked;
      articleLikeCount.textContent = res.count;
      articleLikeBtn.classList.toggle('liked', res.liked);
      icon.setAttribute('fill', res.liked ? 'currentColor' : 'none');
      if (res.liked === true && prevLiked === false) {
        articleLikeBtn.dispatchEvent(new CustomEvent('article:liked', { bubbles: true }));
      }
      // Update sidebar likes
      var lkEl = document.getElementById('postLikesCount');
      var lkBlock = document.getElementById('postLikesBlock');
      if (res.count > 0) {
        if (lkEl) lkEl.textContent = res.count.toLocaleString();
        if (lkBlock) lkBlock.style.display = '';
      } else {
        if (lkBlock) lkBlock.style.display = 'none';
      }
      // Persist liked state to localStorage
      try {
        var stored = JSON.parse(localStorage.getItem('post_likes') || '[]');
        var set = new Set(stored);
        if (res.liked) set.add(POST_SLUG); else set.delete(POST_SLUG);
        localStorage.setItem('post_likes', JSON.stringify(Array.from(set)));
      } catch(e) {}
    }).catch(function() {
      // Rollback on failure
      articleLiked = prevLiked;
      articleLikeCount.textContent = prevCount;
      articleLikeBtn.classList.toggle('liked', prevLiked);
      icon.setAttribute('fill', prevLiked ? 'currentColor' : 'none');
    });
  });

  // =====================================================================
  // BOTTOM COMMENTS — rendered by src/components/comments (CommentsRuntime);
  // the shared runtime reports the count so the sidebar can show it.
  // =====================================================================
  document.addEventListener('comments:count', function(e) {
    var count = e.detail && e.detail.count;
    if (!(count > 0)) return;
    var cmEl = document.getElementById('postCommentsCount');
    var cmBlock = document.getElementById('postCommentsBlock');
    if (cmEl) cmEl.textContent = count.toLocaleString();
    if (cmBlock) cmBlock.style.display = '';
  });

  loadArticleLikes();
  // loadViewRegions();  // disabled 2026-06-26: raw view traffic is bot-skewed
  // (US residential-proxy crawlers survive datacenter + UA + engagement filters),
  // so the region map misrepresents the real audience. Code kept for a possible
  // filtered revival; the clean signal is the likes-based map at the article foot.

  // --- Helpers ---
  function esc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  var _regionNames = null;
  try { _regionNames = new Intl.DisplayNames(['zh-CN'], { type: 'region' }); } catch (e) {}
})();
</script>
