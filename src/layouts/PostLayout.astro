<script is:inline>
/* Click-to-zoom lightbox for post images — pointer and keyboard */
(function() {
  var container = document.querySelector('.post-content');
  if (!container) return;
  var page = document.querySelector('.post-page');
  var en = page && page.getAttribute('data-lang') === 'en';
  var T = en
    ? { zoom: 'Enlarge image', zoomed: 'Enlarged image', close: 'Close' }
    : { zoom: '放大图片', zoomed: '放大的图片', close: '关闭' };

  // Zoomable images become keyboard targets. Linked images keep their link.
  function zoomable(img) {
    return img && !img.closest('a') && !img.closest('.katex');
  }
  container.querySelectorAll('img').forEach(function(img) {
    if (!zoomable(img)) return;
    img.setAttribute('tabindex', '0');
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', img.alt ? T.zoom + '：' + img.alt : T.zoom);
    img.classList.add('is-zoomable');
  });

  var overlay = null;
  var opener = null;
  function onKey(e) {
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'Tab' && overlay) {
      // Single focusable control: keep focus inside the dialog.
      e.preventDefault();
      var btn = overlay.querySelector('.img-zoom-close');
      if (btn) btn.focus();
    }
  }
  function close() {
    if (!overlay) return;
    var o = overlay; overlay = null;
    o.classList.remove('open');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKey);
    setTimeout(function() { if (o.parentNode) o.parentNode.removeChild(o); }, 220);
    if (opener && document.contains(opener)) opener.focus({ preventScroll: true });
    opener = null;
  }
  function open(img) {
    if (overlay) close();
    opener = img;
    overlay = document.createElement('div');
    overlay.className = 'img-zoom-overlay';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', img.alt ? T.zoomed + '：' + img.alt : T.zoomed);
    var big = document.createElement('img');
    big.src = img.currentSrc || img.src;
    big.alt = img.alt || '';
    big.className = 'img-zoom-img';
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'img-zoom-close';
    btn.setAttribute('aria-label', T.close);
    btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
    overlay.appendChild(big);
    overlay.appendChild(btn);
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function() { if (overlay) overlay.classList.add('open'); });
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', onKey);
    btn.focus({ preventScroll: true });
    if (typeof umami !== 'undefined') umami.track('image-zoom', { src: big.src });
  }

  container.addEventListener('click', function(e) {
    var img = e.target.closest('img');
    if (!img || !container.contains(img)) return;
    if (!zoomable(img)) return;
    var w = img.naturalWidth || img.offsetWidth;
    if (w < 100) return;
    e.preventDefault();
    open(img);
  });
  container.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var img = e.target;
    if (!img || img.tagName !== 'IMG' || !img.classList.contains('is-zoomable')) return;
    e.preventDefault();
    open(img);
  });
})();

/* Code blocks: language tag + copy button. The bar's text is CSS-generated
   (attr()), so it adds no text nodes to .post-content — inline-comment
   anchoring walks text nodes and must not see it. */
(function() {
  var container = document.querySelector('.post-content');
  if (!container || !navigator.clipboard) return;
  var page = document.querySelector('.post-page');
  var en = page && page.getAttribute('data-lang') === 'en';
  var T = en
    ? { copy: 'copy', copied: 'copied', fail: 'failed', label: 'Copy code' }
    : { copy: '复制', copied: '已复制', fail: '复制失败', label: '复制代码' };
  container.querySelectorAll('pre').forEach(function(pre) {
    if (pre.previousElementSibling && pre.previousElementSibling.classList.contains('code-bar')) return;
    var lang = (pre.getAttribute('data-language') || '').toLowerCase();
    if (lang === 'plaintext' || lang === 'text' || lang === 'txt') lang = '';
    var bar = document.createElement('div');
    bar.className = 'code-bar';
    bar.setAttribute('data-lang', lang);
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.setAttribute('data-label', T.copy);
    btn.setAttribute('aria-label', T.label);
    var timer = null;
    btn.addEventListener('click', function() {
      var code = pre.querySelector('code') || pre;
      navigator.clipboard.writeText(code.innerText.replace(/\n$/, '')).then(function() {
        btn.setAttribute('data-label', T.copied);
        btn.setAttribute('aria-label', T.copied);
      }, function() {
        btn.setAttribute('data-label', T.fail);
        btn.setAttribute('aria-label', T.fail);
      });
      clearTimeout(timer);
      timer = setTimeout(function() {
        btn.setAttribute('data-label', T.copy);
        btn.setAttribute('aria-label', T.label);
      }, 1600);
      if (typeof umami !== 'undefined') umami.track('code-copy', { lang: lang || 'text' });
    });
    bar.appendChild(btn);
    pre.parentNode.insertBefore(bar, pre);
    pre.classList.add('has-code-bar');
  });
})();
</script>
