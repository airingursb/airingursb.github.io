  }
  @media (max-width: 1100px) {
    .article-afterword { padding-inline: 20px; }
  }

  /* ===== Bottom Comment Section (outer layout; inside: components/comments) ===== */
  :global(.post-page .bottom-comments) {
    max-width: 1440px; margin: 0 auto;
    padding: 0 48px 48px;
    padding-left: calc(48px + 160px + 40px);
    padding-right: calc(48px + 280px + 40px);
  }
  /* ===== Footer ===== */
  .page-footer { max-width: 1440px; margin: 0 auto; padding: 0 48px 48px; }
  .footer-rule { height: 4px; background: var(--c-text); margin-bottom: 14px; }
  .footer-bar { display: flex; justify-content: space-between; align-items: center; }
  .footer-bar a {
    font-size: var(--text-xs); color: var(--c-text-muted); text-decoration: none;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .footer-bar a:hover { color: var(--c-text); }
  .footer-copy { font-size: var(--text-xs); color: var(--c-text-muted); }

  /* ===== Responsive ===== */
  @media (max-width: 1100px) {
    .content-grid { grid-template-columns: 1fr; gap: 0; }
    /* The sidebar dissolves: one mono meta line above the article; readers,
       related posts and "all posts" move below it (order 1). */
    .sidebar-left { display: contents; }
    .sidebar-left > * { order: 1; }
    .sidebar-left > .sb-meta { order: 0; }
    .sb-meta {
      display: flex; align-items: baseline; flex-wrap: nowrap;
      /* As a grid item it would otherwise grow to its content's width and push
         the page sideways; relative keeps the clipped labels inside it too. */
      position: relative; min-width: 0; max-width: 100%;
      /* No wrapping: counts that arrive after load extend the line sideways
         instead of pushing the article down (CLS). */
      overflow-x: auto; scrollbar-width: none; white-space: nowrap;
      /* Fade the edge so a line that runs past the screen reads as scrollable. */
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent);
      padding-bottom: 12px; margin-bottom: 24px;
      border-bottom: 1px solid var(--c-border);
      font: var(--text-xs)/1.6 var(--font-mono); color: var(--c-text-muted);
    }
    .sb-meta::-webkit-scrollbar { display: none; }
    .sb-meta > .sb-block { display: flex; align-items: baseline; margin: 0; flex: none; }
    .sb-meta > .sb-block + .sb-block::before { content: '·'; margin: 0 8px; color: var(--c-text-muted); }
    .sb-meta .sb-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .sb-meta .sb-value, .sb-meta .sb-tag { font: inherit; }
    .sb-meta .sb-tags { flex-direction: row; gap: 8px; }
    .sb-meta .sb-author { display: none; }
    .sb-unit { display: inline; }
    .sb-trend { display: none !important; }
    .sb-block { margin-bottom: 0; }
    .sb-divider { display: none; }
    .toc-block, .sb-progress { display: none !important; }
    .sb-readers, .sb-related-block { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--c-border); }
    .sb-readers .vg-list { max-height: none; }
    .sb-related { gap: 0; }
    .sb-related-link { display: flex; align-items: center; min-height: 44px; font-size: 15px; line-height: 1.45; }
    .sb-nav { display: inline-flex; align-items: center; min-height: 44px; margin-top: 12px; font-size: 13px; justify-self: start; }

    /* Hide desktop comment rail on mobile */
    .comment-rail { display: none; }

    .post-content :global(img),
    .post-content :global(pre),
    .post-content :global(.code-bar) { max-width: 100%; width: 100%; margin-left: 0; }

    .headline-section, .content-grid, .cover-section, .page-footer { padding-left: 20px; padding-right: 20px; }
    .mast-date { display: none; }

    /* Article like & bottom comments mobile */
    .article-like-section { padding: 24px 20px 0 !important; gap: 16px; }
    .article-like-btn { padding: 10px 20px; }
    :global(.post-page .bottom-comments) { padding: 0 20px 48px; }
  }
  @media (max-width: 600px) {
    .post-content { font-size: 17px; line-height: 1.85; }
    .post-page[data-lang="en"] .post-content { line-height: 1.7; }
    .post-content :global(pre) { padding: 16px; }
    .post-content :global(.code-bar) { padding-left: 12px; }
  }
</style>

