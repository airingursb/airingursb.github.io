    white-space: nowrap;
  }
  .al-rule {
    flex: 1; height: 1px; background: var(--c-border);
  }
  .article-like-btn {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 28px;
    background: rgba(var(--c-overlay-rgb),0.03);
    border: 1px solid var(--c-border);
    border-radius: 100px;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: all 0.25s;
    white-space: nowrap;
    font-family: inherit;
  }
  .article-like-btn:hover {
    border-color: var(--c-border-light);
    background: rgba(var(--c-overlay-rgb),0.06);
    color: var(--c-text);
  }
  .article-like-btn.liked {
    border-color: rgba(239,68,68,0.4);
    background: rgba(239,68,68,0.08);
    color: #ef4444;
  }
  .article-like-btn .al-icon {
    transition: transform 0.25s;
  }
  .article-like-btn.liked .al-icon {
    transform: scale(1.15);
  }
  .al-count {
    font-size: 16px; font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .al-label {
    font-size: 13px; font-weight: 500;
  }

  /* ===== Like region distribution ===== */
  .al-regions {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--c-text-dim);
    cursor: default;
    outline: none;
  }
  .al-regions-flags {
    display: inline-flex;
    align-items: center;
  }
  /* tuck the per-flag left margin so the row reads as one cluster */
  .al-regions-flags :global(img.c-flag) { margin-left: 0; margin-right: 3px; }
  .al-regions-label { white-space: nowrap; }
  .al-regions-pop {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    z-index: 30;
    min-width: 210px;
    padding: 12px 14px;
    background: var(--c-bg, #fff);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.16);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.16s ease, transform 0.16s ease;
    text-align: left;
  }
  .al-regions:hover .al-regions-pop,
  .al-regions:focus .al-regions-pop,
  .al-regions:focus-within .al-regions-pop {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .al-regions-pop::after {
    content: ''; position: absolute; top: 100%; left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent; border-top-color: var(--c-border);
  }
  .al-regions-pop :global(.al-rp-title) {
    display: block; font-size: 11px; font-weight: 600; letter-spacing: .04em;
    text-transform: uppercase; color: var(--c-text-dim); margin-bottom: 9px;
  }
  .al-regions-pop :global(.al-rp-row) {
    display: grid; grid-template-columns: 1fr 56px auto; align-items: center;
    gap: 9px; padding: 3px 0; font-size: 12px; color: var(--c-text);
  }
  .al-regions-pop :global(.al-rp-name) {
    display: inline-flex; align-items: center; gap: 6px;
    overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  }
  .al-regions-pop :global(.al-rp-bar) {
    height: 5px; border-radius: 3px; background: rgba(var(--c-overlay-rgb),0.08);
    overflow: hidden;
  }
  .al-regions-pop :global(.al-rp-fill) {
    display: block; height: 100%; border-radius: 3px; background: var(--accent, #ef4444);
  }
  .al-regions-pop :global(.al-rp-count) {
    font-variant-numeric: tabular-nums; color: var(--c-text-dim); min-width: 16px; text-align: right;
  }
  .al-regions-pop :global(.al-rp-foot) {
    display: block; margin-top: 9px; padding-top: 8px;
    border-top: 1px solid var(--c-border);
    font-size: 11px; color: var(--c-text-dim);
  }

  .article-afterword {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: calc(48px + 160px + 40px) calc(48px + 280px + 40px);
  }
  .article-ending { margin-block: 32px; }
  .article-ending-title { margin: 0 0 24px; font: 600 32px/1.3 ui-serif, 'Noto Serif SC', 'Songti SC', Georgia, serif; text-wrap: balance; }
  .article-ending-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(180px, 1fr); gap: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--c-border); }
  .article-ending--single .article-ending-grid { grid-template-columns: minmax(0, 1fr); }
  .article-ending--single :global(.newspaper-subscription) { border-left: 0; padding-left: 0; max-width: 400px; }
  @media (max-width: 600px) {
    .article-ending-title { font-size: 28px; }
