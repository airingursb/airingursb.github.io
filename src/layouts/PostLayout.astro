---
import ArticleTransition from '../components/ArticleTransition.astro';
import LivingCover from '../components/photo-motion/LivingCover.astro';
import SiteHeader from "../components/SiteHeader.astro";
import CommentSection from '../components/comments/CommentSection.astro';
import InlineCommentLayer from '../components/comments/InlineCommentLayer.astro';
import CommentsRuntime from '../components/comments/CommentsRuntime.astro';
import { commentStrings } from '../components/comments/strings';
/**
 * B1 + Inline Comments — Google Docs / 飞书 / 微信读书风格划线评论
 *
 * Desktop: 三栏布局，右侧评论卡片 absolute 定位对齐高亮文字
 * Mobile:  单栏，高亮文字点击弹出 bottom-sheet 评论气泡
 */
import BaseLayout from './BaseLayout.astro';
import BlogPetWidget from '../components/BlogPetWidget.astro';
import MobileToc from '../components/MobileToc.astro';
import ArticleReadingDock from '../components/editorial/ArticleReadingDock.astro';
import LikeDelight from '../components/like-delight/LikeDelight.astro';
import NextPagePreview from '../components/editorial/NextPagePreview.astro';
import NewspaperSubscription from '../components/editorial/NewspaperSubscription.astro';
import LaterNote from '../components/editorial/LaterNote.astro';
import type { LaterNoteContent } from '../lib/later-note';
import type { EditorialNeighbor } from '../components/editorial/editorial-neighbor';
import '@fontsource/noto-serif-sc/400.css';
// 600 is not loaded: headings use 700, and browsers map a 600 request to the
// next heavier face, so it only cost ~45 extra woff2 subsets on cold loads.
import '@fontsource/noto-serif-sc/700.css';
// Emitted as a separate file and linked only on posts that contain TeX math.
import katexCssUrl from 'katex/dist/katex.min.css?url';

interface Props {
  title: string;
  date: Date;
  /** Real last-modified date (from git); falls back to publish date. */
  dateModified?: Date;
  tags: string[];
  description?: string;
  cover?: string;
  laterNote?: LaterNoteContent;
  prevPost?: EditorialNeighbor | null;
  nextPost?: EditorialNeighbor | null;
  relatedPosts?: { slug: string; title: string }[];
  seriesInfo?: {
    tag: string;
    /** Issue number from the title ("#36") or the year of an annual review. */
    issue?: string | null;
    total: number;
    current: number;
    prev: { slug: string; title: string } | null;
    next: { slug: string; title: string } | null;
  } | null;
  readingTime?: number;
  /** Body contains KaTeX output (remark-has-math) → link the KaTeX stylesheet. */
  hasMath?: boolean;
  lang?: 'zh' | 'en';
  hreflang?: { zh?: string; en?: string };
}

const { title, date, dateModified, tags, description, cover, laterNote, prevPost, nextPost, relatedPosts = [], seriesInfo, readingTime, hasMath = false, lang = 'zh', hreflang } = Astro.props;

// Sidebar / meta-line labels. The mobile meta line hides labels and shows
// the unit after each count instead ("48,615 次阅读").
const L = lang === 'en'
  ? { date: 'Date', tags: 'Tags', author: 'Author', read: 'Read', min: 'min', views: 'Views', viewsUnit: 'views', likes: 'Likes', likesUnit: 'likes', comments: 'Comments', commentsUnit: 'comments', readers: 'Readers', progress: 'Progress', minLeft: '{n}m left', finished: 'Finished', minCol: 'min', minAria: '{t}, about {n} min', top: 'Top', topLabel: 'Back to top', toc: 'Contents', related: 'Related', allPosts: 'All posts', home: 'Home', archive: 'Archive', likeBtn: 'likes', meta: 'Article details' }
  : { date: '日期', tags: '标签', author: '作者', read: '阅读时长', min: '分钟', views: '阅读', viewsUnit: '次阅读', likes: '点赞', likesUnit: '人点赞', comments: '评论', commentsUnit: '条评论', readers: '读者', progress: '进度', minLeft: '还剩 {n} 分钟', finished: '已读完', minCol: '分钟', minAria: '{t}，约 {n} 分钟', top: '顶部', topLabel: '回到顶部', toc: '目录', related: '相关文章', allPosts: '全部文章', home: '首页', archive: '归档', likeBtn: '人喜欢', meta: '文章信息' };

const seriesNames: Record<string, Record<string, string>> = {
  zh: { weekly: '月刊', annually: '年报' },
  en: { weekly: 'Weekly', annually: 'Annual' },
};

const dateStr = lang === 'en'
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const shortDate = lang === 'en'
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })
  : date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });

// Coda date — literary closing stamp at end of every article.
// EN: "May 23, 2026". ZH: 中文大写日期 "二〇二六年五月二十三日".
function toChineseDate(d: Date): string {
  const digits = ['〇', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
  const year = d.getFullYear().toString().split('').map(c => digits[+c]).join('');
  const m = d.getMonth() + 1;
  const month = m === 10 ? '十' : m < 10 ? digits[m] : '十' + digits[m - 10];
  const dn = d.getDate();
  let day: string;
  if (dn === 10) day = '十';
  else if (dn === 20) day = '二十';
  else if (dn === 30) day = '三十';
  else if (dn < 10) day = digits[dn];
  else if (dn < 20) day = '十' + digits[dn - 10];
  else if (dn < 30) day = '二十' + digits[dn - 20];
  else day = '三十' + digits[dn - 30];
  return `${year}年${month}月${day}日`;
}
const codaDate = lang === 'en'
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : toChineseDate(date);

const prefix = lang === 'en' ? '/en' : '';
const ct = commentStrings(lang);
const hasEnVersion = !!hreflang?.en;
const canonicalUrl = new URL(`${prefix}/posts/${Astro.params.slug}/`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "datePublished": date.toISOString(),
  "dateModified": (dateModified ?? date).toISOString(),
  "author": {
    "@type": "Person",
    "name": "Airing",
    "url": "https://ursb.me"
  },
  "publisher": {
    "@type": "Person",
    "name": "Airing",
    "url": "https://ursb.me"
  },
  "url": canonicalUrl,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "inLanguage": lang === 'en' ? 'en' : 'zh-CN',
  ...(description ? { "description": description } : {}),
  ...(cover ? { "image": cover } : {}),
  ...(tags.length > 0 ? { "keywords": tags.join(", ") } : {}),
};
---

<BaseLayout title={`${title} | Airing`} description={description} ogType="article" ogImage={new URL(`og/${lang === 'en' ? 'en/' : ''}${Astro.params.slug}.png`, Astro.site).href} hreflang={hreflang} lang={lang}>
  <ArticleTransition slot="head" />
  {hasMath && <link slot="head" rel="stylesheet" href={katexCssUrl} />}
  {cover && <link slot="head" rel="preload" as="image" href={cover} />}
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  <meta slot="head" property="article:modified_time" content={(dateModified ?? date).toISOString()} />
  <meta slot="head" property="article:author" content="Airing" />
  {tags.map(tag => <meta slot="head" property="article:tag" content={tag} />)}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="post-page" data-lang={lang}>
    <!-- Masthead -->
    <SiteHeader lang={lang} hasEnVersion={hasEnVersion} wide>
      <span class="post-mast-date">{dateStr}</span>
    </SiteHeader>

    <!-- Headline -->
    <div class="headline-section">
      <div class="headline-inner">
        <div class="headline-tags">
          {tags.map(tag => (
            <a href={`${prefix}/tags/${tag}/`} class="hl-tag">{tag}</a>
          ))}
        </div>
        <h1 class="headline" data-article-title>{title}</h1>
        {!cover && description && <p class="post-deck post-deck--headline">{description}</p>}
      </div>
    </div>

    {seriesInfo && (
      <div class="series-nav">
        <div class="series-inner">
          {seriesInfo.prev && (
            <a href={`${prefix}/posts/${seriesInfo.prev.slug}/`} class="series-arrow" title={seriesInfo.prev.title}>&larr;</a>
          )}
          <a href={`${prefix}/tags/${seriesInfo.tag}/`} class="series-badge">
            {(seriesNames[lang] || seriesNames.zh)[seriesInfo.tag] || seriesInfo.tag}{seriesInfo.issue ? ` ${seriesInfo.issue}` : ''}
          </a>
          {seriesInfo.next && (
            <a href={`${prefix}/posts/${seriesInfo.next.slug}/`} class="series-arrow" title={seriesInfo.next.title}>&rarr;</a>
          )}
        </div>
      </div>
    )}

    {cover && (
      <div class="cover-section">
        <div class="article-cover-art" data-article-cover>
          <img src={cover} alt={title} loading="eager" fetchpriority="high" decoding="async" />
        </div>
        {Astro.params.slug === 'weekly-36' && <LivingCover slug="weekly-36" mode="article" />}
        {description && <p class="post-deck post-deck--cover">{description}</p>}
      </div>
    )}

    <!-- Three-column: sidebar | content | comments -->
    <div
      class="content-grid"
      id="contentGrid"
      data-slug={Astro.params.slug}
      data-date={date.toISOString()}
      data-lang={lang}
      data-minutes={readingTime ?? ''}
      data-left-label={L.minLeft}
      data-done-label={L.finished}
      data-min-label={L.minAria}
    >
      <aside class="sidebar-left">
        <div class="sb-meta" role="group" aria-label={L.meta}>
          <div class="sb-block sb-date">
            <div class="sb-label">{L.date}</div>
            <div class="sb-value"><time datetime={date.toISOString()}>{shortDate}</time></div>
          </div>
          {tags.length > 0 && (
            <div class="sb-block">
              <div class="sb-label">{L.tags}</div>
              <div class="sb-tags">
                {tags.map(tag => (
                  <a href={`${prefix}/tags/${tag}/`} class="sb-tag">#{tag}</a>
                ))}
              </div>
            </div>
          )}
          <div class="sb-block sb-author">
            <div class="sb-label">{L.author}</div>
            <div class="sb-value"><a href="/" style="color:inherit;text-decoration:none;">Airing</a></div>
          </div>
          {readingTime && (
            <div class="sb-block">
              <div class="sb-label">{L.read}</div>
              <div class="sb-value">{readingTime} {L.min}</div>
            </div>
          )}
          <div class="sb-block" id="postViewsBlock" style="display:none;">
            <div class="sb-label">{L.views}</div>
            <div class="sb-value"><span id="postViews">-</span><span class="sb-unit"> {L.viewsUnit}</span></div>
            <div class="sb-trend" id="postTrend" hidden></div>
          </div>
          <div class="sb-block" id="postLikesBlock" style="display:none;">
            <div class="sb-label">{L.likes}</div>
            <div class="sb-value"><span id="postLikesCount">-</span><span class="sb-unit"> {L.likesUnit}</span></div>
          </div>
          <div class="sb-block" id="postCommentsBlock" style="display:none;">
            <div class="sb-label">{L.comments}</div>
            <div class="sb-value"><span id="postCommentsCount">-</span><span class="sb-unit"> {L.commentsUnit}</span></div>
          </div>
        </div>
        <div class="sb-block sb-readers" id="viewGeoBlock" style="display:none;">
          <div class="sb-label">{L.readers}</div>
          <div class="vg-list" id="vgList"></div>
          <button class="vg-toggle" id="vgToggle" type="button" style="display:none;"></button>
        </div>
        <div class="sb-divider"></div>
        <div class="sb-block sb-progress" id="readProgress" hidden>
          <div class="sb-label sb-label-row"><span id="readProgressLabel">{L.progress}</span><span class="rp-left" id="readProgressLeft" hidden></span></div>
          <div class="rp-track" role="progressbar" aria-labelledby="readProgressLabel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="rp-bar" id="readProgressBar"></span>
          </div>
          <div class="rp-row">
            <span class="rp-pct" id="readProgressPct" aria-hidden="true">0%</span>
            <button type="button" class="rp-top" id="readProgressTop" aria-label={L.topLabel}><span aria-hidden="true">↑</span> {L.top}</button>
          </div>
        </div>
        <div class="sb-block toc-block" id="tocBlock" style="display:none;">
          <div class="sb-label sb-label-row"><span id="tocLabel">{L.toc}</span><span class="toc-colh" id="tocMinCol" aria-hidden="true" hidden>{L.minCol}</span></div>
          <nav class="toc-nav" id="tocNav" aria-labelledby="tocLabel"></nav>
        </div>

        {relatedPosts.length > 0 && (
          <>
            <div class="sb-divider"></div>
            <div class="sb-block sb-related-block">
              <div class="sb-label" id="relatedLabel">{L.related}</div>
              <ul class="sb-related" aria-labelledby="relatedLabel">
                {relatedPosts.map(rp => (
                  <li><a href={`${prefix}/posts/${rp.slug}/`} class="sb-related-link">{rp.title}</a></li>
                ))}
              </ul>
            </div>
          </>
        )}
        <div class="sb-divider"></div>
        <a href={`${prefix}/archive/`} class="sb-nav">&larr; {L.allPosts}</a>
      </aside>

      <div class="post-reading-column">
        {laterNote && <div class="post-later-note">
          <time class="post-later-original" datetime={date.toISOString()}>{date.toISOString().slice(0, 10).replaceAll('-', '.')}</time>
          <LaterNote en={lang === 'en'} note={laterNote} />
        </div>}
      <article class="post-content" id="postContent" data-pagefind-body>
        <slot />
        <div class="article-coda" aria-hidden="true">
          <div class="coda-date">{codaDate}</div>
        </div>
        <ArticleReadingDock lang={lang} />
      </article>
      </div>

      <!-- Right column: relative container for absolute-positioned cards -->
      <aside class="comment-rail" id="commentRail">
        <div class="cr-header">
          <span class="cr-label">{ct.railLabel}</span>
        </div>
        <div class="cr-cards" id="commentCards">
          <!-- Cards positioned absolutely here -->
        </div>
        <div class="cr-empty" id="crEmpty">
          <p>{ct.railEmpty}</p>
        </div>
      </aside>
    </div>

    <InlineCommentLayer lang={lang} />

    <!-- Article Like -->
    <div class="article-like-section">
      <div class="al-rule"></div>
      <div class="al-stack">
        <button class="article-like-btn" id="articleLikeBtn">
          <svg class="al-icon" viewBox="0 0 24 24" fill="none" width="22" height="22">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
          <span class="al-count" id="articleLikeCount">0</span>
          <span class="al-label">{L.likeBtn}</span>
        </button>
        <div class="al-regions" id="alRegions" style="display:none" tabindex="0">
          <span class="al-regions-flags" id="alRegionsFlags"></span>
          <span class="al-regions-label" id="alRegionsLabel"></span>
          <div class="al-regions-pop" id="alRegionsPop" role="status"></div>
        </div>
        <span class="online-indicator article-online" data-online="page" data-online-template='<span class="online-dot"></span><span class="online-count">{n}</span> 人在读' data-online-min="1" style="display:none"></span>
      </div>
      <div class="al-rule"></div>
    </div>

    <section class:list={['article-afterword', 'article-ending', { 'article-ending--single': !prevPost && !nextPost }]} data-article-ending>
      {(prevPost || nextPost) && <h2 class="article-ending-title">{lang === 'en' ? 'One more page.' : '再翻一页。'}</h2>}
      <div class="article-ending-grid">
        <NextPagePreview prev={prevPost} next={nextPost} lang={lang} />
        <NewspaperSubscription lang={lang} />
      </div>
    </section>

    <CommentSection lang={lang} />

    <footer class="page-footer">
      <div class="footer-inner">
        <div class="footer-rule"></div>
        <div class="footer-bar">
          <a href="/">&larr; {L.home}</a>
          <span class="footer-copy">&copy; Airing</span>
          <a href={`${prefix}/archive/`}>{L.archive} &rarr;</a>
        </div>
      </div>
    </footer>
  </div>
  <BlogPetWidget lang={lang} />
  <MobileToc lang={lang} content=".post-content" maxWidth={1100} readingTime={readingTime} comments="#bottomComments" />
  <LikeDelight />
  <span id="article-navigation-ready" hidden></span>
</BaseLayout>

<script>
  import '../scripts/post-reading';
</script>

<script is:inline>
/* Wrap short text nodes after <img> as styled captions */
(function() {
  var content = document.querySelector('.post-content');
  if (!content) return;
  var paragraphs = content.querySelectorAll('p');
  paragraphs.forEach(function(p) {
    var imgs = p.querySelectorAll('img');
    if (!imgs.length) return;
    var nodes = Array.from(p.childNodes);
    for (var i = 0; i < nodes.length; i++) {
      var node = nodes[i];
      if (node.nodeType !== 3) continue;
      var text = node.textContent.trim();
      if (!text) continue;
      var prev = node.previousSibling;
      while (prev && prev.nodeType === 3 && !prev.textContent.trim()) prev = prev.previousSibling;
      if (!prev || prev.nodeName !== 'IMG') continue;
      if (text.length > 30 || text.indexOf('\n') !== -1 || text.charAt(0) === '#' || text.charAt(0) === '>') continue;
      // "ECMAScript 标准支持情况：" introduces the next figure, not this one.
      if (/[：:]$/.test(text)) continue;
      // Same rule as rehype-post-images: a caption ends its line. Text that
      // runs on into a link/code ("核心逻辑是将 <a>…</a> 的…") is prose.
      var nextEl = node.nextSibling;
      while (nextEl && nextEl.nodeType === 3 && !nextEl.textContent.trim()) nextEl = nextEl.nextSibling;
      if (nextEl && nextEl.nodeName !== 'IMG' && nextEl.nodeName !== 'BR') continue;
      var span = document.createElement('span');
      span.className = 'img-caption';
      span.textContent = text;
      p.replaceChild(span, node);
    }
  });
})();

/* Gallery: group consecutive images into flex rows */
(function() {
  var content = document.querySelector('.post-content');
  if (!content) return;
  var paragraphs = Array.from(content.querySelectorAll('p'));

  paragraphs.forEach(function(p) {
    var imgs = p.querySelectorAll('img');
    if (imgs.length < 2) return;

    // Segment childNodes into groups: consecutive img(+caption) vs other content
    var nodes = Array.from(p.childNodes);
    var segments = [];
    var currentImgs = [];

    function flushImgs() {
      if (currentImgs.length >= 2) {
        segments.push({ type: 'images', items: currentImgs });
      } else if (currentImgs.length === 1) {
        segments.push({ type: 'other', nodes: [currentImgs[0].img] });
        if (currentImgs[0].caption) segments.push({ type: 'other', nodes: [currentImgs[0].caption] });
      }
      currentImgs = [];
    }

    for (var i = 0; i < nodes.length; i++) {
      var node = nodes[i];
      if (node.nodeName === 'IMG') {
        var item = { img: node, caption: null };
        var next = nodes[i + 1];
        if (next && next.nodeType === 1 && next.classList && next.classList.contains('img-caption')) {
          item.caption = next;
          i++;
        }
        currentImgs.push(item);
      } else if (node.nodeType === 3 && !node.textContent.trim()) {
        continue;
      } else {
        flushImgs();
        segments.push({ type: 'other', nodes: [node] });
      }
    }
    flushImgs();

    var hasGallery = segments.some(function(s) { return s.type === 'images'; });
    if (!hasGallery) return;

    var frag = document.createDocumentFragment();

    segments.forEach(function(seg) {
      if (seg.type === 'other') {
        seg.nodes.forEach(function(n) { frag.appendChild(n.cloneNode(true)); });
        return;
      }

      var items = seg.items;
      var gallery = document.createElement('div');
      gallery.className = 'img-gallery';

      // Build rows: max 3 per row (2 for groups of 4)
      var rows = [];
      var row = [];
      for (var j = 0; j < items.length; j++) {
        row.push(items[j]);
        var maxPerRow = items.length === 4 ? 2 : 3;
        if (row.length >= maxPerRow) { rows.push(row); row = []; }
      }
      if (row.length) rows.push(row);

      rows.forEach(function(rowItems) {
        var rowDiv = document.createElement('div');
        rowDiv.className = 'img-gallery-row';
        rowItems.forEach(function(item) {
          var figure = document.createElement('figure');
          figure.className = 'img-gallery-item';
          figure.appendChild(item.img.cloneNode(true));
          if (item.caption) {
            var figcap = document.createElement('figcaption');
            figcap.textContent = item.caption.textContent;
            figure.appendChild(figcap);
          }
          rowDiv.appendChild(figure);
        });
        gallery.appendChild(rowDiv);
      });

      // Apply flex ratios once all images in gallery have loaded
      var galleryImgs = gallery.querySelectorAll('img');
      var loaded = 0;
      var total = galleryImgs.length;
      function applyFlex() {
        var rows = gallery.querySelectorAll('.img-gallery-row');
        rows.forEach(function(rowEl) {
          var figs = rowEl.querySelectorAll('.img-gallery-item');
          figs.forEach(function(fig) {
            var img = fig.querySelector('img');
            var w = img.naturalWidth || 1;
            var h = img.naturalHeight || 1;
            fig.style.flex = (w / h).toFixed(3);
          });
        });
      }
      galleryImgs.forEach(function(img) {
        if (img.complete && img.naturalWidth > 0) {
          loaded++;
          if (loaded === total) applyFlex();
        } else {
          img.addEventListener('load', function() {
            loaded++;
            if (loaded === total) applyFlex();
          });
          img.addEventListener('error', function() {
            loaded++;
            if (loaded === total) applyFlex();
          });
        }
      });

      frag.appendChild(gallery);
    });

    p.parentNode.replaceChild(frag, p);
  });
})();

/* TOC: build, scroll-spy, click-to-scroll */
(function() {
  var content = document.querySelector('.post-content');
  var tocNav = document.getElementById('tocNav');
  var tocBlock = document.getElementById('tocBlock');
  if (!content || !tocNav || !tocBlock) return;

  var headings = content.querySelectorAll('h2, h3');
  if (headings.length < 2) return;

  // Ensure each heading has an id
  headings.forEach(function(h, i) {
    if (!h.id) h.id = 'heading-' + i;
  });

  // Build TOC links
  var fragment = document.createDocumentFragment();
  headings.forEach(function(h) {
    var a = document.createElement('a');
    a.className = 'toc-link';
    a.href = '#' + h.id;
    a.textContent = h.textContent;
    a.title = h.textContent;
    a.setAttribute('data-level', h.tagName === 'H2' ? '2' : '3');
    a.addEventListener('click', function(e) {
      e.preventDefault();
      h.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', '#' + h.id);
      if (typeof umami !== 'undefined') umami.track('toc-click', { heading: h.textContent });
    });
    fragment.appendChild(a);
  });
  tocNav.appendChild(fragment);
  tocBlock.style.display = '';

  // Scroll spy
  var tocLinks = tocNav.querySelectorAll('.toc-link');
  var headingArr = Array.from(headings);
  var ticking = false;

  function updateActive() {
    // Viewport geometry, like MobileToc: offsetTop is relative to the
    // positioned .post-content, which made the highlight run ~1 screen early.
    var active = null;
    for (var i = headingArr.length - 1; i >= 0; i--) {
      if (headingArr[i].getBoundingClientRect().top <= 96) { active = i; break; }
    }
    tocLinks.forEach(function(link, idx) {
      link.classList.toggle('active', idx === active);
      if (idx === active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
    });
    // Scroll active link into view within TOC nav
    // Measured inside the nav (link.offsetTop is relative to the sticky
    // sidebar, which pinned long TOCs to the bottom), and against the part of
    // the nav that is on screen: on short viewports the sidebar runs past the
    // bottom edge, so the nav's own box is not all visible.
    if (active !== null && tocLinks[active]) {
      var link = tocLinks[active];
      var nav = tocNav;
      var navBox = nav.getBoundingClientRect();
      var seen = Math.max(link.offsetHeight * 3, Math.min(nav.clientHeight, window.innerHeight - navBox.top));
      var linkTop = link.getBoundingClientRect().top - navBox.top + nav.scrollTop;
      var pad = link.offsetHeight;
      if (linkTop - pad < nav.scrollTop || linkTop + link.offsetHeight + pad > nav.scrollTop + seen) {
        nav.scrollTop = linkTop - seen / 3;
      }
    }
    ticking = false;
  }

  window.addEventListener('scroll', function() {
    if (!ticking) { ticking = true; requestAnimationFrame(updateActive); }
  }, { passive: true });
  updateActive();
})();

/* Desktop reading progress + back to top (MobileToc covers <= 1100px) */
(function() {
  var content = document.querySelector('.post-content');
  var box = document.getElementById('readProgress');
  if (!content || !box) return;
  var bar = document.getElementById('readProgressBar');
  var pct = document.getElementById('readProgressPct');
  var track = box.querySelector('.rp-track');
  var top = document.getElementById('readProgressTop');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var ticking = false;
  var last = -1;
  function update() {
    ticking = false;
    var r = content.getBoundingClientRect();
    var vh = window.innerHeight;
    // Only worth showing when the article is longer than ~1.5 screens.
    var long = r.height > vh * 1.5;
    if (box.hidden === long) box.hidden = !long;
    if (!long) return;
    var span = Math.max(1, r.height - vh);
    var p = Math.round(Math.min(1, Math.max(0, -r.top / span)) * 100);
    if (p === last) return;
    last = p;
    bar.style.transform = 'scaleX(' + (p / 100) + ')';
    pct.textContent = p + '%';
    track.setAttribute('aria-valuenow', String(p));
  }
  function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  top.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: reduce.matches ? 'auto' : 'smooth' });
    var h1 = document.querySelector('[data-article-title]');
    if (h1) { h1.setAttribute('tabindex', '-1'); h1.focus({ preventScroll: true }); }
  });
  update();
})();
</script>
<script is:inline>
// Scroll depth tracking
(function() {
  var milestones = [25, 50, 75, 100];
  var fired = {};
  var postContent = document.querySelector('.post-content');
  if (!postContent) return;
  window.addEventListener('scroll', function() {
    var rect = postContent.getBoundingClientRect();
    var total = postContent.scrollHeight;
    var scrolled = Math.max(0, -rect.top);
    var pct = Math.min(100, Math.round(scrolled / (total - window.innerHeight) * 100));
    milestones.forEach(function(m) {
      if (pct >= m && !fired[m]) {
        fired[m] = true;
        if (typeof umami !== 'undefined') umami.track('scroll-depth', { depth: m });
      }
    });
  }, { passive: true });
})();
</script>
