---
import { localeOf } from '../data/i18n';
interface Props { readonly number: string; readonly title: string; readonly path?: string; readonly label?: string; }
const { number, title, path = Astro.url.pathname, label } = Astro.props;
const en = localeOf(Astro.url.pathname) === 'en';
---
<button class="share-trigger" type="button" data-share-open data-share-issue={number} data-share-title={title} data-share-path={path} hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7h14v-7" /></svg>
  <span>{label ?? (en ? 'Share this issue' : '分享这一期')}</span>
</button>
