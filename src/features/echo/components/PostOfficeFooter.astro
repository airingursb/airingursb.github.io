---
import { localeOf } from '../data/i18n';
import '../styles/post-office.css';
import EditorialText from './EditorialText.astro';
const lang = localeOf(Astro.url.pathname), en = lang === 'en';
const href = 'mailto:airingdeng@gmail.com?subject=' + encodeURIComponent(en ? 'A letter to Airing' : '写给 Airing 的一封信');
---
<footer class="post-office-footer journal-shell">
  <div class="post-footer-letter">
    <div class="post-footer-invitation">
      <p class="journal-kicker">Until your next letter</p>
      <h2>{en ? 'You can write before' : '还没想清楚的，'}<br />{en ? 'you have the answers.' : '也可以写下来。'}</h2>
      <p><EditorialText text={en ? 'A question does not need to be perfectly formed to begin a conversation.' : '不必把话写得漂亮，也不必急着有答案。一封信，就可以是对话的开始。'} /></p>
      <a class="post-footer-write" href={href}>{en ? 'Send a letter' : '寄一封信给我'} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="post-footer-address">
      <div class="post-footer-stamp" aria-hidden="true"><span>ECHO</span><svg viewBox="0 0 40 32" width="40" height="32" fill="none" stroke="currentColor" stroke-width="1"><path d="M3 6h34v22H3zM3 7l17 13L37 7"/><path d="M9 1h22"/></svg><span>BY EMAIL</span></div>
      <p>{en ? 'TO' : '收信人'}</p>
      <strong>Airing</strong>
      <a href={href}>airingdeng@gmail.com</a>
      <span>{en ? 'Letters & replies, free of charge' : '免费来信 · 免费回信'}</span>
    </div>
  </div>
  <div class="post-footer-colophon">
    <div><span class="post-footer-name">{en ? 'Echo' : '回声'}</span><p>{en ? 'Reader questions, personal replies, and complete anonymized exchanges. Selected more than 180 days after correspondence ends.' : '从具体困惑，到认真回应。通信结束超过 180 天后，再脱敏选编；保留每个问题背后完整的往返。'}</p></div>
    <nav aria-label={en ? 'Publication links' : '刊物导航'}><a href={(lang === 'en' ? '/en/blog/' : '/blog/')}>{en ? 'Back to the blog' : '返回博客'} ↗</a><a href="#top">{en ? 'Back to top' : '回到顶部'} ↑</a></nav>
  </div>
  <p class="post-footer-copyright">© 2026 Airing <span>{en ? 'Correspondence journal' : '通信期刊'}</span></p>
</footer>
