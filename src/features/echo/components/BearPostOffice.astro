---
import { Image } from 'astro:assets';
import learning from '../assets/cover-learning.png';
interface Props { readonly lang: 'zh' | 'en'; readonly href: string; }
const { lang, href } = Astro.props;
const en = lang === 'en';
---
<figure class="postmaster" data-postmaster>
  <a class="postmaster-window" href={href}>
    <span class="postmaster-sign">ECHO<br /><b>POST OFFICE</b></span>
    <span class="postmaster-picture">
      <Image src={learning} alt="" width={540} widths={[160,320,540]} sizes="(max-width:720px) 128px,320px" format="webp" loading="eager" />
      <video data-src="/echo/motion/postmaster-learning.mp4" width="576" height="768" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    </span>
    <span class="postmaster-address">{en ? 'A letter for Airing' : '寄给 Airing 的一封信'}<span aria-hidden="true">↗</span></span>
  </a>
  <figcaption>
    <span>{en ? 'Delivered by email' : '电子来信 · 慢慢说'}</span>
    <button type="button" class="postmaster-control" hidden aria-pressed="false" data-play-label={en ? 'Play animation' : '播放动画'} data-pause-label={en ? 'Pause animation' : '暂停动画'}>{en ? 'Play animation' : '播放动画'}</button>
  </figcaption>
</figure>
<script>import '../postmaster';</script>
