---
import { letterPath } from '../data/letters';
import { lettersFor } from '../data/catalog';
import { copy, localeOf } from '../data/i18n';
import { issues, type Issue } from '../data/issues';
import LetterEnvelope from './LetterEnvelope.astro';
import CorrespondenceTrail from './CorrespondenceTrail.astro';
import '../styles/rest.css';
interface Props { readonly issue?: Issue; }
const { issue = issues[0] } = Astro.props;
const lang = localeOf(Astro.url.pathname), t = copy[lang];
const editions = lettersFor(lang).filter(letter => issue.letterIds.includes(letter.id));
const groups = [...new Set(editions.map(letter => letter.code))].map(code => ({ code, letters: editions.filter(letter => letter.code === code) }));
---
<section class="correspondence-index" id="letters" aria-labelledby="letters-heading">
  <div class="letter-index-heading"><div><p class="eyebrow">{t.correspondence} / {issue.category}</p><h2 id="letters-heading">{t.letters}</h2></div><p>{issue.letterNote}</p></div>
  {issue.number === '02' && <CorrespondenceTrail />}
  {issue.number === '03' ? <div class="correspondence-threads">
    {groups.map(group => <section class="correspondence-thread" data-count={group.letters.length} aria-label={group.code}>
      <h3 class="thread-label">{group.code}<span>{group.letters.length > 1 ? (lang === 'en' ? 'One conversation, continued in two exchanges' : '同一位朋友，两次接续的往返') : (lang === 'en' ? 'An autumn letter, from a reader in issue 01' : '一封秋信，来自第一期的通信者')}</span></h3>
      <div class="letter-pockets">{group.letters.map(letter => <a class="letter-pocket" href={letterPath(letter.id, lang)}><LetterEnvelope letter={letter} compact /></a>)}</div>
    </section>)}
  </div> : <div class="letter-pockets">
    {editions.map(letter => <a class="letter-pocket" href={letterPath(letter.id, lang, issue.number)}><LetterEnvelope letter={letter} compact /></a>)}
  </div>}
  <p class="letter-index-colophon">{t.colophon}</p>
</section>
