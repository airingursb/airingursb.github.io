---
import { lettersFor } from '../data/catalog';
import { letterPath, displayDate } from '../data/letters';
import { localeOf } from '../data/i18n';
import '../styles/career.css';
const lang = localeOf(Astro.url.pathname), en = lang === 'en';
const letters = lettersFor(lang).filter(letter => letter.issue === '02');
---
<aside class="correspondence-trail" id="correspondence-trail" aria-labelledby="trail-title">
  <header class="trail-heading">
    <h3 id="trail-title">{en ? 'Dates of the correspondence' : '通信日期索引'}</h3>
    <p class="meta">{en ? 'Three exchanges with Xingzhou, followed by one with Zhiqiu. Open any envelope below to read the complete letter and reply.' : '前三组来自行舟，最后一组来自另一位读者知秋。下方信封收录完整来信与回信。'}</p>
  </header>
  <ol class="trail-ledger">
    {letters.map(letter => <li class="trail-entry">
      <a href={letterPath(letter.id, lang)}>{letter.code} · {letter.round} ↗</a>
      <p><span>{en ? 'Letter' : '来信'} <time datetime={letter.incoming.date}>{displayDate(letter.incoming.date, lang)}</time></span><span>{en ? 'Reply' : '回信'} <time datetime={letter.reply.date}>{displayDate(letter.reply.date, lang)}</time></span></p>
    </li>)}
  </ol>
</aside>
