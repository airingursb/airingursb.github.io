---
import { Image } from 'astro:assets';
import type { Issue } from '../data/issues';
import { localeOf, exchangeCount } from '../data/i18n';
import { issueArt } from '../data/covers';
import { editionTeasers, presentationFor } from '../data/presentation';
interface Props { readonly issue: Issue; readonly eager?: boolean; }
const { issue, eager = false } = Astro.props;
const lang = localeOf(Astro.url.pathname), en = lang === 'en';
const teasers = editionTeasers(issue.number, lang);
const design = presentationFor(issue.number);
const headlineSize = Math.min(10.5, 90 / Math.max(...issue.headline.map(line => Array.from(line).length)));
const coverStyle = `--cover-ink:${design.ink};--cover-position:${design.coverPosition ?? '50% 46%'};--cover-headline-size:${en ? design.englishCoverHeadlineSize ?? 7.5 : headlineSize}cqw;${en ? '' : '--cover-name-size:7.5cqw;'}`;
---
<div class:list={['echo-cover', { 'echo-cover-blue': issue.number === '02', 'echo-cover-rest': issue.number === '03' }]} style={coverStyle} data-cover={issue.number} role="img" aria-label={`${en ? 'Echo cover' : '回声封面'} ${issue.number} · ${issue.title}`}>
  <div class="cover-micro"><span>AIRING’S LETTERS</span><span>No. {issue.number}</span></div>
  <div class="cover-brand"><div class="cover-name">{en ? 'Echo' : '回声'}</div>
  <div class="cover-subtitle">{en ? 'A JOURNAL OF CORRESPONDENCE' : '一份关于困境与回答的通信期刊'}</div></div>
  <div class="cover-headline">{issue.headline.map(line => <span>{line.replaceAll('-', '‑')}</span>)}</div>
  <div class="cover-picture">
    <Image src={issueArt(issue.number)} alt="" width={540} widths={[240,400,540,800]} sizes="(max-width: 720px) 144px, (max-width: 900px) 176px, (max-width: 1020px) 240px, 288px" format="webp" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="cover-teasers"><span>{teasers[0]}</span><span>{teasers[1]}</span></div>
  <div class="cover-colophon"><span>{issue.category}</span><span>{exchangeCount(issue.letterIds.length, lang)}</span></div>
</div>
