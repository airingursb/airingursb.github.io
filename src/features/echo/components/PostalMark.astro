---
import { localeOf } from '../data/i18n';
import { postageFor } from '../data/postage';
interface Props { readonly date: string | null; readonly letterId: string; }
const { date, letterId } = Astro.props;
const bearPostage = postageFor(letterId);
const en = localeOf(Astro.url.pathname) === 'en';
---
<div class="postal-motif" aria-hidden="true">
  <img class="echo-stamp" src={bearPostage.src} width={bearPostage.width} height={bearPostage.height} alt="" decoding="async" />
  <div class="letter-postmark"><span>{en ? 'ECHO · RECEIVED' : '回声 · 收信'}</span><strong>{date?.replaceAll('-', '.') ?? (en ? 'UNDATED' : '日期未详')}</strong><span>{en ? 'THERE & BACK' : '一来一往'}</span></div>
</div>
