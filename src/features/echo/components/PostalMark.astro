---
import { localeOf } from '../data/i18n';
interface Props { readonly date: string; readonly number: string; }
const { date, number } = Astro.props;
const en = localeOf(Astro.url.pathname) === 'en';
---
<div class="postal-motif" aria-hidden="true">
  <div class="echo-stamp"><span>{en ? 'Echo' : '回声'}</span><svg viewBox="0 0 44 26" fill="none"><path d="M3 7c7-8 11 8 18 0S32-1 41 7M3 14c7-8 11 8 18 0s11-8 20 0M3 21c7-8 11 8 18 0s11-8 20 0" stroke="currentColor"/></svg><small>{en ? 'LETTERS' : '通信'} / {number}</small></div>
  <div class="letter-postmark"><span>{en ? 'ECHO · RECEIVED' : '回声 · 收信'}</span><strong>{date.replaceAll('-', '.')}</strong><span>{en ? 'THERE & BACK' : '一来一往'}</span></div>
</div>
