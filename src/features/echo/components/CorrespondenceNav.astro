---
import { copy, localeOf } from '../data/i18n';
import type { Manuscript } from '../data/letters';
interface Props { readonly back?: string; readonly followups?: readonly Manuscript[]; }
const { back = '/echo/', followups = [] } = Astro.props;
const t = copy[localeOf(Astro.url.pathname)];
---
<nav class="letter-navigation" aria-label={t.correspondenceNav}>
  <a class="back-to-issue" data-origin-back href={back + '#letters'}><span aria-hidden="true">←</span> {t.letters}</a>
  <div class="letter-chapters"><a href="#incoming" data-reading-chapter="incoming">{t.incoming}</a><span aria-hidden="true">/</span><a href="#reply" data-reading-chapter="reply">{t.reply}</a>{followups.map(part => <><span aria-hidden="true">/</span><a href={'#' + part.id} data-reading-chapter={part.id}>{part.label}</a></>)}</div>
  <a href="#top" class="back-to-envelope">{t.envelope} <span aria-hidden="true">↑</span></a>
</nav>
