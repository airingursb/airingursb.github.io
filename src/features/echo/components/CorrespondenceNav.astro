---
import { copy, localeOf } from '../data/i18n';
interface Props { readonly back?: string; }
const { back = '/echo/' } = Astro.props;
const t = copy[localeOf(Astro.url.pathname)];
---
<nav class="letter-navigation" aria-label={t.correspondenceNav}>
  <a class="back-to-issue" href={back + '#letters'}><span aria-hidden="true">←</span> {t.letters}</a>
  <div class="letter-chapters"><a href="#incoming" data-reading-chapter="incoming">{t.incoming}</a><span aria-hidden="true">/</span><a href="#reply" data-reading-chapter="reply">{t.reply}</a></div>
  <a href="#top" class="back-to-envelope">{t.envelope} <span aria-hidden="true">↑</span></a>
</nav>
