---
import type { Issue } from '../data/issues';
import { localeOf } from '../data/i18n';
import EditorialText from './EditorialText.astro';
import '../styles/rest.css';
interface Props { readonly reflection: NonNullable<Issue['reflection']>; }
const { reflection } = Astro.props;
const en = localeOf(Astro.url.pathname) === 'en';
---
<aside class="open-question" aria-labelledby="open-question-title">
  <p class="journal-kicker">{en ? 'Before you turn the page' : '翻页之前'}</p>
  <h3 id="open-question-title">{reflection.title}</h3>
  <p class="open-question-prompt"><EditorialText text={reflection.question} keepWords /></p>
  <p class="meta">{reflection.note}</p>
  <span class="open-question-rule" aria-hidden="true"></span>
</aside>
