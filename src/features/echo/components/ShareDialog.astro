---
import { localeOf } from '../data/i18n';
import '../styles/share.css';
import { shareCover } from '../data/covers';
const en = localeOf(Astro.url.pathname) === 'en';
---
<dialog id="echo-share" aria-labelledby="share-heading" data-share-dialog>
  <header class="share-heading"><div><p class="journal-kicker">{en ? 'ECHO / PASS IT ON' : '回声 / 把一份回答，寄给朋友'}</p><h2 id="share-heading">{en ? 'Share this issue' : '分享这一期'}</h2></div><button class="share-close" type="button" aria-label={en ? 'Close sharing' : '关闭分享'}>×</button></header>
  <div class="share-preview"><img width="540" height="720" alt={en ? 'The cover of this issue of Echo' : '本期回声封面'} /></div>
  <div class="share-controls">
    <p class="share-current-title"></p>
    <label for="share-url">{en ? 'Link to this page' : '这一页的链接'}</label>
    <div class="share-link-row"><input id="share-url" readonly type="text" /><button id="share-copy" type="button">{en ? 'Copy link' : '复制链接'}</button></div>
    <div class="share-actions">
      <a class="share-download" href={shareCover('01', en ? 'en' : 'zh')} download>{en ? 'Save cover' : '保存封面'} ↓</a>
      <button id="share-native" type="button" hidden>{en ? 'System share' : '系统分享'} ↗</button>
      <a id="share-x" href="https://twitter.com/intent/tweet" target="_blank" rel="noopener noreferrer">X ↗</a>
      <a id="share-threads" href="https://www.threads.net/intent/post" target="_blank" rel="noopener noreferrer">Threads ↗</a>
    </div>
    <p id="share-note"></p><p id="share-status" role="status" aria-live="polite"></p>
  </div>
</dialog>
<script>import '../share';</script>
