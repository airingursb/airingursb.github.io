---
/**
 * Notes index (zh) — "Field Notes" catalogue. Layout and behaviour live in
 * src/components/notes/NotesIndex.astro (shared with /en/notes/).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesIndex from '../../components/notes/NotesIndex.astro';
import { tSite } from '../../lib/i18n';

const s = tSite('zh').notes;
const hreflang = {
  zh: new URL('/notes/', Astro.site).href,
  en: new URL('/en/notes/', Astro.site).href,
};
---

<BaseLayout title={`${s.siteTitle} | Airing`} description={`Airing 的技术与思考笔记：${s.siteDesc}。包含可交互的沉浸式技术文章。`} hreflang={hreflang}>
  <NotesIndex lang="zh" />

  <script is:inline>
    if (localStorage.getItem('preferred_lang') === 'en') {
      window.location.replace('/en/notes');
    }
  </script>
</BaseLayout>
