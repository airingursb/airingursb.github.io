  .fn-related { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .fn-related-card { padding: 18px; gap: 8px; }
  .fn-related-card .fn-kicker { font-size: 10px; }
  .fn-related-title { font-family: var(--fn-serif); font-size: 17px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }

  /* Right sidebar: TOC + meta */
  .meta-sidebar { padding-top: 32px; position: relative; }
  .meta-inner {
    position: sticky; top: 80px;
  }
  .meta-section { margin-bottom: 28px; }
  .meta-label {
    font-size: 11px; font-weight: 500;
    color: var(--c-text-dim);
    text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 12px;
  }

  /* TOC */
  .toc-list { list-style: none; }
