---
import SiteHeader from "../../components/SiteHeader.astro";
import CommentSection from '../../components/comments/CommentSection.astro';
import InlineCommentLayer from '../../components/comments/InlineCommentLayer.astro';
import CommentsRuntime from '../../components/comments/CommentsRuntime.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getBacklinks } from '../../lib/backlinks';
import { tSite } from '../../lib/i18n';
import { getGitLastModified } from '../../lib/seo';
import MobileToc from '../../components/MobileToc.astro';
import NoteTitle from '../../components/notes/NoteTitle.astro';
import { topicLabel, formatLabel, titleParts } from '../../lib/field-notes';
import '../../styles/field-notes.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.public && !data.draft);
  const sorted = notes.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
  const enNotes = await getCollection('notesEn', ({ data }) => data.public && !data.draft);
  const enNoteIds = new Set(enNotes.map(n => n.id));
  return sorted.map(note => ({
    params: { slug: note.id },
    props: {
      note,
      allNotes: sorted,
      hasEn: enNoteIds.has(note.id),
    },
  }));
}

const { note, allNotes, hasEn } = Astro.props;
const { Content, headings } = await render(note);

const backlinkMap = await getBacklinks();
const noteBacklinks = backlinkMap.get(note.data.title.toLowerCase()) || [];

// Related notes: backlinks + notes sharing tags (deduplicated)
const relatedSlugs = new Set(noteBacklinks.map(bl => bl.slug));
const relatedFromTags = allNotes
  .filter(n => n.id !== note.id && !relatedSlugs.has(n.id) && n.data.tags.some(t => note.data.tags.includes(t)))
  .slice(0, 5);
const relatedNotes = [
  ...noteBacklinks.map(bl => ({ title: bl.title, slug: bl.slug })),
  ...relatedFromTags.map(n => ({ title: n.data.title, slug: n.id })),
].slice(0, 8);

const s = tSite('zh').notes;

// Field Notes header + ending (see src/lib/field-notes.ts)
const listHref = '/notes/';
const fnTopic = topicLabel(note.data.topic, 'zh');
const fnParts = titleParts(note.data.title, note.data.immersive?.url, 'zh');
const fnFormat = formatLabel(note.data, 'zh');
const fnRelated = relatedNotes.slice(0, 3).map(r => ({ ...r, topic: topicLabel(allNotes.find(n => n.id === r.slug)?.data.topic, 'zh') }));

// Reading time: count CJK characters and Latin words separately
const cjkChars = (note.body?.match(/[\u4e00-\u9fff]/g) || []).length;
const latinWords = note.body?.split(/\s+/).filter(w => w.length > 0).length || 0;
const readingMinutes = Math.max(1, Math.ceil((cjkChars / 300) + (latinWords / 200)));
const readingTime = s.readingTime(readingMinutes);

const hreflang = hasEn ? {
  zh: new URL(`/notes/${note.id}/`, Astro.site).href,
  en: new URL(`/en/notes/${note.id}/`, Astro.site).href,
} : undefined;

const noteUrl = new URL(`/notes/${note.id}/`, Astro.site).href;
const dateModified = getGitLastModified(`src/content/notes/${note.id}.mdx`);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": note.data.title,
  "description": note.data.summary,
  "datePublished": new Date(note.data.date).toISOString(),
  "dateModified": (dateModified ?? new Date(note.data.date)).toISOString(),
  "author": { "@type": "Person", "name": "Airing", "url": "https://ursb.me" },
  "publisher": { "@type": "Person", "name": "Airing", "url": "https://ursb.me" },
  "url": noteUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": noteUrl },
  "inLanguage": "zh-CN",
  "image": `${Astro.site || 'https://ursb.me/'}og/notes/${note.id}.png`,
  ...(note.data.tags.length > 0 ? { "keywords": note.data.tags.join(", ") } : {}),
};
---
<BaseLayout title={`${note.data.title} | ${s.siteTitle}`} description={note.data.summary} ogImage={`${Astro.site || 'https://ursb.me/'}og/notes/${note.id}.png`} ogType="article" hreflang={hreflang}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="note-detail-page fn-page">
    <SiteHeader lang="zh" hasEnVersion={hasEn} />

    <main class="detail-main">
      <div class="three-col">
        <!-- Center: Article -->
        <div class="article-col" data-pagefind-body>
          <header class="article-header fn-head">
            <nav class="fn-crumb" aria-label="面包屑">
              <a href={listHref}>← FIELD NOTES</a>
              {fnTopic && <><span aria-hidden="true"> / </span><a href={`${listHref}?topic=${note.data.topic}`}>{fnTopic}</a></>}
            </nav>
            <span class="fn-kicker">FIELD NOTE{fnTopic && ` · ${fnTopic}`} · {note.data.date.replace(/-/g, '.')}</span>
            <h1><NoteTitle parts={fnParts} /></h1>
            <p class="fn-standfirst">{note.data.summary}</p>
            <div class="fn-meta">
              <span>AUTHOR <b>Airing</b></span>
              {note.data.tags.length > 0 && <span>TOPIC <b>{note.data.tags.slice(0, 3).join(' · ')}</b></span>}
              <span>FORMAT <b>{fnFormat} · {readingTime}</b></span>
            </div>
            {note.data.immersive && !note.body?.includes(`](${note.data.immersive.url})`) && <a class="fn-immersive" href={note.data.immersive.url}>进入沉浸式阅读 →</a>}
          </header>

          <article class="prose">
            <Content />
          </article>

          <section class="fn-end" data-pagefind-ignore>
            {note.data.tags.length > 0 && (
              <div class="fn-end-tags">
                {note.data.tags.map(tag => (
                  <a href={`${listHref}?tag=${encodeURIComponent(tag)}`} class="fn-chip fn-chip-sm">{tag}</a>
                ))}
              </div>
            )}
            {fnRelated.length > 0 && (
              <>
                <h2 class="fn-end-title">{s.relatedNotes}</h2>
                <div class="fn-related">
                  {fnRelated.map(r => (
                    <a href={`/notes/${r.slug}/`} class="fn-card fn-related-card">
                      <span class="fn-kicker">{r.topic || 'FIELD NOTE'}</span>
                      <span class="fn-related-title">{r.title}</span>
                    </a>
                  ))}
                </div>
              </>
            )}
          </section>
        </div>

        <!-- Right: TOC + Meta -->
        <aside class="meta-sidebar">
          <div class="meta-inner">
            {headings.length > 0 && (
              <div class="meta-section">
                <div class="meta-label">{s.toc}</div>
                <ul class="toc-list">
                  {headings
                    .filter(h => h.depth <= 3)
                    .map(h => (
                      <li class:list={[{ 'toc-h3': h.depth === 3 }]}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                </ul>
              </div>
            )}


            <!-- Stats block -->
            <div class="meta-section" id="noteStatsBlock" style="display:none;">
              <div class="meta-label">Stats</div>
              <div class="meta-stats">
                <span id="noteViewsDisplay"></span>
                <span id="noteLikesDisplay"></span>
                <span id="noteCommentsDisplay"></span>
              </div>
            </div>

          </div>

          <!-- Comment cards rail (absolutely positioned within .meta-sidebar) -->
          <div class="cr-cards" id="commentCards"></div>
        </aside>
      </div>
    </main>

    <!-- Article Like -->
    <div class="article-like-section">
      <div class="al-rule"></div>
      <button class="article-like-btn" id="articleLikeBtn">
        <svg class="al-icon" viewBox="0 0 24 24" fill="none" width="22" height="22">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
        <span class="al-count" id="articleLikeCount">0</span>
        <span class="al-label">likes</span>
      </button>
      <div class="al-rule"></div>
    </div>

    <CommentSection lang="zh" />
  </div>

  <InlineCommentLayer lang="zh" />

  <script is:inline>
  (function() {
    // TOC active state highlighting
    var tocLinks = document.querySelectorAll('.toc-list a');
    if (tocLinks.length) {
      var headingEls = Array.from(tocLinks).map(function(a) {
        var id = decodeURIComponent(a.getAttribute('href').slice(1));
        return document.getElementById(id);
      }).filter(Boolean);

      var current = '';
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) current = entry.target.id;
        });
        tocLinks.forEach(function(link) {
          var li = link.parentElement;
          var id = decodeURIComponent(link.getAttribute('href').slice(1));
          if (id === current) li.classList.add('active');
          else li.classList.remove('active');
        });
      }, { rootMargin: '0px 0px -70% 0px', threshold: 0 });

      headingEls.forEach(function(el) { observer.observe(el); });
    }
  })();
  </script>

  <script is:inline>
  (function() {
    var API = 'https://chat.ursb.me';
    var NOTE_SLUG = 'note/' + location.pathname.replace(/^\/(?:en\/)?notes\//, '').replace(/\/$/, '');

    // Track pageview (fire-and-forget). Never write local-dev traffic to prod.
    var host = location.hostname;
    if (host === 'ursb.me' || host === 'www.ursb.me' || host === 'airingursb.github.io') {
      fetch(API + '/api/posts/' + encodeURIComponent(NOTE_SLUG) + '/view', { method: 'POST' }).catch(function() {});
    }

    // Fetch and display view count
    fetch(API + '/api/posts/' + encodeURIComponent(NOTE_SLUG) + '/views')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var pv = d.pv || 0;
        if (pv > 0) {
          var el = document.getElementById('noteViewsDisplay');
          if (el) { el.textContent = pv.toLocaleString() + ' views'; el.style.display = 'block'; }
          showStatsBlock();
        }
      })
      .catch(function() {});

    function showStatsBlock() {
      var block = document.getElementById('noteStatsBlock');
      if (block) block.style.display = '';
    }

    var articleLikeBtn = document.getElementById('articleLikeBtn');
    var articleLikeCount = document.getElementById('articleLikeCount');

    function handleResponse(r) {
      return r.json().then(function(data) {
        if (!r.ok) return Promise.reject(data);
        return data;
      });
    }
    function apiGet(path) {
      return fetch(API + path, { headers: { 'Origin': location.origin } }).then(handleResponse);
    }
    function apiPost(path, body) {
      return fetch(API + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      }).then(handleResponse);
    }

    // =====================================================================
    // ARTICLE LIKES
    // =====================================================================
    var articleLiked = false;

    function loadArticleLikes() {
      apiGet('/api/posts/' + encodeURIComponent(NOTE_SLUG) + '/likes').then(function(res) {
        articleLikeCount.textContent = res.count;
        articleLiked = res.liked;
        if (articleLiked) articleLikeBtn.classList.add('liked');
        if (res.count > 0) {
          var lkEl = document.getElementById('noteLikesDisplay');
          if (lkEl) { lkEl.textContent = res.count.toLocaleString() + ' likes'; lkEl.style.display = 'block'; }
          showStatsBlock();
        }
        try {
          var stored = JSON.parse(localStorage.getItem('post_likes') || '[]');
          var set = new Set(stored);
          if (res.liked) set.add(NOTE_SLUG); else set.delete(NOTE_SLUG);
          localStorage.setItem('post_likes', JSON.stringify(Array.from(set)));
        } catch(e) {}
      });
    }

    articleLikeBtn.addEventListener('click', function() {
      var prevLiked = articleLiked;
      var prevCount = parseInt(articleLikeCount.textContent) || 0;
      var newLiked = !prevLiked;
      var newCount = newLiked ? prevCount + 1 : Math.max(0, prevCount - 1);

      articleLiked = newLiked;
      articleLikeCount.textContent = newCount;
      articleLikeBtn.classList.toggle('liked', newLiked);
      var icon = articleLikeBtn.querySelector('.al-icon path');
      icon.setAttribute('fill', newLiked ? 'currentColor' : 'none');

      apiPost('/api/posts/' + encodeURIComponent(NOTE_SLUG) + '/like', {}).then(function(res) {
        articleLiked = res.liked;
        articleLikeCount.textContent = res.count;
        articleLikeBtn.classList.toggle('liked', res.liked);
        icon.setAttribute('fill', res.liked ? 'currentColor' : 'none');
        var lkEl = document.getElementById('noteLikesDisplay');
        if (res.count > 0) {
          if (lkEl) { lkEl.textContent = res.count.toLocaleString() + ' likes'; lkEl.style.display = 'block'; }
          showStatsBlock();
        } else {
          if (lkEl) lkEl.style.display = 'none';
        }
        try {
          var stored = JSON.parse(localStorage.getItem('post_likes') || '[]');
          var set = new Set(stored);
          if (res.liked) set.add(NOTE_SLUG); else set.delete(NOTE_SLUG);
          localStorage.setItem('post_likes', JSON.stringify(Array.from(set)));
        } catch(e) {}
      }).catch(function() {
        articleLiked = prevLiked;
        articleLikeCount.textContent = prevCount;
        articleLikeBtn.classList.toggle('liked', prevLiked);
        icon.setAttribute('fill', prevLiked ? 'currentColor' : 'none');
      });
    });

    // =====================================================================
    // COMMENTS — rendered by src/components/comments (CommentsRuntime);
    // the shared runtime reports the count for the sidebar stats.
    // =====================================================================
    document.addEventListener('comments:count', function(e) {
      var count = e.detail && e.detail.count;
      if (!(count > 0)) return;
      var cmEl = document.getElementById('noteCommentsDisplay');
      if (cmEl) { cmEl.textContent = count.toLocaleString() + ' comments'; cmEl.style.display = 'block'; }
      showStatsBlock();
    });

    loadArticleLikes();
  })();
  </script>
  <CommentsRuntime lang="zh" kind="note" />
  <MobileToc lang="zh" content=".article-col .prose" maxWidth={960} readingTime={readingMinutes} comments="#bottomComments" />
</BaseLayout>

<style is:global>
  body:has(.note-detail-page) {
    display: block;
    padding: 0;
    align-items: stretch;
    justify-content: stretch;
  }

  /* Prose styles for notes */
  .note-detail-page .prose {
    font-size: 18px;
    line-height: 2.0;
    color: var(--c-text);
    font-family: 'Noto Serif SC', 'Source Han Serif CN', 'Source Han Serif SC', 'Songti SC', STSong, serif;
    letter-spacing: 0.02em;
  }
  .note-detail-page .prose p { margin-bottom: 24px; }
  .note-detail-page .prose h2 {
    font-family: 'Noto Serif SC', 'Source Han Serif CN', 'Songti SC', serif;
    font-size: 24px; font-weight: 700;
    margin-top: 48px; margin-bottom: 20px;
    color: var(--c-text);
    line-height: 1.4; letter-spacing: 0.01em;
  }
  .note-detail-page .prose h3 {
    font-family: 'Noto Serif SC', 'Source Han Serif CN', 'Songti SC', serif;
    font-size: 19px; font-weight: 600;
    margin-top: 40px; margin-bottom: 16px;
    color: var(--c-text);
    line-height: 1.45;
  }
  .note-detail-page .prose a {
    color: var(--accent); text-decoration: none;
    border-bottom: 1px solid rgba(var(--accent-rgb, 74,222,128), 0.25);
  }
  .note-detail-page .prose a:hover { border-bottom-color: var(--accent); }
  .note-detail-page .prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: rgba(var(--c-overlay-rgb), 0.06);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .note-detail-page .prose pre {
    background: #24292e; /* matches Shiki github-dark (astro.config.mjs) */
    border-radius: 10px;
    padding: 20px;
    overflow-x: auto;
    margin: 24px 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .note-detail-page .prose pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    color: #e1e4e8;
  }
  .note-detail-page .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 16px;
    margin: 24px 0;
    color: var(--c-text-dim);
  }
  .note-detail-page .prose img {
    max-width: 100%;
    border-radius: 8px;
    margin: 16px 0;
  }
  .note-detail-page .prose ul, .note-detail-page .prose ol {
    padding-left: 24px;
    margin-bottom: 20px;
  }
  .note-detail-page .prose li { margin-bottom: 6px; }
  /* ── Markdown tables — Editorial / Stripe Press style ── */
  .note-detail-page .prose table {
    width: 100%;
    margin: 24px 0;
    border-collapse: collapse;
    border-top: 2px solid var(--c-text);
    border-bottom: 1px solid var(--c-text);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Inter", sans-serif;
    font-size: 14px;
  }
  .note-detail-page .prose thead th {
    text-align: left;
    padding: 12px 16px;
    font-family: "Inter", -apple-system, "PingFang SC", sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-dim);
    border-bottom: 1px solid rgba(var(--c-overlay-rgb), 0.18);
  }
  .note-detail-page .prose tbody td {
    padding: 14px 16px;
    color: var(--c-text);
    border-bottom: 1px solid rgba(var(--c-overlay-rgb), 0.08);
    font-variant-numeric: tabular-nums;
    line-height: 1.55;
  }
  .note-detail-page .prose tbody tr:last-child td { border-bottom: none; }
  .note-detail-page .prose tbody tr:hover td { background: rgba(var(--c-overlay-rgb), 0.03); }
  /* Honor markdown column alignment (e.g. | col |--:|) — second column tends to be the value */
  .note-detail-page .prose table td[align="right"],
  .note-detail-page .prose table th[align="right"] { text-align: right; }
  .note-detail-page .prose table td[align="center"],
  .note-detail-page .prose table th[align="center"] { text-align: center; }
  /* When inside scrolling viewport on small screens */
  @media (max-width: 640px) {
    .note-detail-page .prose table { font-size: 13px; }
    .note-detail-page .prose thead th,
    .note-detail-page .prose tbody td { padding: 10px 12px; }
  }

  /* Interactive component blocks */
  .note-detail-page .interactive-block {
    margin: 32px 0;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(var(--c-overlay-rgb), 0.02);
  }
  .note-detail-page .interactive-block-header {
    padding: 12px 20px;
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 1px solid var(--c-border);
    font-size: 12px; color: var(--c-text-dim);
  }
  .note-detail-page .interactive-block-body {
    padding: 32px;
    min-height: 200px;
  }

  /* Wikilink style */
  .note-detail-page .wikilink {
    color: var(--accent);
    border-bottom: 1px dashed var(--accent);
    padding-bottom: 1px;
  }
  .note-detail-page .wikilink:hover { border-bottom-style: solid; }

  /* Highlight, card, popover, sheet and thread styles: components/comments/comments.css */

  /* ===== Comment cards in meta sidebar ===== */
  .cr-cards {
    position: absolute;
    top: 0; left: 0; right: 0;
    pointer-events: none;
  }
  .cr-cards .cm-card {
    pointer-events: auto;
  }
  /* ===== Article Like Section ===== */
  .article-like-section {
    display: flex; align-items: center; gap: 24px;
    max-width: 1200px; margin: 0 auto;
    padding: 48px 48px 0;
  }
  .al-rule { flex: 1; height: 1px; background: var(--c-border); }
  .article-like-btn {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 28px;
    background: rgba(var(--c-overlay-rgb, 0,0,0),0.03);
    border: 1px solid var(--c-border);
    border-radius: 100px;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: all 0.25s;
    white-space: nowrap;
    font-family: inherit;
  }
  .article-like-btn:hover {
    border-color: var(--c-border-light);
    background: rgba(var(--c-overlay-rgb, 0,0,0),0.06);
    color: var(--c-text);
  }
  .article-like-btn.liked {
    border-color: rgba(239,68,68,0.4);
    background: rgba(239,68,68,0.08);
    color: #ef4444;
  }
  .article-like-btn .al-icon { transition: transform 0.25s; }
  .article-like-btn.liked .al-icon { transform: scale(1.15); }
  .al-count { font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .al-label { font-size: 13px; font-weight: 500; }

  /* ===== Bottom Comment Section ===== */
  .note-detail-page .bottom-comments {
    max-width: 1200px; margin: 0 auto;
    padding: 0 48px 80px;
    /* Notes keep their sans comment heading (posts use the page mono). */
    --cm-title-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  /* Stats display in meta sidebar */
  .meta-stats {
    display: flex; flex-direction: column; gap: 4px;
  }
  .meta-stats span {
    font-size: 12px; color: var(--c-text-dim);
    display: none;
  }

  /* ===== Mobile overrides for globally-defined classes ===== */
  @media (max-width: 960px) {
    .note-detail-page { overflow-x: hidden; }
    .article-like-section { gap: 16px; }
    .article-like-btn { padding: 10px 20px; }
  }
</style>

<style>
  .note-detail-page {
    min-height: 100vh;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  /* Masthead */

  /* Three-column layout */
  .detail-main { padding: 0; }
  .three-col {
    max-width: 1200px; margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(180px, 220px);
    justify-content: space-between;
    gap: 64px;
    align-items: start;
  }

  /* Center: article */
  .article-col { min-width: 0; padding-top: 28px; }
  /* Field Notes header: crumb · kicker · title · standfirst · meta */
  .fn-head { display: flex; flex-direction: column; gap: 18px; padding-bottom: 36px; margin-bottom: 36px; border-bottom: 1px solid var(--fn-rule); }
  .fn-crumb { font-family: var(--fn-mono); font-size: 12px; letter-spacing: 1px; color: var(--fn-mute); margin-bottom: 18px; }
  .fn-crumb a { color: var(--fn-mute); text-decoration: none; }
  .fn-crumb a:hover { color: var(--fn-ink); }
  .fn-head .fn-kicker { font-size: 12px; letter-spacing: 2px; }
  .fn-head h1 {
    margin: 0; font-family: var(--fn-serif);
    font-size: 48px; font-weight: 900; color: var(--fn-ink);
    line-height: 1.2; letter-spacing: -0.5px; overflow-wrap: anywhere;
  }
  .fn-standfirst { margin: 0; font-family: var(--fn-serif); font-size: 19px; line-height: 1.8; color: var(--fn-ink-soft); }
  .fn-head .fn-meta { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 0; padding-top: 16px; border-top: 1px solid var(--fn-rule-soft); font-family: var(--fn-mono); font-size: 12px; color: var(--fn-mute); }
  .fn-head .fn-meta b { color: var(--fn-ink); font-weight: 500; }
  .fn-immersive { align-self: flex-start; font-family: var(--fn-mono); font-size: 13px; color: var(--fn-copper); text-decoration: none; }
  .fn-immersive:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* Ending: tags + related notes */
  .fn-end { margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--fn-rule); }
  .fn-end-tags { display: flex; flex-wrap: wrap; gap: 8px; }
