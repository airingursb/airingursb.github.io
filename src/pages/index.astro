    // ── Visitor Counter ──
    // Counter tracks visits since 2025-01.
    // Historical offset: 24,419 (2025 full year) + 4,236 (2026 Jan-Mar) = 28,655
    // Note: visitor data from 2014-2024 was lost during previous site migrations.
    //
    // Was direct Supabase RPC; replaced 2026-05-21 with blog-api proxy that
    // batches writes in memory (~10min flush) — RPC was the largest disk-IO
    // consumer on the Supabase free tier.
    (function () {
      var COUNTER_API = 'https://chat.ursb.me/api/visitor/increment';
      var HISTORICAL_OFFSET = 28655;
      var el = document.getElementById('visitorCounter');
      var counted = sessionStorage.getItem('visitor_counted');

