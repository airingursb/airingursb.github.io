      <ChapterHead id="guestbook" />

      <!-- Guestbook: git log --graph of the latest comments across the site -->
      <GuestbookCard titles={guestbookPostTitles} />


    </div>

    <BearGardenFooter><GardenScene slot="scene" shared lamps preview={bearPreview} /></BearGardenFooter>

    <div class="visitor-counter" id="visitorCounter"></div>

    <div class="uptime">
      <span class="heartbeat">
        <span class="heartbeat-bar"></span>
        <span class="heartbeat-bar"></span>
        <span class="heartbeat-bar"></span>
        <span class="heartbeat-bar"></span>
        <span class="heartbeat-bar"></span>
        <span class="heartbeat-bar"></span>
        <span class="heartbeat-bar"></span>
        <span class="heartbeat-bar"></span>
      </span>
      <span class="uptime-text" id="uptimeText"></span>
      <span class="uptime-sep">·</span>
      <a href="https://status.ursb.me/status/homepage" target="_blank" class="uptime-status">Status ↗</a>
