        jumpVel = -2;
        jumpY = -0.1;
        wakeBlinkCount = 4;
        wakeBlinkTimer = 0;
        particles = particles.filter(function (p) { return p.type !== 'z'; });
      }

      /* ── Eye tracking ── */
      function updateEyeDirection() {
        var rect = canvas.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top + rect.height / 2;
        var dx = mouseX - cx;
        var dy = mouseY - cy;
        var threshold = 30;
        if (dy < -threshold && Math.abs(dx) < threshold * 1.5) {
          eyeDirection = 'up';
        } else if (dx < -threshold) {
          eyeDirection = 'left';
        } else if (dx > threshold) {
          eyeDirection = 'right';
        } else {
          eyeDirection = 'center';
        }
      }

      function getEyeFrame() {
        switch (eyeDirection) {
          case 'left': return FRAME_LOOK_LEFT;
          case 'right': return FRAME_LOOK_RIGHT;
          case 'up': return FRAME_LOOK_UP;
          default: return FRAME_NORMAL;
        }
      }

      document.addEventListener('mousemove', function (e) {
        mouseX = e.clientX;
        mouseY = e.clientY;
        resetInteraction();
      });

      document.addEventListener('touchmove', function (e) {
        if (e.touches.length > 0) {
          mouseX = e.touches[0].clientX;
          mouseY = e.touches[0].clientY;
        }
      }, { passive: true });

      /* ── Shared tap/click handler ── */
      function handleTap() {
        resetInteraction();
        tapCount++;
        if (tapTimer) clearTimeout(tapTimer);
        tapTimer = setTimeout(function () {
          if (tapCount === 1) {
            if (jumpY >= 0 && jumpVel >= 0) {
              jumpVel = -3;
              jumpY = -0.1;
            }
          } else if (tapCount === 2) {
            flipActive = true;
            flipStart = Date.now();
          } else if (tapCount >= 3) {
            dizzyUntil = Date.now() + 2000;
            bearState = 'dizzy';
            dizzyPhase = 0;
          }
          tapCount = 0;
          tapTimer = null;
        }, 300);
      }

      bearWrapper.addEventListener('click', function (e) {
        // Skip if this click was already handled by touchend
        if (lastTapSource === 'touch') { lastTapSource = ''; return; }
        lastTapSource = 'mouse';
        handleTap();
      });

      /* ── Touch gestures ── */
      bearWrapper.addEventListener('touchstart', function (e) {
        resetInteraction();
        if (e.touches.length === 1) {
          var t = e.touches[0];
          touchStartX = t.clientX;
          touchStartY = t.clientY;
          touchStartTime = Date.now();
          isTouching = true;
          longPressTimer = setTimeout(function () {
            if (isTouching) {
              blushActive = true;
              blushUntil = Date.now() + 1500;
              bearState = 'blushing';
              spawnHearts();
            }
          }, 800);
        }
        e.preventDefault();
      }, { passive: false });

      bearWrapper.addEventListener('touchmove', function (e) {
        e.preventDefault();
        if (e.touches.length > 0) {
          mouseX = e.touches[0].clientX;
          mouseY = e.touches[0].clientY;
        }
      }, { passive: false });

      bearWrapper.addEventListener('touchend', function (e) {
        isTouching = false;
        if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
        var dt = Date.now() - touchStartTime;
        if (dt >= 800) return;
        var lastTouch = e.changedTouches[0];
        var deltaX = lastTouch.clientX - touchStartX;
        var deltaY = lastTouch.clientY - touchStartY;

        if (Math.abs(deltaX) > 30 && Math.abs(deltaX) > Math.abs(deltaY)) {
          walkDirection = deltaX > 0 ? 1 : -1;
          walkOffset = walkDirection * 3;
          walkDecay = Date.now();
        } else if (deltaY < -30 && Math.abs(deltaY) > Math.abs(deltaX)) {
          jumpVel = -5;
          jumpY = -0.1;
        } else if (deltaY > 30 && Math.abs(deltaY) > Math.abs(deltaX)) {
          crouchActive = true;
          crouchUntil = Date.now() + 300;
          bearState = 'crouching';
        } else {
          // No swipe detected — treat as tap
          lastTapSource = 'touch';
          handleTap();
        }
      });

      bearWrapper.addEventListener('touchcancel', function () {
        isTouching = false;
        if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
      });

      /* ── Heart particles ── */
      function spawnHearts() {
        var rect = canvas.getBoundingClientRect();
        var count = 3 + Math.floor(Math.random() * 3);
        for (var i = 0; i < count; i++) {
          particles.push({
            type: 'heart',
            x: rect.left + rect.width / 2 + (Math.random() - 0.5) * 40,
            y: rect.top + rect.height * 0.3,
            vx: (Math.random() - 0.5) * 1.5,
            vy: -1.5 - Math.random() * 1,
            color: '#FF6B8A',
            life: 1000,
            maxLife: 1000,
            size: 3 + Math.random() * 2
          });
        }
      }

      /* ── Sleep Z particles ── */
      function spawnZ() {
        var rect = canvas.getBoundingClientRect();
        particles.push({
          type: 'z',
          x: rect.left + rect.width * 0.7 + Math.random() * 10,
          y: rect.top + rect.height * 0.15,
          vx: 0.3 + Math.random() * 0.3,
          vy: -0.8 - Math.random() * 0.4,
          color: 'var(--c-text-muted)',
          life: 1500,
          maxLife: 1500,
          size: 6 + Math.random() * 4
        });
      }

      /* ── Keyboard sequences ── */
      document.addEventListener('keydown', function (e) {
        resetInteraction();
        keyBuffer.push(e.key);
        if (keyBufferTimer) clearTimeout(keyBufferTimer);
        keyBufferTimer = setTimeout(function () { keyBuffer = []; }, 3000);

        var bufStr = keyBuffer.join(',');

        var konami = 'ArrowUp,ArrowUp,ArrowDown,ArrowDown,ArrowLeft,ArrowRight,ArrowLeft,ArrowRight,b,a';
        if (bufStr.indexOf(konami) !== -1) {
          keyBuffer = [];
          triggerKonami();
          return;
        }

        var zoom = 'ArrowUp,ArrowUp,ArrowDown,ArrowDown';
        if (bufStr.indexOf(zoom) !== -1 && keyBuffer.length === 4) {
          keyBuffer = [];
          triggerPixelZoom();
          return;
        }

        var bear = 'b,e,a,r';
        if (bufStr.indexOf(bear) !== -1) {
          keyBuffer = [];
          triggerDance();
          return;
        }
      });

      function triggerDance() {
        danceActive = true;
        danceUntil = Date.now() + 4000;
        dancePhase = 0;
        bearState = 'dancing';
      }

      function triggerPixelZoom() {
        canvas.style.transition = 'transform 0.5s ease';
        canvas.style.transform = 'scale(3)';
        setTimeout(function () {
          canvas.style.transform = 'scale(1)';
          setTimeout(function () {
            canvas.style.transition = '';
          }, 500);
        }, 1500);
      }

      function triggerKonami() {
        sunglassesActive = true;
        sunglassesUntil = Date.now() + 10000;

        fireworkCanvas = document.createElement('canvas');
        fireworkCanvas.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:9999;';
        fireworkCanvas.width = window.innerWidth;
        fireworkCanvas.height = window.innerHeight;
        document.body.appendChild(fireworkCanvas);
        fireworkCtx = fireworkCanvas.getContext('2d');
        fireworkActive = true;
        fireworkParticles = [];

        var burstCount = 0;
        var burstInterval = setInterval(function () {
          spawnFirework();
          burstCount++;
          if (burstCount >= 8) clearInterval(burstInterval);
        }, 600);

        setTimeout(function () {
          fireworkActive = false;
          if (fireworkCanvas && fireworkCanvas.parentNode) {
            fireworkCanvas.parentNode.removeChild(fireworkCanvas);
          }
          fireworkCanvas = null;
          fireworkCtx = null;
          fireworkParticles = [];
        }, 10000);
      }

      function spawnFirework() {
        if (!fireworkCanvas) return;
        var cx = Math.random() * fireworkCanvas.width;
        var cy = Math.random() * fireworkCanvas.height * 0.6 + fireworkCanvas.height * 0.1;
        var colors = ['#FF6B6B','#4ECDC4','#45B7D1','#96CEB4','#FFEAA7','#DDA0DD','#98D8C8','#F7DC6F','var(--accent)'];
        var count = 30 + Math.floor(Math.random() * 20);
        for (var i = 0; i < count; i++) {
          var angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.3;
          var speed = 2 + Math.random() * 4;
          fireworkParticles.push({
            x: cx, y: cy,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            color: colors[Math.floor(Math.random() * colors.length)],
            life: 1200 + Math.random() * 800,
            maxLife: 1200 + Math.random() * 800,
            size: 2 + Math.random() * 2
          });
        }
      }

      /* ── Draw function ── */
      function draw(frame, offsetY, offsetX) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        var oy = PAD_TOP + Math.round(offsetY);
        var ox = Math.round(offsetX || 0);
        for (var r = 0; r < H; r++) {
          for (var c = 0; c < W; c++) {
            var ci = frame[r][c];
            if (ci === 0) continue;
            ctx.fillStyle = C[ci];
            ctx.fillRect(c + ox, r + oy, 1, 1);
          }
        }
      }

      /* ── Update particles ── */
      function updateParticles(dt) {
        for (var i = particles.length - 1; i >= 0; i--) {
          var p = particles[i];
          p.life -= dt;
          if (p.life <= 0) {
            particles.splice(i, 1);
            continue;
          }
          p.x += p.vx;
          p.y += p.vy;
        }
      }

      /* ── Draw particles on overlay ── */
      function drawParticlesOnPage() {
        if (particles.length === 0) {
          if (particleCtx) particleCtx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
          return;
        }
        if (!particleCanvas) {
          particleCanvas = document.createElement('canvas');
          particleCanvas.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:9998;';
          particleCanvas.width = window.innerWidth;
          particleCanvas.height = window.innerHeight;
          document.body.appendChild(particleCanvas);
          particleCtx = particleCanvas.getContext('2d');
        }
        particleCtx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);

        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          var alpha = Math.max(0, p.life / p.maxLife);
          particleCtx.globalAlpha = alpha;
          particleCtx.fillStyle = p.color;
          if (p.type === 'z') {
            particleCtx.font = Math.round(p.size) + 'px monospace';
            particleCtx.fillText('z', p.x, p.y);
          } else if (p.type === 'heart') {
            var s = p.size;
            particleCtx.fillRect(p.x - s / 2, p.y - s / 2, s, s);
            particleCtx.fillRect(p.x - s, p.y - s, s, s);
            particleCtx.fillRect(p.x, p.y - s, s, s);
          }
        }
        particleCtx.globalAlpha = 1;
      }

      /* ── Update fireworks ── */
      function updateFireworks(dt) {
        if (!fireworkActive || !fireworkCtx) return;
        fireworkCtx.clearRect(0, 0, fireworkCanvas.width, fireworkCanvas.height);
        for (var i = fireworkParticles.length - 1; i >= 0; i--) {
          var p = fireworkParticles[i];
          p.life -= dt;
          if (p.life <= 0) {
            fireworkParticles.splice(i, 1);
            continue;
          }
          p.vy += 0.05;
          p.x += p.vx;
          p.y += p.vy;
          var alpha = Math.max(0, p.life / p.maxLife);
          fireworkCtx.globalAlpha = alpha;
          fireworkCtx.fillStyle = p.color;
          fireworkCtx.fillRect(p.x, p.y, p.size, p.size);
        }
        fireworkCtx.globalAlpha = 1;
      }

      /* ── Handle window resize ── */
      window.addEventListener('resize', function () {
        if (particleCanvas) {
          particleCanvas.width = window.innerWidth;
          particleCanvas.height = window.innerHeight;
        }
        if (fireworkCanvas) {
          fireworkCanvas.width = window.innerWidth;
          fireworkCanvas.height = window.innerHeight;
        }
      });

      /* ── Main animate loop ── */
      function animate(ts) {
        requestAnimationFrame(animate);
        var dt = ts - lastTime;
        if (dt < 50) return;
        lastTime = ts;

        var now = Date.now();

        // Bob
        bobPhase += dt * 0.002;
        var bobY = Math.sin(bobPhase) * 1;

        // Blink timer
        if (wakeBlinkCount > 0) {
          wakeBlinkTimer -= dt;
          if (wakeBlinkTimer <= 0) {
            isBlinking = !isBlinking;
            wakeBlinkTimer = 100;
            if (!isBlinking) wakeBlinkCount--;
          }
        } else {
          blinkTimer -= dt;
          if (blinkTimer <= 0) {
            isBlinking = true;
            setTimeout(function () { isBlinking = false; }, 150);
            blinkTimer = randomBlinkDelay();
          }
        }

        // Jump physics
        if (jumpY < 0 || jumpVel < 0) {
          jumpVel += 0.3;
          jumpY += jumpVel;
          if (jumpY > 0) { jumpY = 0; jumpVel = 0; }
        }

        // Walk offset decay
        if (walkOffset !== 0) {
          var walkElapsed = now - walkDecay;
          if (walkElapsed > 400) {
            walkOffset *= 0.85;
            if (Math.abs(walkOffset) < 0.1) walkOffset = 0;
          }
        }

        // Update timed states
        if (danceActive && now > danceUntil) {
          danceActive = false;
          if (bearState === 'dancing') bearState = 'idle';
        }
        if (dizzyUntil > 0 && now > dizzyUntil) {
          dizzyUntil = 0;
          if (bearState === 'dizzy') bearState = 'idle';
        }
        if (flipActive && now > flipStart + flipDuration) {
          flipActive = false;
          canvas.style.transform = '';
        }
        if (crouchActive && now > crouchUntil) {
          crouchActive = false;
          if (bearState === 'crouching') bearState = 'idle';
        }
        if (blushActive && now > blushUntil) {
          blushActive = false;
          if (bearState === 'blushing') bearState = 'idle';
        }
        if (sunglassesActive && now > sunglassesUntil) {
          sunglassesActive = false;
        }

        // Check idle time for sleep states (only when no active interaction state)
        var idleTime = now - lastInteractionTime;
        if (bearState === 'idle' || bearState === 'sleepy' || bearState === 'sleeping') {
          if (idleTime > 60000) {
            bearState = 'sleeping';
          } else if (idleTime > 30000) {
            bearState = 'sleepy';
          } else {
            bearState = 'idle';
          }
        }

        // Update eye direction
        updateEyeDirection();

        // Determine frame based on state priority:
        // dancing > dizzy > flipping > blushing > crouching > sleeping > sleepy > eye-tracking > idle
        var frame = FRAME_NORMAL;
        var extraOffsetX = 0;
        var extraOffsetY = 0;

        if (danceActive) {
          dancePhase += dt;
          var danceCycle = Math.floor(dancePhase / 200) % 2;
          frame = danceCycle === 0 ? FRAME_DANCE_L : FRAME_DANCE_R;
          extraOffsetY = Math.abs(Math.sin(dancePhase * 0.01)) * -1;
        } else if (dizzyUntil > 0 && now < dizzyUntil) {
          dizzyPhase += dt * 0.01;
          frame = FRAME_DIZZY;
          extraOffsetX = Math.sin(dizzyPhase * 5) * 1;
        } else if (flipActive) {
          var flipProgress = (now - flipStart) / flipDuration;
          var scaleY = Math.cos(flipProgress * Math.PI * 2);
          canvas.style.transform = 'scaleY(' + scaleY.toFixed(3) + ')';
          frame = isBlinking ? FRAME_BLINK : FRAME_NORMAL;
        } else if (sunglassesActive) {
          frame = FRAME_SUNGLASSES;
        } else if (blushActive) {
          frame = FRAME_BLUSH;
        } else if (crouchActive) {
          frame = FRAME_CROUCH;
        } else if (bearState === 'sleeping') {
          frame = FRAME_SLEEP_SIT;
          zSpawnTimer -= dt;
          if (zSpawnTimer <= 0) {
            spawnZ();
            zSpawnTimer = 800 + Math.random() * 400;
          }
        } else if (bearState === 'sleepy') {
          frame = FRAME_SLEEPY;
          sleepyNodPhase += dt * 0.003;
          var nodAmount = Math.sin(sleepyNodPhase) * 1.5;
          var deepDip = Math.sin(sleepyNodPhase * 0.3) > 0.8 ? 1 : 0;
          extraOffsetY = nodAmount + deepDip;
        } else {
          // idle: eye tracking or walk animation
          if (walkOffset !== 0) {
            frame = walkDirection > 0 ? FRAME_DANCE_R : FRAME_DANCE_L;
          } else if (isBlinking) {
            frame = FRAME_BLINK;
          } else {
            frame = getEyeFrame();
          }
        }

        // Override with blink in non-priority states
        if (!danceActive && !(dizzyUntil > 0 && now < dizzyUntil) && !flipActive &&
            !sunglassesActive && !blushActive && !crouchActive &&
            bearState !== 'sleeping' && bearState !== 'sleepy' &&
            isBlinking && walkOffset === 0) {
          frame = FRAME_BLINK;
        }

        draw(frame, bobY + jumpY + extraOffsetY, extraOffsetX + walkOffset);

        // Particles
        updateParticles(dt);
        drawParticlesOnPage();
        updateFireworks(dt);
      }

      requestAnimationFrame(animate);
    })();

    // ── Pixel Weather ──
    (function () {
      var wCanvas = document.getElementById('weatherIcon');
      var wCtx = wCanvas.getContext('2d');
      var badge = document.getElementById('weatherLine');
      var tempEl = document.getElementById('weatherTemp');
      var descEl = document.getElementById('weatherDesc');

      var SUN = '#FFD93D';
      var CLOUD_L = '#8899aa';
      var CLOUD_D = '#667788';
      var RAIN = '#5BC0EB';
      var BOLT = '#FFD93D';

      function px(x, y, color) {
        wCtx.fillStyle = color;
        wCtx.fillRect(x, y, 1, 1);
      }

      function drawIcon(type) {
        wCtx.clearRect(0, 0, 16, 16);

        if (type === 'sunny') {
          px(7,1,SUN); px(8,1,SUN);
          px(3,3,SUN); px(12,3,SUN);
          px(4,4,SUN); px(11,4,SUN);
          px(1,7,SUN); px(2,7,SUN); px(13,7,SUN); px(14,7,SUN);
          px(1,8,SUN); px(2,8,SUN); px(13,8,SUN); px(14,8,SUN);
          px(4,11,SUN); px(11,11,SUN);
          px(3,12,SUN); px(12,12,SUN);
          px(7,14,SUN); px(8,14,SUN);
          for (var y = 5; y <= 10; y++)
            for (var x = 5; x <= 10; x++) {
              if ((y===5||y===10)&&(x===5||x===10)) continue;
              px(x, y, SUN);
            }
        }

        if (type === 'cloudy') {
          px(5,4,CLOUD_L); px(6,4,CLOUD_L); px(7,4,CLOUD_L);
          px(4,5,CLOUD_L); px(5,5,CLOUD_L); px(6,5,CLOUD_L); px(7,5,CLOUD_L); px(8,5,CLOUD_L);
          for (var x2=3; x2<=10; x2++) px(x2,6,CLOUD_L);
          for (var x3=2; x3<=11; x3++) px(x3,7,CLOUD_L);
          for (var x4=2; x4<=11; x4++) px(x4,8,CLOUD_D);
          for (var x5=3; x5<=10; x5++) px(x5,9,CLOUD_D);
        }

        if (type === 'rainy') {
          px(4,2,CLOUD_L); px(5,2,CLOUD_L); px(6,2,CLOUD_L); px(7,2,CLOUD_L);
          for (var x6=3; x6<=9; x6++) px(x6,3,CLOUD_L);
          for (var x7=2; x7<=10; x7++) px(x7,4,CLOUD_L);
          for (var x8=2; x8<=10; x8++) px(x8,5,CLOUD_D);
          px(4,8,RAIN); px(7,7,RAIN); px(10,8,RAIN);
          px(3,10,RAIN); px(6,9,RAIN); px(9,10,RAIN);
          px(5,12,RAIN); px(8,11,RAIN);
        }

        if (type === 'thunder') {
          px(4,1,CLOUD_D); px(5,1,CLOUD_D); px(6,1,CLOUD_D); px(7,1,CLOUD_D);
          for (var x9=3; x9<=9; x9++) px(x9,2,CLOUD_D);
          for (var xa=2; xa<=10; xa++) px(xa,3,CLOUD_D);
          for (var xb=2; xb<=10; xb++) px(xb,4,CLOUD_D);
          px(7,5,BOLT); px(6,6,BOLT); px(7,6,BOLT);
          px(5,7,BOLT); px(6,7,BOLT); px(7,7,BOLT); px(8,7,BOLT);
          px(7,8,BOLT); px(8,8,BOLT);
          px(6,9,BOLT); px(7,9,BOLT);
          px(5,10,BOLT); px(6,10,BOLT);
          px(3,7,RAIN); px(10,8,RAIN);
          px(4,10,RAIN); px(9,11,RAIN);
        }
      }

      // WMO weather code to icon type and description
      function weatherCodeToInfo(code) {
        if (code <= 1) return { type: 'sunny', desc: 'Clear' };
        if (code <= 3) return { type: 'cloudy', desc: 'Cloudy' };
        if (code <= 49) return { type: 'cloudy', desc: 'Foggy' };
        if (code <= 59) return { type: 'rainy', desc: 'Drizzle' };
        if (code <= 69) return { type: 'rainy', desc: 'Rain' };
        if (code <= 79) return { type: 'rainy', desc: 'Snow' };
        if (code <= 84) return { type: 'rainy', desc: 'Showers' };
        if (code <= 94) return { type: 'rainy', desc: 'Snow' };
        return { type: 'thunder', desc: 'Thunderstorm' };
      }

      var weatherFetchedAt = 0;
      function refreshWeather() {
      weatherFetchedAt = Date.now();
      fetch('https://api.open-meteo.com/v1/forecast?latitude=1.29&longitude=103.85&current_weather=true', { signal: AbortSignal.timeout(8000) })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var cw = data.current_weather;
          if (!cw || !Number.isFinite(cw.temperature) || !Number.isInteger(cw.weathercode) || cw.weathercode < 0 || cw.weathercode > 99) return;
          var observedAt = Date.parse(cw.time + 'Z');
          if (!Number.isFinite(observedAt)) return;
          var info = weatherCodeToInfo(cw.weathercode);
          badge.dataset.weather = info.type;
          badge.dataset.observedAt = String(observedAt);
          drawIcon(info.type);
          tempEl.textContent = Math.round(cw.temperature) + '°C';
          descEl.textContent = info.desc;
          badge.classList.add('loaded');
          // E1: expose weather to pet IslandWidget so it can sync fx
          // to real Singapore weather (rainy → ripple, thunder → moonglow
          // burst, cloudy → wind, sunny → sakura).
          window.__petWeather = info.type;
          window.dispatchEvent(new CustomEvent('pet-weather', { detail: info.type }));
          // B2: persist to localStorage so /world/ can pick it up on
          // next visit without re-fetching from open-meteo.
          try { localStorage.setItem('site-weather', info.type); } catch (_) {}
        })
        .catch(function () {
          // Silently fail; the bear expires the previous observation independently.
        });
      }
      refreshWeather();
      setInterval(function () { if (!document.hidden) refreshWeather(); }, 15 * 60 * 1000);
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden && Date.now() - weatherFetchedAt >= 15 * 60 * 1000) refreshWeather();
      });
    })();

    // ── Guestbook ──
    (function () {
      var CHAT_API = 'https://chat.ursb.me';
      var SLUG = 'guestbook';

      var messagesEl = document.getElementById('guestbookMessages');
      var form = document.getElementById('guestbookForm');
      var nameInput = document.getElementById('gbName');
      var emailInput = document.getElementById('gbEmail');
      var msgInput = document.getElementById('gbMessage');
      var submitBtn = form.querySelector('.gb-submit');
      var pendingEl = document.getElementById('gbPending');

      // --- User identity persistence (shared with PostLayout) ---
      var USER_KEY = 'blog-user-identity';
      function getSavedIdentity() {
        try { return JSON.parse(localStorage.getItem(USER_KEY)) || {}; } catch(e) { return {}; }
      }
      function saveIdentity(nickname, email) {
        localStorage.setItem(USER_KEY, JSON.stringify({ nickname: nickname, email: email }));
      }
      (function restoreGuestbookIdentity() {
        var id = getSavedIdentity();
        if (id.nickname) nameInput.value = id.nickname;
        if (id.email) emailInput.value = id.email;
      })();

      // Client-side rate limit: max 5 messages per 10 minutes
      var RATE_LIMIT = 5;
      var RATE_WINDOW = 10 * 60 * 1000;
      function checkRateLimit() {
        var now = Date.now();
        var timestamps = JSON.parse(localStorage.getItem('gb_timestamps') || '[]');
        timestamps = timestamps.filter(function (t) { return now - t < RATE_WINDOW; });
        if (timestamps.length >= RATE_LIMIT) return false;
        timestamps.push(now);
        localStorage.setItem('gb_timestamps', JSON.stringify(timestamps));
        return true;
      }

      function timeAgo(dateStr) {
        var diff = Date.now() - new Date(dateStr).getTime();
        var s = Math.floor(diff / 1000);
        if (s < 60) return t('time_just_now');
        var m = Math.floor(s / 60);
        if (m < 60) return m + ' ' + t('time_min_ago');
        var h = Math.floor(m / 60);
        if (h < 24) return h + ' ' + t('time_h_ago');
        var d = Math.floor(h / 24);
        if (d < 30) return d + ' ' + t('time_d_ago');
        return new Date(dateStr).toLocaleDateString();
      }

      function escapeHtml(s) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(s));
        return div.innerHTML;
      }

      // Site-wide feed state (aggregates every post's comments, newest first)
      var loadMoreBtn = document.getElementById('gbLoadMore');
      var feedItems = [];
      var feedCursor = null;
      var feedLoading = false;

      // "· from «Post Title»" link — slug→title resolved from the build-time
      // map injected as window.__GB_TITLES__; language follows window.currentLang.
      function sourceHtml(slug, anchor) {
        var lang = (window.currentLang === 'en') ? 'en' : 'zh';
        if (slug === 'guestbook') {
          return (lang === 'en' ? 'on ' : '来自 ') +
            '<a class="gb-src" href="#guestbook">' + (lang === 'en' ? 'Guestbook' : '留言板') + '</a>';
        }
        var titles = (window.__GB_TITLES__ || {})[slug];
        var title = titles ? (titles[lang] || titles.zh || titles.en) : null;
        // Notes store their slug as `note/<slug>` and live under /notes/, not
        // /posts/ — route them correctly and drop the prefix from the fallback text.
        var isNote = slug.indexOf('note/') === 0;
        var bareSlug = isNote ? slug.slice(5) : slug;
        var base = isNote
          ? (lang === 'en' ? '/en/notes/' : '/notes/')
          : (lang === 'en' ? '/en/posts/' : '/posts/');
        // Trailing slash matches the site's canonical post/note URLs (trailingSlash
        // 'always') — avoids a redirect and keeps the #inline-<id> anchor intact.
        var url = base + encodeURIComponent(bareSlug) + '/';
        if (anchor) url += '#' + anchor; // inline comments deep-link to the highlight
        var text = title ? ('«' + title + '»') : (isNote ? bareSlug : slug);
        return (lang === 'en' ? 'on ' : '来自 ') +
          '<a class="gb-src" href="' + url + '">' + escapeHtml(text) + '</a>';
      }

      function renderItem(m) {
        var lang = (window.currentLang === 'en') ? 'en' : 'zh';
        var replies = '';
        if (m.replies > 0) {
          replies = ' · ' + m.replies + (lang === 'en' ? (m.replies > 1 ? ' replies' : ' reply') : ' 条回复');
        }
        // Inline "划线" comments: deep-link to the highlight and show the passage
        // the reader replied to (else "同意"-style comments read as non-sequiturs).
        var isInline = m.type === 'inline';
        var anchor = isInline ? ('inline-' + m.id) : null;
        var badge = isInline
          ? ' · <span class="gb-badge">' + (lang === 'en' ? 'highlight' : '划线') + '</span>'
          : '';
        var quote = (isInline && m.selected_text)
          ? '<div class="gb-quote">' + escapeHtml(m.selected_text) + '</div>'
          : '';
        return '<div class="gb-msg">' +
          '<div class="gb-meta">' +
            '<span class="gb-name">&gt; ' + escapeHtml(m.nickname || t('gb_anonymous')) + '</span>' +
            '<span class="gb-time">' + timeAgo(m.created_at) + '</span>' +
          '</div>' +
          quote +
          '<div class="gb-text">' + escapeHtml(m.content) + '</div>' +
          '<div class="gb-from">' + sourceHtml(m.post_slug, anchor) + badge + replies + '</div>' +
        '</div>';
      }

      function renderFeed() {
        if (!feedItems.length) {
          messagesEl.innerHTML = '<div class="gb-empty">' + t('gb_empty') + '</div>';
          loadMoreBtn.style.display = 'none';
          return;
        }
        messagesEl.innerHTML = feedItems.map(renderItem).join('');
        if (feedCursor) {
          loadMoreBtn.style.display = '';
          loadMoreBtn.disabled = false;
          loadMoreBtn.textContent = (window.currentLang === 'en') ? 'Load more' : '加载更多';
        } else {
          loadMoreBtn.style.display = 'none';
        }
      }

      // First batch is large (covers most history; server-cached so it's free
      // on repeat pageviews). "Load more" pulls older comments in 50s.
      var FIRST_LIMIT = 100, MORE_LIMIT = 50;
      function loadFeed(reset) {
        if (feedLoading) return;
        feedLoading = true;
        if (reset) { feedItems = []; feedCursor = null; }
        if (!reset && loadMoreBtn) { loadMoreBtn.disabled = true; loadMoreBtn.textContent = '...'; }
        var url = CHAT_API + '/api/comments/recent?limit=' + (reset ? FIRST_LIMIT : MORE_LIMIT);
        if (!reset && feedCursor) url += '&cursor=' + encodeURIComponent(feedCursor);
        fetch(url, { headers: { 'Origin': location.origin } })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var items = data.comments || [];
            feedItems = reset ? items : feedItems.concat(items);
            feedCursor = data.nextCursor || null;
            renderFeed();
          })
          .catch(function () {
            if (reset) messagesEl.innerHTML = '<div class="gb-empty">' + t('gb_load_fail') + '</div>';
          })
          .finally(function () { feedLoading = false; });
      }

      // alias kept for the submit handler + initial load
      function loadMessages() { loadFeed(true); }

      if (loadMoreBtn) loadMoreBtn.addEventListener('click', function () { loadFeed(false); });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nickname = nameInput.value.trim() || 'anonymous';
        var email = emailInput.value.trim();
        var message = msgInput.value.trim();
        if (!message) return;

        if (!checkRateLimit()) {
          alert(t('gb_too_many'));
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = '...';

        var body = {
          post_slug: SLUG,
          nickname: nickname,
          email: email || undefined,
          content: message
        };

        fetch(CHAT_API + '/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res.comment) {
            saveIdentity(nickname, email);
            msgInput.value = '';
            loadMessages();
          } else {
            throw new Error('No comment returned');
          }
        })
        .catch(function () {
          alert(t('gb_send_fail'));
        })
        .finally(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = '↵';
        });
      });

      loadMessages();

      // Re-render in place on language switch (relocalize titles/time, keep
      // already-loaded pages) instead of refetching.
      window.addEventListener('langchange', function() {
        if (feedItems.length) renderFeed(); else loadMessages();
      });
    })();

    // ── Subscribe ──
    (function () {
      var SUBSCRIBE_API = 'https://chat.ursb.me/api/subscribe';
      var form = document.getElementById('subscribeForm');
      var nameInput = document.getElementById('subName');
      var emailInput = document.getElementById('subEmail');
      var btn = document.getElementById('subBtn');
      var successEl = document.getElementById('subSuccess');
      var errorEl = document.getElementById('subError');
      var countEl = document.getElementById('subCount');
      var countNumEl = document.getElementById('subCountNum');

      function showCount(n) {
        countNumEl.textContent = n.toLocaleString();
        countEl.style.display = '';
      }

      // Fetch subscriber count
      fetch(SUBSCRIBE_API + '/count')
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d.count) showCount(d.count); })
        .catch(function () { showCount(1497); });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = nameInput.value.trim();
        var email = emailInput.value.trim();
        if (!name || !email) return;

        btn.disabled = true;
        btn.textContent = '...';
        successEl.classList.remove('show');
        errorEl.classList.remove('show');

        form.dispatchEvent(new CustomEvent('bear-subscribe-pending', { bubbles: true }));

        var lang = localStorage.getItem('preferred_lang') === 'en' ? 'en' : 'zh';
        fetch(SUBSCRIBE_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, email: email, lang: lang })
        })
        .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
        .then(function (result) {
          if (result.ok && result.data.alreadySubscribed) {
            errorEl.textContent = t('sub_err_exists');
            errorEl.classList.add('show');
            form.dispatchEvent(new CustomEvent('bear-subscribe-error', { bubbles: true }));
          } else if (result.ok || result.data.ok) {
            successEl.classList.add('show');
            form.style.display = 'none';
            form.dispatchEvent(new CustomEvent('bear-subscribe-success', { bubbles: true }));
          } else {
            errorEl.textContent = t('sub_err_fail');
            errorEl.classList.add('show');
            form.dispatchEvent(new CustomEvent('bear-subscribe-error', { bubbles: true }));
          }
        })
        .catch(function () {
          errorEl.textContent = t('sub_err_fail');
          errorEl.classList.add('show');
          form.dispatchEvent(new CustomEvent('bear-subscribe-error', { bubbles: true }));
        })
        .finally(function () {
          btn.disabled = false;
          btn.textContent = t('sub_button');
        });
      });
    })();

    // ── Visitor Counter ──
    // Counter tracks visits since 2025-01.
    // Historical offset: 24,419 (2025 full year) + 4,236 (2026 Jan-Mar) = 28,655
    // Note: visitor data from 2014-2024 was lost during previous site migrations.
    //
    // Was direct Supabase RPC; replaced 2026-05-21 with blog-api proxy that
    // batches writes in memory (~10min flush) — RPC was the largest disk-IO
    // consumer on the Supabase free tier.
    (function () {
      var COUNTER_API = 'https://chat.ursb.me/api/visitor/increment';
      var HISTORICAL_OFFSET = 28655;
      var el = document.getElementById('visitorCounter');
      var counted = sessionStorage.getItem('visitor_counted');

      function show(n) {
        n = n + HISTORICAL_OFFSET;
        var padded = String(n).padStart(8, '0');
        var suffix = t('visitor_suffix') || '';
        el.innerHTML = t('visitor_prefix') + '<span class="visitor-count">' + padded + '</span>' + suffix;
        el.classList.add('loaded');
      }

      if (counted) {
        window._i18nReady.then(function () {
          show(parseInt(counted, 10));
        });
        return;
      }

      fetch(COUNTER_API, { method: 'POST' })
        .then(function (r) { return r.json(); })
        .then(function (resp) {
          var count = resp && typeof resp.count === 'number' ? resp.count : 0;
          if (count > 0) sessionStorage.setItem('visitor_counted', count);
          window._i18nReady.then(function () {
            show(count);
          });
        })
        .catch(function () { });

      window.addEventListener('langchange', function() {
        var c = sessionStorage.getItem('visitor_counted');
        if (c) {
          window._i18nReady.then(function () {
            show(parseInt(c, 10));
          });
        }
      });
    })();
  </script>

  <!-- Music Tooltip -->
  <div class="music-tooltip" id="musicTooltip">
    <div class="music-tooltip-title">
      <span data-i18n="music_top10">Top 10 Tracks</span>
      <span class="music-tooltip-period" id="musicTooltipPeriod"></span>
    </div>
    <div id="musicTooltipList"></div>
  </div>

  <script is:inline>
    // ── Music Card ──
    (function () {
      var data = window.__MUSIC_DATA__;
      if (!data || !data.periods || !data.periods.length) return;
      // Defer rendering until i18n dictionaries are loaded; otherwise
      // t() falls back to returning the raw keys ("music_plays" etc.).
      var ready = window._i18nReady && window._i18nReady.then ? window._i18nReady : Promise.resolve();
      ready.then(render);

      function render() {
      var barsEl = document.getElementById('musicBars');
      var legendEl = document.getElementById('musicLegend');
      var summaryEl = document.getElementById('musicSummary');
      var tooltip = document.getElementById('musicTooltip');
      var tooltipPeriod = document.getElementById('musicTooltipPeriod');
      var tooltipList = document.getElementById('musicTooltipList');
      var colors = data.artistColors;
      var othersColor = data.othersColor || 'var(--c-border)';

      function getColor(name) {
        return colors[name] || othersColor;
      }

      // Build bars
      data.periods.forEach(function (period, pi) {
        var row = document.createElement('div');
        row.className = 'bar-row';

        var header = document.createElement('div');
        header.className = 'bar-header';
        header.innerHTML = '<span class="bar-label">' + period.label +
          '</span><span class="bar-plays">' + period.total.toLocaleString() + ' ' + t('music_plays') + '</span>';

        var track = document.createElement('div');
        track.className = 'bar-track';

        period.artists.forEach(function (artist) {
          var seg = document.createElement('div');
          seg.className = 'bar-seg';
          seg.style.width = (artist.pct * 100) + '%';
          seg.style.background = getColor(artist.name);
          seg.title = artist.name + ' · ' + artist.plays + ' ' + t('music_plays');
          track.appendChild(seg);
        });

        row.appendChild(header);
        row.appendChild(track);
        barsEl.appendChild(row);

        row.addEventListener('mouseenter', function (e) {
          showTooltip(pi, e);
        });
        row.addEventListener('mousemove', function (e) {
          positionTooltip(e);
        });
        row.addEventListener('mouseleave', function () {
          tooltip.classList.remove('visible');
        });
      });

      function showTooltip(pi, e) {
        var period = data.periods[pi];
        tooltipPeriod.textContent = period.label;

        if (!period.tracks || !period.tracks.length) {
          tooltip.classList.remove('visible');
          return;
        }

        var maxCount = period.tracks[0].plays;
        var html = '';
        period.tracks.forEach(function (t, i) {
          var barW = maxCount > 0 ? (t.plays / maxCount * 100) : 0;
          var rankClass = i === 0 ? 'gold' : i === 1 ? 'silver' : i === 2 ? 'bronze' : '';
          var color = getColor(t.artist);
          var display = t.artist + ' - ' + t.name;

          html += '<div class="music-tooltip-wrap">' +
            '<div class="music-tooltip-item">' +
            '<span class="music-tooltip-rank ' + rankClass + '">' + (i + 1) + '</span>' +
            '<span class="music-tooltip-name">' + display + '</span>' +
            '<span class="music-tooltip-count">' + t.plays + '</span>' +
            '</div>' +
            '<div class="music-tooltip-minibar" style="width:' + barW + '%;background:' + color + ';opacity:0.4"></div>' +
            '</div>';
        });

        tooltipList.innerHTML = html;
        positionTooltip(e);
        tooltip.classList.add('visible');
      }

      function positionTooltip(e) {
        var pw = 280;
        var ph = tooltip.offsetHeight || 300;
        var x = e.clientX + 16;
        var y = e.clientY - ph / 2;

        if (x + pw > window.innerWidth - 12) {
          x = e.clientX - pw - 16;
        }
        if (y < 12) y = 12;
        if (y + ph > window.innerHeight - 12) {
          y = window.innerHeight - ph - 12;
        }

        tooltip.style.left = x + 'px';
        tooltip.style.top = y + 'px';
      }

      // Legend
      var seen = {};
      data.periods.forEach(function (p) {
        p.artists.forEach(function (a) {
          if (!seen[a.name]) {
            seen[a.name] = true;
            var item = document.createElement('span');
            item.className = 'music-legend-item';
            item.innerHTML = '<span class="music-legend-dot" style="background:' + getColor(a.name) + '"></span>' + a.name;
            legendEl.appendChild(item);
          }
        });
      });

      // Summary
      var yearText = data.registeredYear ? ' ' + t('music_since') + ' ' + data.registeredYear : '';
      summaryEl.innerHTML = '<span class="music-summary-num">' +
        data.totalScrobbles.toLocaleString() +
        '</span> ' + t('music_scrobbles_suffix') + yearText;

      window.addEventListener('langchange', function() {
        // Re-render summary
        var yt = data.registeredYear ? ' ' + t('music_since') + ' ' + data.registeredYear : '';
        summaryEl.innerHTML = '<span class="music-summary-num">' +
          data.totalScrobbles.toLocaleString() +
          '</span> ' + t('music_scrobbles_suffix') + yt;
        // Re-render bar play counts
        var rows = barsEl.querySelectorAll('.bar-row');
        data.periods.forEach(function(period, pi) {
          if (rows[pi]) {
            var playsSpan = rows[pi].querySelector('.bar-plays');
            if (playsSpan) playsSpan.textContent = period.total.toLocaleString() + ' ' + t('music_plays');
          }
        });
      });
      }
    })();

    // ── Now Playing Card ──
    (function () {
      var LASTFM_KEY = 'f1d1edd883ce6098652b5f10f1ff42c4';
      var LASTFM_USER = 'airingursb';
      var POLL_INTERVAL = 30000; // 30s
      var listEl = document.getElementById('rtList');
      var heroEl = document.getElementById('npHero');
      var vinylEl = document.getElementById('npVinyl');
      var vinylHole = document.getElementById('npVinylHole');
      var npTrackEl = document.getElementById('npTrack');
      var npArtistEl = document.getElementById('npArtist');
      // Corner widget (intro card)
      var cornerEl = document.getElementById('npCorner');
      var cornerVinyl = document.getElementById('npCornerVinyl');
      var cornerHole = document.getElementById('npCornerHole');
      var cornerTrack = document.getElementById('npCornerTrack');
      var cornerArtist = document.getElementById('npCornerArtist');
      if (!listEl) return;

      function timeAgo(uts) {
        if (!uts) return '';
        var diff = Math.floor(Date.now() / 1000) - parseInt(uts, 10);
        if (diff < 0) return '0s';
        if (diff < 60) return diff + 's';
        if (diff < 3600) return Math.floor(diff / 60) + 'm';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h';
        return Math.floor(diff / 86400) + 'd';
      }

      function escHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      function setVinylImage(vinylContainer, holeEl, imageUrl, alt) {
        var existing = vinylContainer.querySelector('img');
        if (imageUrl) {
          if (!existing) {
            existing = document.createElement('img');
            vinylContainer.appendChild(existing);
          }
          existing.src = imageUrl;
          existing.alt = alt || '';
          if (holeEl) holeEl.style.display = 'none';
        } else {
          if (existing) existing.remove();
          if (holeEl) holeEl.style.display = '';
        }
      }

      function renderTracks(tracks) {
        var nowTrack = null;
        var rest = [];
        tracks.forEach(function (t) {
          if (t.nowplaying) nowTrack = t;
          else rest.push(t);
        });

        // Hero section in Now Playing card
        if (nowTrack && heroEl) {
          heroEl.classList.remove('np-hidden');
          if (nowTrack.url) {
            heroEl.style.cursor = 'pointer';
            heroEl.onclick = function () { window.open(nowTrack.url, '_blank'); };
          }
          npTrackEl.textContent = nowTrack.name;
          npArtistEl.textContent = nowTrack.artist;
          setVinylImage(vinylEl, vinylHole, nowTrack.image, nowTrack.album);
          vinylEl.style.animationPlayState = 'running';
        } else if (heroEl) {
          heroEl.classList.add('np-hidden');
          heroEl.onclick = null;
          vinylEl.style.animationPlayState = 'paused';
        }

        // Corner widget in intro card
        if (nowTrack && cornerEl) {
          cornerEl.classList.add('visible');
          cornerEl.href = nowTrack.url || '#';
          cornerTrack.textContent = nowTrack.name;
          cornerArtist.textContent = nowTrack.artist;
          setVinylImage(cornerVinyl, cornerHole, nowTrack.image, nowTrack.album);
        } else if (cornerEl) {
          cornerEl.classList.remove('visible');
        }

        // Track list
        listEl.innerHTML = '';
        rest.forEach(function (t) {
          var tag = t.url ? 'a' : 'div';
          var el = document.createElement(tag);
          el.className = 'rt-item';
          if (t.url) {
            el.href = t.url;
            el.target = '_blank';
            el.rel = 'noopener';
            el.style.textDecoration = 'none';
            el.style.color = 'inherit';
          }
          el.innerHTML = '<span class="rt-time">' + timeAgo(t.ts) + '</span>' +
            '<span class="rt-track">' + escHtml(t.name) + '</span>' +
            '<span class="rt-sep">-</span>' +
            '<span class="rt-artist">' + escHtml(t.artist) + '</span>';
          listEl.appendChild(el);
        });
      }

      function parseTracks(data) {
        var raw = data && data.recenttracks && data.recenttracks.track;
        if (!raw || !raw.length) return [];
        return raw.slice(0, 6).map(function (t) {
          var np = t['@attr'] && t['@attr'].nowplaying === 'true';
          var artist = typeof t.artist === 'object' ? (t.artist['#text'] || '') : String(t.artist || '');
          var album = typeof t.album === 'object' ? (t.album['#text'] || '') : String(t.album || '');
          var image = '';
          if (t.image && t.image.length) {
            var img = t.image[1] || t.image[0];
            image = img['#text'] || '';
          }
          return {
            name: t.name || '',
            artist: artist,
            album: album,
            image: image,
            url: t.url || '',
            nowplaying: np,
            ts: np ? '' : (t.date && t.date.uts || ''),
          };
        });
      }

      function fetchAndRender() {
        var url = 'https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks' +
          '&user=' + LASTFM_USER + '&api_key=' + LASTFM_KEY +
          '&format=json&limit=6';
        fetch(url).then(function (r) { return r.json(); }).then(function (data) {
          var tracks = parseTracks(data);
          if (tracks.length) renderTracks(tracks);
        }).catch(function () {});
      }

      // Initial render from pre-built data
      var prebuilt = window.__NOWPLAYING_DATA__;
      if (prebuilt && prebuilt.length) renderTracks(prebuilt);

      // Live poll
      fetchAndRender();
      setInterval(fetchAndRender, POLL_INTERVAL);
    })();
  </script>

  <script is:inline>
    // ── Uptime ──
    (function () {
      var START = new Date('2014-12-02T00:00:00+08:00').getTime();
      var el = document.getElementById('uptimeText');
      if (!el) return;

      function pad(n) { return n < 10 ? '0' + n : '' + n; }

      function update() {
        var diff = Date.now() - START;
        var s = Math.floor(diff / 1000);
        var m = Math.floor(s / 60); s %= 60;
        var h = Math.floor(m / 60); m %= 60;
        var d = Math.floor(h / 24); h %= 24;
        var y = Math.floor(d / 365); d %= 365;

        var parts = [];
        if (y > 0) parts.push('<span class="uptime-num">' + y + '</span>y');
        parts.push('<span class="uptime-num">' + d + '</span>d');
        parts.push('<span class="uptime-num">' + pad(h) + '</span>h');
        parts.push('<span class="uptime-num">' + pad(m) + '</span>m');
        parts.push('<span class="uptime-num">' + pad(s) + '</span>s');

        el.innerHTML = t('uptime_prefix') + ' ' + parts.join(' ');
      }

      update();
      setInterval(update, 1000);
    })();

    // ── AI Chat ──
    (function () {
      var CHAT_API_BASE = 'https://chat.ursb.me';

      var chatArea = document.getElementById('chatArea');
      var chatInput = document.getElementById('chatInput');
      var chatError = document.getElementById('chatError');
      var chatRounds = document.getElementById('chatRounds');
      var chatPrompt = document.getElementById('chatPrompt');
      var chatSuggestions = document.getElementById('chatSuggestions');

      // ── Fake cursor & Airing_ cursor coordination ──
      var nameCursor = document.querySelector('.cursor');
      var chatActivated = false;

      function updateNameCursor() {
        // Show Airing_ if user has interacted with chat or chat is no longer usable
        nameCursor.style.display = chatActivated ? '' : 'none';
      }

      chatInput.addEventListener('focus', function () {
        chatPrompt.classList.add('hide-cursor');
        chatActivated = true;
        updateNameCursor();
      });
      chatInput.addEventListener('blur', function () {
        if (!chatInput.value) {
          chatPrompt.classList.remove('hide-cursor');
        }
      });

      // Initially hide Airing_ since chat input cursor is visible
      updateNameCursor();

      // ── Suggestion chips ──
      chatSuggestions.addEventListener('click', function (e) {
        var chip = e.target.closest('.chat-suggestion-chip');
        if (!chip) return;
        if (typeof umami !== 'undefined') umami.track('chat-suggestion', { text: chip.textContent });
        submitChat(chip.textContent);
      });

      function hideSuggestions() {
        chatSuggestions.style.display = 'none';
      }

      var TOKEN_KEY = 'chat_visitor_token';
      var MAX_ROUNDS = 10;
      var roundCount = 0;

      // ── Token management ──
      function getToken() {
        return localStorage.getItem(TOKEN_KEY);
      }

      function setToken(token) {
        localStorage.setItem(TOKEN_KEY, token);
      }

      function ensureToken() {
        var existing = getToken();
        if (existing) return Promise.resolve(existing);
        return fetch(CHAT_API_BASE + '/api/chat/init', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        })
          .then(function (r) {
            if (!r.ok) throw new Error('init_failed');
            return r.json();
          })
          .then(function (data) {
            setToken(data.token);
            return data.token;
          });
      }

      // ── History ──
      function loadHistory() {
        var token = getToken();
        if (!token) return;
        fetch(CHAT_API_BASE + '/api/chat/history', {
          headers: { 'X-Visitor-Token': token }
        })
          .then(function (r) {
            if (!r.ok) return;
            return r.json();
          })
          .then(function (data) {
            if (!data || !data.messages) return;
            data.messages.forEach(function (msg) {
              appendMessage(msg.role, msg.content, false);
            });
            if (data.messages.length > 0) hideSuggestions();
            roundCount = data.rounds || 0;
            if (data.maxRounds) MAX_ROUNDS = data.maxRounds;
            updateRoundsDisplay();
            if (roundCount >= MAX_ROUNDS) {
              showLimitReached();
            }
          })
          .catch(function () { /* silently ignore history load errors */ });
      }

      // ── Render markdown (lightweight inline only) ──
      function escapeHtml(str) {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function renderMarkdown(text) {
        var escaped = escapeHtml(text);
        // inline code: `code`
        escaped = escaped.replace(/`([^`]+)`/g, '<code>$1</code>');
        // bold: **text**
        escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        // italic: *text*
        escaped = escaped.replace(/\*([^*]+)\*/g, '<em>$1</em>');
        // links: [text](url)
        escaped = escaped.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
          '<a href="$2" target="_blank" rel="noopener">$1</a>');
        // unordered list items: "- item" at line start
        escaped = escaped.replace(/^- (.+)$/gm, '<li>$1</li>');
        escaped = escaped.replace(/((?:<li>.*<\/li>\n?)+)/g, '<ul>$1</ul>');
        // headings (unlikely but handle): ### heading
        escaped = escaped.replace(/^### (.+)$/gm, '<strong>$1</strong>');
        escaped = escaped.replace(/^## (.+)$/gm, '<strong>$1</strong>');
        // strip newlines inside <ul> blocks to prevent extra <br> between list items
        escaped = escaped.replace(/<ul>([\s\S]*?)<\/ul>/g, function(match, inner) {
          return '<ul>' + inner.replace(/\n/g, '') + '</ul>';
        });
        // double newline = paragraph break, single newline = line break
        escaped = escaped.replace(/\n\n/g, '<br><br>');
        escaped = escaped.replace(/\n/g, '<br>');
        return escaped;
      }

      // ── Append message ──
      function appendMessage(role, content, animate) {
        var msg = document.createElement('div');
        msg.className = 'chat-msg';

        var roleSpan = document.createElement('span');
        roleSpan.className = role === 'user' ? 'chat-role-user' : 'chat-role-ai';
        roleSpan.textContent = role === 'user' ? t('chat_role_user') : t('chat_role_ai');

        var contentSpan = document.createElement('span');
        contentSpan.className = 'chat-content';
        if (animate) {
          contentSpan.className += ' chat-typing';
          contentSpan.innerHTML = '';
        } else {
          contentSpan.innerHTML = renderMarkdown(content);
        }

        msg.appendChild(roleSpan);
        msg.appendChild(contentSpan);
        chatArea.appendChild(msg);

        if (!chatArea.classList.contains('active')) {
          chatArea.classList.add('active');
        }

        chatArea.scrollTop = chatArea.scrollHeight;
        return contentSpan;
      }

      // ── Rounds display ──
      function updateRoundsDisplay() {
        if (roundCount > 0) {
          chatRounds.textContent = roundCount + '/' + MAX_ROUNDS;
        } else {
          chatRounds.textContent = '';
        }
      }

      // ── Show limit reached ──
      function showLimitReached() {
        chatInput.disabled = true;
        chatInput.style.display = 'none';
        document.querySelector('.chat-prompt').style.display = 'none';
        chatActivated = true;
        updateNameCursor();
        var limitMsg = document.createElement('div');
        limitMsg.className = 'chat-limit-msg';
        limitMsg.innerHTML = t('chat_limit');
        chatInput.parentNode.appendChild(limitMsg);
      }

      // ── Send message ──
      function sendMessage(message) {
        chatError.textContent = '';
        chatInput.disabled = true;

        var contentEl = appendMessage('ai', '', true);

        ensureToken()
          .then(function (token) {
            var controller = new AbortController();
            var timeoutId = setTimeout(function () { controller.abort(); }, 30000);

            return fetch(CHAT_API_BASE + '/api/chat', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Visitor-Token': token
              },
              body: JSON.stringify({ message: message }),
              signal: controller.signal
            })
              .then(function (r) {
                clearTimeout(timeoutId);
                if (!r.ok) {
                  return r.json().then(function (err) {
                    throw err;
                  });
                }

                var reader = r.body.getReader();
                var decoder = new TextDecoder();
                var buffer = '';
                var accumulated = '';

                function pump() {
                  return reader.read().then(function (result) {
                    if (result.done) {
                      contentEl.classList.remove('chat-typing');
                      contentEl.innerHTML = renderMarkdown(accumulated);
                      chatArea.scrollTop = chatArea.scrollHeight;
                      updateRoundsDisplay();
                      if (roundCount >= MAX_ROUNDS) {
                        showLimitReached();
                      } else {
                        chatInput.disabled = false;
                        chatInput.focus();
                      }
                      return;
                    }

                    buffer += decoder.decode(result.value, { stream: true });
                    var lines = buffer.split('\n');
                    buffer = lines.pop();

                    lines.forEach(function (line) {
                      if (!line.startsWith('data:')) return;
                      var data = line.slice(5).trim();
                      if (!data) return;
                      try {
                        var evt = JSON.parse(data);
                        if (evt.type === 'delta' && evt.text) {
                          accumulated += evt.text;
                          contentEl.innerHTML = renderMarkdown(accumulated) + '<span class="chat-typing"></span>';
                          chatArea.scrollTop = chatArea.scrollHeight;
                        } else if (evt.type === 'done') {
                          if (evt.round) roundCount = evt.round;
                          if (evt.maxRounds) MAX_ROUNDS = evt.maxRounds;
                        } else if (evt.type === 'error') {
                          throw { code: evt.code || 'STREAM_ERROR', message: evt.message };
                        }
                      } catch (e) {
                        if (e.code) throw e;
                      }
                    });

                    return pump();
                  });
                }

                return pump();
              });
          })
          .catch(function (err) {
            contentEl.classList.remove('chat-typing');
            if (contentEl.textContent === '') {
              contentEl.parentNode.remove();
            }

            var code = err && err.code;
            if (code === 'RATE_LIMITED') {
              chatError.textContent = t('chat_err_rate');
            } else if (code === 'LIMIT_REACHED') {
              showLimitReached();
            } else if (code === 'INVALID_TOKEN') {
              localStorage.removeItem(TOKEN_KEY);
              chatError.textContent = t('chat_err_expired');
            } else if (err && err.name === 'AbortError') {
              chatError.textContent = t('chat_err_timeout');
            } else {
              chatError.textContent = t('chat_err_fail');
            }

            chatInput.disabled = false;
            chatInput.focus();
          });
      }

      // ── Submit chat message ──
      function submitChat(text) {
        var message = text.trim();
        if (!message) return;
        chatInput.value = '';
        hideSuggestions();
        appendMessage('user', message, false);
        sendMessage(message);
      }

      chatInput.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        submitChat(chatInput.value);
      });

      // ── Init ──
      loadHistory();
    })();
  </script>

  <!-- Highlights -->
  <script is:inline>
    (function () {
      var data = window.__HIGHLIGHTS_DATA__;
      if (!data || !data.highlights || !data.highlights.length) return;

      var log = document.getElementById('hlLog');
      var btn = document.getElementById('hlShuffle');
      var highlights = data.highlights;
      var shown = new Set();
      var INITIAL = 3;

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function createEntry(h) {
        var div = document.createElement('div');
        div.className = 'hl-entry';

        var meta = '';
        if (h.title) {
          var source = h.url
            ? '<a href="' + escapeHtml(h.url) + '" target="_blank">' + escapeHtml(h.title) + '</a>'
            : escapeHtml(h.title);
          if (h.author) source += ' — ' + escapeHtml(h.author);
          if (h.date) {
            source += ' · ' + h.date;
            // Calculate days ago
            var parts = h.date.split('.');
            if (parts.length === 3) {
              var hDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
              var daysAgo = Math.floor((Date.now() - hDate.getTime()) / 86400000);
              if (daysAgo >= 0) source += ' · ' + daysAgo + 'd ago';
            }
          }
          meta = '<div class="hl-entry-meta">' + source + '</div>';
        }

        div.innerHTML =
          '<span class="hl-entry-prompt">▍</span>' +
          '<div class="hl-entry-content">' +
            '<div class="hl-entry-text">' + escapeHtml(h.text) + '</div>' +
            meta +
          '</div>';
        return div;
      }

      // Show initial 3 (latest)
      for (var i = 0; i < Math.min(INITIAL, highlights.length); i++) {
        log.appendChild(createEntry(highlights[i]));
        shown.add(highlights[i].id);
      }

      // Shuffle: append one random unshown highlight
      btn.addEventListener('click', function () {
        var pool = highlights.filter(function (h) { return !shown.has(h.id); });
        if (pool.length === 0) {
          // All shown, reset
          shown.clear();
          pool = highlights;
        }
        var pick = pool[Math.floor(Math.random() * pool.length)];
        shown.add(pick.id);
        var entry = createEntry(pick);
        log.appendChild(entry);
        entry.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    })();
  </script>

  <script is:inline>
    // ── Vibe Coding + Life Cards ──
    (function() {
      var data = window.__LOCAL_DATA__;
      if (!data) return;

      var el = function(id) { return document.getElementById(id); };

      function fmtTokens(n) {
        if (n >= 1e9) return (n / 1e9).toFixed(1) + 'B';
        if (n >= 1e6) return (n / 1e6).toFixed(0) + 'M';
        if (n >= 1e3) return (n / 1e3).toFixed(0) + 'K';
        return String(n);
      }

      function fmtNum(n) {
        return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }

      // ── Vibe Coding ──
      var vc = data.vibeCoding;
      if (vc) {
        var daily = vc.daily || {};
        var dates = Object.keys(daily).sort();
        var maxCost = 0;
        for (var k in daily) { if (daily[k].cost > maxCost) maxCost = daily[k].cost; }

        // Header
        var numWeeks = Math.ceil(dates.length > 0 ? ((new Date(dates[dates.length-1]) - new Date(dates[0])) / 86400000 / 7) : 0);
        el('vcTotal').innerHTML = 'Past ' + Math.max(numWeeks, 1) + ' weeks &middot; <strong>$' + vc.totalCost.toFixed(2) + '</strong>';

        // Stats
        el('vcTokens').textContent = fmtTokens(vc.totalTokens);
        el('vcCost').textContent = '$' + Math.round(vc.totalCost);
        el('vcAvg').textContent = '$' + Math.round(vc.avgWeekCost);

        // Models
        var modelsEl = el('vcModels');
        (vc.models || []).forEach(function(m) {
          var tag = document.createElement('span');
          tag.className = 'vc-model-tag';
          tag.innerHTML = '<span class="vc-model-dot" style="background:' + m.color + ';"></span>' + m.name;
          modelsEl.appendChild(tag);
        });

        // Heatmap - calculate weeks to fit container (10px cell + 2px gap = 12px per col)
        var heatmap = el('vcHeatmap');
        var today = new Date();
        var heatmapWidth = heatmap.offsetWidth || 480;
        var totalWeeks = Math.floor((heatmapWidth + 2) / 12);
        totalWeeks = Math.max(8, Math.min(totalWeeks, 52));
        var endDay = new Date(today);
        endDay.setDate(endDay.getDate() + (6 - endDay.getDay()));
        var startDay = new Date(endDay);
        startDay.setDate(startDay.getDate() - (totalWeeks * 7 - 1));

        var cursor = new Date(startDay);
        for (var w = 0; w < totalWeeks; w++) {
          var weekEl = document.createElement('div');
          weekEl.className = 'vc-heatmap-week';
          for (var d = 0; d < 7; d++) {
            var cell = document.createElement('div');
            cell.className = 'vc-heatmap-cell';
            var key = cursor.toISOString().slice(0, 10);
            var entry = daily[key];
            if (entry) {
              var ratio = entry.cost / maxCost;
              if (ratio > 0.6) cell.classList.add('l4');
              else if (ratio > 0.35) cell.classList.add('l3');
              else if (ratio > 0.15) cell.classList.add('l2');
              else cell.classList.add('l1');
              var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
              var dd = new Date(key);
              var label = months[dd.getMonth()] + ' ' + dd.getDate();
              var tip = document.createElement('div');
              tip.className = 'vc-tooltip';
              tip.innerHTML = '<span class="vc-tooltip-date">' + label + '</span><br><span class="vc-tooltip-cost">$' + entry.cost.toFixed(2) + '</span> · ' + fmtTokens(entry.tokens) + ' tokens';
              cell.appendChild(tip);
            }
            if (cursor > today) cell.style.opacity = '0.3';
            weekEl.appendChild(cell);
            cursor.setDate(cursor.getDate() + 1);
          }
          heatmap.appendChild(weekEl);
        }
      }

      // ── Mood ──
      var mood = data.mood;
      if (mood) {
        var dotsEl = el('moodDots');
        var tooltipEl = el('moodTooltip');
        var moodLabels = { rad: 'mood_rad', good: 'mood_good', meh: 'mood_meh', bad: 'mood_bad', awful: 'mood_awful' };
        var moodValues = { rad: 5, good: 4, meh: 3, bad: 2, awful: 1 };
        var moodColors = { rad: '#fbbf24', good: 'var(--accent)', meh: '#38bdf8', bad: '#f472b6', awful: '#ef4444' };
        var moods = mood.recentMoods || [];
        var today = new Date();

        moods.forEach(function(m, i) {
          var dot = document.createElement('div');
          dot.className = 'mood-dot ' + m;
          // Infer date: most recent first, one entry per day
          var d = new Date(today);
          d.setDate(d.getDate() - i);
          var dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          dot.addEventListener('mouseenter', function() {
            tooltipEl.innerHTML = '<span class="mood-tt-mood" style="color:' + (moodColors[m] || 'var(--c-text-muted)') + '">' + t(moodLabels[m] || m) + '</span> · ' + dateStr;
            tooltipEl.classList.add('visible');
          });
          dot.addEventListener('mouseleave', function() {
            tooltipEl.classList.remove('visible');
          });
          dotsEl.appendChild(dot);
        });

        el('moodEntries').textContent = fmtNum(mood.totalEntries);
        el('moodSince').textContent = mood.since;

        // Mood trend chart (last 30 days as SVG line)
        var chartWrap = el('moodChart');
        if (chartWrap && moods.length > 1) {
          var chartDays = Math.min(moods.length, 30);
          var pts = [];
          for (var ci = chartDays - 1; ci >= 0; ci--) {
            pts.push(moodValues[moods[ci]] || 3);
          }
          var w = chartWrap.offsetWidth || 300;
          var h = 60;
          var padY = 6;
          var stepX = w / (pts.length - 1);
          var minV = 1, maxV = 5;
          function yPos(v) { return padY + (maxV - v) / (maxV - minV) * (h - padY * 2); }

          var pathD = pts.map(function(v, i) {
            return (i === 0 ? 'M' : 'L') + (i * stepX).toFixed(1) + ',' + yPos(v).toFixed(1);
          }).join(' ');

          // Area fill
          var areaD = pathD + ' L' + ((pts.length - 1) * stepX).toFixed(1) + ',' + h + ' L0,' + h + ' Z';

          var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
          svg.setAttribute('preserveAspectRatio', 'none');
          svg.style.width = '100%';
          svg.style.height = h + 'px';

          // Gradient
          var defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
          var grad = document.createElementNS('http://www.w3.org/2000/svg', 'linearGradient');
          grad.id = 'moodGrad';
          grad.setAttribute('x1', '0'); grad.setAttribute('y1', '0');
          grad.setAttribute('x2', '0'); grad.setAttribute('y2', '1');
          var stop1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
          stop1.setAttribute('offset', '0%'); stop1.setAttribute('stop-color', 'var(--accent)'); stop1.setAttribute('stop-opacity', '0.2');
          var stop2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
          stop2.setAttribute('offset', '100%'); stop2.setAttribute('stop-color', 'var(--accent)'); stop2.setAttribute('stop-opacity', '0');
          grad.appendChild(stop1); grad.appendChild(stop2);
          defs.appendChild(grad);
          svg.appendChild(defs);

          // Area
          var area = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          area.setAttribute('d', areaD);
          area.setAttribute('fill', 'url(#moodGrad)');
          svg.appendChild(area);

          // Line
          var line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          line.setAttribute('d', pathD);
          line.setAttribute('fill', 'none');
          line.setAttribute('stroke', 'var(--accent)');
          line.setAttribute('stroke-width', '1.5');
          line.setAttribute('stroke-linecap', 'round');
          line.setAttribute('stroke-linejoin', 'round');
          svg.appendChild(line);

          // Interactive dots on the line
          var chartTooltip = document.createElement('div');
          chartTooltip.className = 'mood-tooltip';
          chartTooltip.style.position = 'absolute';
          chartTooltip.style.top = '-16px';
          chartTooltip.style.left = '0';
          chartTooltip.style.pointerEvents = 'none';
          chartWrap.appendChild(chartTooltip);

          pts.forEach(function(v, i) {
            var cx = i * stepX;
            var cy = yPos(v);
            var moodKey = moods[chartDays - 1 - i];
            var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', cx.toFixed(1));
            circle.setAttribute('cy', cy.toFixed(1));
            circle.setAttribute('r', '3');
            circle.setAttribute('fill', moodColors[moodKey] || 'var(--accent)');
            circle.setAttribute('stroke', 'var(--c-bg)');
            circle.setAttribute('stroke-width', '1');
            circle.style.cursor = 'pointer';
            circle.style.opacity = '0';
            circle.style.transition = 'opacity 0.15s';

            var dd = new Date(today);
            dd.setDate(dd.getDate() - (chartDays - 1 - i));
            var dlabel = dd.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

            circle.addEventListener('mouseenter', function() {
              circle.style.opacity = '1';
              chartTooltip.innerHTML = '<span style="color:' + (moodColors[moodKey] || 'var(--c-text-muted)') + '">' + t(moodLabels[moodKey] || moodKey) + '</span> · ' + dlabel;
              chartTooltip.classList.add('visible');
              chartTooltip.style.left = Math.min(cx, w - 80) + 'px';
            });
            circle.addEventListener('mouseleave', function() {
              circle.style.opacity = '0';
              chartTooltip.classList.remove('visible');
            });
            svg.appendChild(circle);
          });

          chartWrap.appendChild(svg);
        }
      }

      // ── Activity ──
      var health = data.health;
      if (health) {
        el('actMove').textContent = health.activeEnergy + ' kJ';
        el('actExercise').textContent = health.exerciseMin + ' min';
        el('actStand').textContent = health.standHours + ' hr';

        el('actSteps').textContent = fmtNum(health.steps);
        el('actSleep').textContent = health.sleep + 'h';
        el('actHR').textContent = health.restingHR + ' bpm';
        el('actSpO2').textContent = health.spo2 + '%';

        // Activity rings (proportional arcs)
        // Move: goal ~1500 kJ, Exercise: goal 30 min, Stand: goal 12 hr
        var moveRatio = Math.min(health.activeEnergy / 1500, 1);
        var exRatio = Math.min(health.exerciseMin / 30, 1);
        var standRatio = Math.min(health.standHours / 12, 1);

        var moveCirc = 2 * Math.PI * 24; // ~150.8
        var exCirc = 2 * Math.PI * 18;   // ~113.1
        var standCirc = 2 * Math.PI * 12; // ~75.4

        el('ringMove').setAttribute('stroke-dasharray', (moveRatio * moveCirc).toFixed(1) + ' ' + moveCirc.toFixed(1));
        el('ringExercise').setAttribute('stroke-dasharray', (exRatio * exCirc).toFixed(1) + ' ' + exCirc.toFixed(1));
        el('ringStand').setAttribute('stroke-dasharray', (standRatio * standCirc).toFixed(1) + ' ' + standCirc.toFixed(1));
      }

      // Workouts
      var workouts = data.workouts;
      if (workouts && workouts.recentWorkouts) {
        var wEl = el('actWorkouts');
        workouts.recentWorkouts.forEach(function(w) {
          var tag = document.createElement('span');
          tag.className = 'life-tag';
          tag.textContent = w.name;
          wEl.appendChild(tag);
        });
      }
    })();
  </script>

  <script is:inline>
    // ── GitHub Card ──
    (function() {
      var data = window.__GITHUB_DATA__;
      if (!data || !data.login) return;

      function fmt(n) {
        if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
        return String(n);
      }

      function fmtNum(n) {
        return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }

      var el = function(id) { return document.getElementById(id); };
      if (data.avatar) el('ghAvatar').src = data.avatar + '&s=40';
      el('ghLink').textContent = data.login;
      el('ghLink').href = 'https://github.com/' + data.login;
      if (data.bio) el('ghBio').textContent = data.bio;
      el('ghFollowers').textContent = fmtNum(data.followers);
      el('ghRepos').textContent = fmt(data.repos);
      el('ghFollowing').textContent = fmt(data.following);
      if (data.sinceYear) {
        var sinceDate = new Date(parseInt(data.sinceYear), 0, 1);
        var days = Math.floor((new Date() - sinceDate) / 86400000);
        var yrs = (days / 365.25).toFixed(2);
        el('ghSince').textContent = fmtNum(days) + 'd';
      }
    })();
  </script>

  <!-- Online presence (site-wide, tiered + i18n) -->
  <script is:inline>
    (function () {
      var DOT = '<span class="online-dot"></span>';
      var N = '<span class="online-count">{n}</span>';
      var tiersZh = [
        { max: 1,   html: '✦ 此刻仅你一人在此' },
        { max: 9,   html: DOT + '此刻有 ' + N + ' 人在站' },
        { max: 19,  html: DOT + N + ' 人在站 · 热闹了起来' },
        { max: 29,  html: DOT + '人潮汇聚 · ' + N + ' 人在站' },
        { max: 99,  html: '🔥 ' + N + ' 人在线 · 站点活跃' },
        { max: Infinity, html: '🔥 ' + N + ' 人在线 · 史无前例' }
      ];
      var tiersEn = [
        { max: 1,   html: '✦ Just you here right now' },
        { max: 9,   html: DOT + N + ' online' },
        { max: 19,  html: DOT + N + ' online · getting busy' },
        { max: 29,  html: DOT + 'a small crowd · ' + N + ' online' },
        { max: 99,  html: '🔥 ' + N + ' online · alive' },
        { max: Infinity, html: '🔥 ' + N + ' online · unprecedented' }
      ];
      function pickTiers() {
        return (window.currentLang === 'zh') ? tiersZh : tiersEn;
      }
      function applyOnlineLocale() {
        var el = document.querySelector('.online-line[data-online-countries="popover"]');
        if (!el) return;
        if (window.currentLang === 'zh') {
          el.setAttribute('data-online-region-label', '地区');
          el.setAttribute('data-online-popover-title', '此刻访客分布');
          el.setAttribute('data-online-total-template', '{n} 人在线');
          el.setAttribute('data-online-locale', 'zh-CN');
        } else {
          el.setAttribute('data-online-region-label', 'regions');
          el.setAttribute('data-online-popover-title', 'Visitors by region');
          el.setAttribute('data-online-total-template', '{n} visitors online');
          el.setAttribute('data-online-locale', 'en');
        }
      }
      applyOnlineLocale();
      window.__ONLINE_CONFIG__ = {
        pageId: null,
        tiers: pickTiers(),
        demoCountries: { SG: 2, US: 1, CN: 1 }
      };
      window.addEventListener('langchange', function () {
        window.__ONLINE_CONFIG__.tiers = pickTiers();
        applyOnlineLocale();
        if (window.__onlineRefresh) window.__onlineRefresh();
      });
    })();
  </script>
