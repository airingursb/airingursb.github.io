      fetch(COUNTER_API, { method: 'POST' })
        .then(function (r) { return r.json(); })
        .then(function (resp) {
          var count = resp && typeof resp.count === 'number' ? resp.count : 0;
          if (count > 0) sessionStorage.setItem('visitor_counted', count);
          window._i18nReady.then(function () {
            show(count);
          });
