                        <h4 class:list={['np-h', i === 0 ? 'np-h2' : 'np-h3']}><span class="rs-zh">{c.titleZh}</span><span class="rs-en">{c.titleEn}</span></h4>
                        <div class="np-meta"><span class="src-tag"><span class="rs-zh">{c.item.source}</span><span class="rs-en">{c.sourceEn}</span></span><span>{c.md}{i === 0 && ` ${c.hm}`}</span>{i === 0 && c.item.author && <span>{c.item.author}</span>}</div>
                      </div>
                    </a>
                  ))}
                </div>
              )}
