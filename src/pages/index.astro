  <!-- Writing card: posts/notes tabs + "new" badge for items within 14 days -->
  <script is:inline>
    (function () {
      var card = document.getElementById('writing');
      if (!card) return;

      var tabs = Array.prototype.slice.call(card.querySelectorAll('[role="tab"]'));
      function select(tab, focus) {
        tabs.forEach(function (t) {
          var on = t === tab;
          var id = t.getAttribute('aria-controls');
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          document.getElementById(id).hidden = !on;
          card.querySelector('.wl-more[data-for="' + id + '"]').hidden = !on;
        });
        if (focus) tab.focus();
      }
      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () { select(tab); });
        tab.addEventListener('keydown', function (e) {
          var next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
          if (next === undefined) return;
          e.preventDefault();
          select(tabs[(next + tabs.length) % tabs.length], true);
        });
      });
      if (location.hash === '#notes') select(tabs[1]);

      var WINDOW_DAYS = 14;
      function tag() {
        var now = Date.now();
        var cutoff = now - WINDOW_DAYS * 86400000;
        var label = window.currentLang === 'en' ? 'NEW' : '新';
        card.querySelectorAll('.post-item').forEach(function (el) {
          var dateEl = el.querySelector('.post-date');
          var titleEl = el.querySelector('.post-title');
          if (!dateEl || !titleEl) return;
          var d = new Date((dateEl.getAttribute('datetime') || '') + 'T00:00:00');
          if (isNaN(d)) return;
          var existing = el.querySelector('.wl-new');
          var isNew = d.getTime() >= cutoff && d.getTime() <= now;
          if (isNew && !existing) {
            existing = document.createElement('span');
            existing.className = 'wl-new';
            titleEl.after(existing);
          } else if (!isNew && existing) {
            existing.remove();
            existing = null;
          }
          if (existing) existing.textContent = label;
        });
      }
      tag();
      window.addEventListener('langchange', tag);
    })();
  </script>

