            {rsFold.length > 0 && (
              <div class="np-fold">
                <div class="np-fold-h">
                  <span>{rsPaper.foldMD ? <>{rsPaper.foldMD}{rsPaper.foldPrev && <> · <span data-i18n="np_prev_day">前一天</span></>}</> : <span data-i18n="np_earlier">更早</span>}</span>
                  <span>{rsFold.length}{' '}<span data-i18n="np_reads">篇</span></span>
                </div>
                <div class="np-row">
                  {rsFold.map((c, i) => (
                    <a
                      href={`/reading/${c.item.slug}/`}
                      data-href-zh={`/reading/${c.item.slug}/`}
                      data-href-en={`/en/reading/${c.item.slug}/`}
                      data-umami-event="reading-card-open"
                      data-umami-event-slug={c.item.slug}
                      data-umami-event-source={c.item.source}
                      data-umami-event-surface="home"
                      data-umami-event-position={i + 5}
                    >
                      {(c.coverZh || c.coverEn) ? (
                        <figure class="np-fig reading-home-thumb">
                          <img src={c.coverZh || c.coverEn} alt={c.titleZh} data-src-zh={c.coverZh || c.coverEn} data-src-en={c.coverEn || c.coverZh} data-alt-zh={c.titleZh} data-alt-en={c.titleEn} width={c.w} height={c.h} loading="lazy" decoding="async" />
                        </figure>
                      ) : null}
                      <h4 class="np-h np-h3"><span class="rs-zh">{c.titleZh}</span><span class="rs-en">{c.titleEn}</span></h4>
                      <div class="np-meta"><span class="src-tag"><span class="rs-zh">{c.item.source}</span><span class="rs-en">{c.sourceEn}</span></span><span>{rsPaper.foldMD ? c.hm : c.md}</span></div>
                    </a>
                  ))}
                </div>
              </div>
