          '</div>' +
          quote +
          '<div class="gb-text">' + escapeHtml(m.content) + '</div>' +
          '<div class="gb-from">' + sourceHtml(m.post_slug, anchor) + badge + replies + '</div>' +
        '</div>';
      }

      function renderFeed() {
        if (!feedItems.length) {
          messagesEl.innerHTML = '<div class="gb-empty">' + t('gb_empty') + '</div>';
          loadMoreBtn.style.display = 'none';
          return;
        }
        messagesEl.innerHTML = feedItems.map(renderItem).join('');
        if (feedCursor) {
          loadMoreBtn.style.display = '';
          loadMoreBtn.disabled = false;
          loadMoreBtn.textContent = (window.currentLang === 'en') ? 'Load more' : '加载更多';
        } else {
          loadMoreBtn.style.display = 'none';
        }
      }

      // First batch is large (covers most history; server-cached so it's free
      // on repeat pageviews). "Load more" pulls older comments in 50s.
      var FIRST_LIMIT = 100, MORE_LIMIT = 50;
      function loadFeed(reset) {
        if (feedLoading) return;
        feedLoading = true;
        if (reset) { feedItems = []; feedCursor = null; }
        if (!reset && loadMoreBtn) { loadMoreBtn.disabled = true; loadMoreBtn.textContent = '...'; }
        var url = CHAT_API + '/api/comments/recent?limit=' + (reset ? FIRST_LIMIT : MORE_LIMIT);
        if (!reset && feedCursor) url += '&cursor=' + encodeURIComponent(feedCursor);
        fetch(url, { headers: { 'Origin': location.origin } })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var items = data.comments || [];
            feedItems = reset ? items : feedItems.concat(items);
            feedCursor = data.nextCursor || null;
            renderFeed();
          })
          .catch(function () {
            if (reset) messagesEl.innerHTML = '<div class="gb-empty">' + t('gb_load_fail') + '</div>';
          })
          .finally(function () { feedLoading = false; });
      }

      // alias kept for the submit handler + initial load
      function loadMessages() { loadFeed(true); }

      if (loadMoreBtn) loadMoreBtn.addEventListener('click', function () { loadFeed(false); });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nickname = nameInput.value.trim() || 'anonymous';
        var email = emailInput.value.trim();
        var message = msgInput.value.trim();
        if (!message) return;

        if (!checkRateLimit()) {
          alert(t('gb_too_many'));
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = '...';

        var body = {
          post_slug: SLUG,
          nickname: nickname,
          email: email || undefined,
          content: message
        };

        fetch(CHAT_API + '/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res.comment) {
            saveIdentity(nickname, email);
            msgInput.value = '';
            loadMessages();
          } else {
            throw new Error('No comment returned');
          }
        })
        .catch(function () {
          alert(t('gb_send_fail'));
        })
        .finally(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = '↵';
        });
      });

      loadMessages();

      // Re-render in place on language switch (relocalize titles/time, keep
      // already-loaded pages) instead of refetching.
      window.addEventListener('langchange', function() {
        if (feedItems.length) renderFeed(); else loadMessages();
      });
    })();

    // ── Subscribe ──
    (function () {
