      <!-- Reading Stream: a newspaper front page -->
      {rsLead && rsPaper && (
        <div class="card card-reading-stream" id="reading-stream-card">
          <div class="section-title-row">
            <span class="section-title" data-i18n="sec_reading_stream">阅读流</span>
            <div class="reading-strip-actions">
              <button class="reading-strip-rss" type="button" data-subscribe-open data-subscribe-context="reading" data-subscribe-tab="rss" data-subscribe-surface="home-header">RSS</button>
              <a class="photos-strip-more" href="/reading/" data-href-zh="/reading/" data-href-en="/en/reading/" data-i18n="rdg_view_all" data-umami-event="reading-list-open" data-umami-event-surface="home">查看全部 →</a>
            </div>
          </div>
          <div class="feed-head">
            <span class="feed-head-cmd"><span class="prompt">$</span> reading front-page --date {rsPaper.day}</span>
            <span class="feed-head-total"><strong>{rsPaper.total}</strong>{' '}<span data-i18n="np_reads">篇</span></span>
          </div>
          <div class="np">
            <div class="np-mast">
              <div class="np-ear"><span data-i18n="np_week">近 7 天</span><b>{rsPaper.week}</b><span data-i18n="np_reads">篇</span></div>
              <div class="np-name"><span data-i18n="np_mast">阅读流日报</span><small data-i18n="np_mast_sub">READING STREAM DAILY</small></div>
