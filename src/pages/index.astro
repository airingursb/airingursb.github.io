      <!-- Letter Consultation -->
      <div class="card card-letter" id="letter">
        <div class="section-title" data-i18n="sec_letter">Letter Consultation</div>
        <div class="letter-intro" data-i18n="letter_intro">
          Questions about career, tech, or personal growth? Write me a letter. I offer free email consultation on topics like career planning, software engineering, job hunting, writing, and productivity tools.
        </div>

