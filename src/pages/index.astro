        countEl.style.display = '';
      }

      // Fetch subscriber count
      fetch(SUBSCRIBE_API + '/count')
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d.count) showCount(d.count); })
        .catch(function () { showCount(1497); });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = nameInput.value.trim();
        var email = emailInput.value.trim();
        if (!name || !email) return;

        btn.disabled = true;
        btn.textContent = '...';
        successEl.classList.remove('show');
        errorEl.classList.remove('show');

        var lang = localStorage.getItem('preferred_lang') === 'en' ? 'en' : 'zh';
        fetch(SUBSCRIBE_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, email: email, lang: lang })
        })
        .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
        .then(function (result) {
          if (result.ok && result.data.alreadySubscribed) {
            errorEl.textContent = t('sub_err_exists');
            errorEl.classList.add('show');
          } else if (result.ok || result.data.ok) {
            successEl.classList.add('show');
