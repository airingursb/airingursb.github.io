        var url = CHAT_API + '/api/comments/recent?limit=' + (reset ? FIRST_LIMIT : MORE_LIMIT);
        if (!reset && feedCursor) url += '&cursor=' + encodeURIComponent(feedCursor);
        fetch(url, { headers: { 'Origin': location.origin } })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var items = data.comments || [];
            feedItems = reset ? items : feedItems.concat(items);
            feedCursor = data.nextCursor || null;
            renderFeed();
          })
          .catch(function () {
            if (reset) messagesEl.innerHTML = '<div class="gb-empty">' + t('gb_load_fail') + '</div>';
          })
          .finally(function () { feedLoading = false; });
      }

      // alias kept for the submit handler + initial load
      function loadMessages() { loadFeed(true); }

      if (loadMoreBtn) loadMoreBtn.addEventListener('click', function () { loadFeed(false); });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nickname = nameInput.value.trim() || 'anonymous';
        var email = emailInput.value.trim();
        var message = msgInput.value.trim();
        if (!message) return;

        if (!checkRateLimit()) {
          alert(t('gb_too_many'));
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = '...';

        var body = {
          post_slug: SLUG,
          nickname: nickname,
          email: email || undefined,
          content: message
        };

        fetch(CHAT_API + '/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res.comment) {
            saveIdentity(nickname, email);
            msgInput.value = '';
            loadMessages();
          } else {
            throw new Error('No comment returned');
          }
        })
        .catch(function () {
          alert(t('gb_send_fail'));
        })
        .finally(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = '↵';
        });
      });

      loadMessages();

      // Re-render in place on language switch (relocalize titles/time, keep
      // already-loaded pages) instead of refetching.
      window.addEventListener('langchange', function() {
        if (feedItems.length) renderFeed(); else loadMessages();
      });
    })();

    // ── Subscribe ──
    (function () {
