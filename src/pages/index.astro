      <!-- Photos -->
      <div class="card card-photos" id="photos-card">
        <div class="section-title-row">
          <span class="section-title" data-i18n="sec_photos">Photos</span>
          <a class="photos-strip-more" href="/photos" data-i18n="ph_view_all">View all →</a>
        </div>
        {openPhoto && (
          <>
            <div class="ph-body">
              <a class="ph-main" id="phMain" href={`/photos/${openPhoto.slug}`} style={`--ph-color: ${openPhoto.color}`}>
                <picture>
                  <source id="phMainAvif" type="image/avif" srcset={openPhoto.avif} />
                  <img id="phMainImg" src={openPhoto.webp} alt={openPhoto.title || openPhoto.slug} loading="lazy" decoding="async" />
                </picture>
              </a>
              <div class="ph-side">
                <div class="ph-exif" id="phExif">
                  <div class="ph-exif-cmd"><span class="prompt">$</span> exif {openPhoto.slug}</div>
                  {openPhoto.title && <div class="ph-exif-title">{openPhoto.title}</div>}
                  {openPhoto.shot && <div><span class="ph-exif-k">taken</span>{openPhoto.shot}</div>}
                  {openPhoto.camera && <div><span class="ph-exif-k">camera</span>{openPhoto.camera}</div>}
                  {openPhoto.settings && <div class="ph-exif-settings">{openPhoto.settings}</div>}
                </div>
                <svg class="ph-hist" id="phHist" viewBox="0 0 128 54" preserveAspectRatio="none" aria-hidden="true">
                  {openPhoto.hist && (
                    <>
                      <path class="ph-hist-r" d={openPhoto.hist.r} />
                      <path class="ph-hist-g" d={openPhoto.hist.g} />
                      <path class="ph-hist-b" d={openPhoto.hist.b} />
                    </>
                  )}
                </svg>
                <div class="ph-thumbs">
                  {recentPhotos.slice(0, 8).map((p: any, i: number) => (
                    <a
                      href={`/photos/${p.slug}`}
                      class:list={['ph-thumb', { 'is-open': i === 0 }]}
                      data-i={i}
                      aria-label={p.title || p.slug}
                      style={`background: ${p.dominantColor}`}
                    >
                      <picture>
                        <source type="image/avif" srcset={p.variants.thumb.avif} />
                        <img src={p.variants.thumb.webp} alt="" loading="lazy" decoding="async" width="160" height="120" />
                      </picture>
                    </a>
                  ))}
                </div>
              </div>
            </div>
            {/* Dominant colour of each recent photo, newest on the left. */}
            <div class="ph-palette">
              {photoView.map((p, i) => (
                <a
                  href={`/photos/${p.slug}`}
                  class:list={['ph-swatch', { 'is-open': i === 0 }]}
                  data-i={i}
                  aria-label={p.title || p.shot || p.slug}
                  style={`background: ${p.color}`}
                ></a>
              ))}
            </div>
            <div class="ph-palette-cap">
              <span>{photoView[0].month}</span>
              <span class="ph-palette-what" data-i18n="ph_palette">dominant colour of the last 12 photos</span>
              <span>{photoView[photoView.length - 1].month}</span>
            </div>
            <script is:inline define:vars={{ photoView }}>
              (function () {
                var card = document.getElementById('photos-card');
                var main = document.getElementById('phMain');
                var img = document.getElementById('phMainImg');
                var avif = document.getElementById('phMainAvif');
                var exif = document.getElementById('phExif');
                var hist = document.getElementById('phHist');
                var open = 0;
                if (!card || !main) return;

                function esc(s) {
                  return String(s).replace(/[&<>"]/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
                  });
                }
                function show(i) {
                  var p = photoView[i];
                  if (!p || i === open) return;
                  open = i;
                  main.href = '/photos/' + p.slug;
                  main.style.setProperty('--ph-color', p.color);
                  img.classList.add('is-loading');
                  img.onload = function () { img.classList.remove('is-loading'); };
                  avif.srcset = p.avif;
                  img.src = p.webp;
                  img.alt = p.title || p.slug;
                  exif.innerHTML =
                    '<div class="ph-exif-cmd"><span class="prompt">$</span> exif ' + esc(p.slug) + '</div>' +
                    (p.title ? '<div class="ph-exif-title">' + esc(p.title) + '</div>' : '') +
                    (p.shot ? '<div><span class="ph-exif-k">taken</span>' + esc(p.shot) + '</div>' : '') +
                    (p.camera ? '<div><span class="ph-exif-k">camera</span>' + esc(p.camera) + '</div>' : '') +
                    (p.settings ? '<div class="ph-exif-settings">' + esc(p.settings) + '</div>' : '');
                  hist.innerHTML = p.hist
                    ? '<path class="ph-hist-r" d="' + p.hist.r + '"/><path class="ph-hist-g" d="' + p.hist.g + '"/><path class="ph-hist-b" d="' + p.hist.b + '"/>'
                    : '';
                  card.querySelectorAll('[data-i]').forEach(function (a) {
                    a.classList.toggle('is-open', +a.getAttribute('data-i') === i);
                  });
                }
                // Hover swaps on pointer devices; a tap just opens the photo.
                if (window.matchMedia('(hover: hover)').matches) {
                  card.querySelectorAll('.ph-thumb, .ph-swatch').forEach(function (a) {
                    var i = +a.getAttribute('data-i');
                    a.addEventListener('mouseenter', function () { show(i); });
                    a.addEventListener('focus', function () { show(i); });
                  });
                }
              })();
            </script>
          </>
        )}
      </div>

