            </div>
            <div class="np-date">
              <span><span class="rs-zh">第 {rsPaper.total} 号</span><span class="rs-en">No. {rsPaper.total}</span></span>
              <span><span class="rs-zh">{rsPaper.dateZh}</span><span class="rs-en">{rsPaper.dateEn}</span></span>
              {rsPaper.sources.length > 0 && (
                <span class="opt">{rsPaper.sources.map(([src, n], i) => (
                  <>{i > 0 && ' · '}<span class="rs-zh">{src}</span><span class="rs-en">{readingSourceLabel(src, 'en')}</span> {n}</>
                ))}</span>
              )}
            </div>
            <div class:list={['np-body', { 'np-body--solo': rsSide.length === 0 }]}>
              {[rsLead].map((c) => (
                <a
                  class="np-lead"
                  href={`/reading/${c.item.slug}/`}
                  data-href-zh={`/reading/${c.item.slug}/`}
                  data-href-en={`/en/reading/${c.item.slug}/`}
                  data-umami-event="reading-card-open"
                  data-umami-event-slug={c.item.slug}
                  data-umami-event-source={c.item.source}
                  data-umami-event-surface="home"
                  data-umami-event-position={1}
                >
                  <div class="np-kick"><span class="new">NEW</span><span data-i18n="np_lead">头条</span> · <span class="rs-zh">{c.item.source}</span><span class="rs-en">{c.sourceEn}</span></div>
                  {(c.coverZh || c.coverEn) ? (
                    <figure class="np-fig reading-home-thumb">
                      <img src={c.coverZh || c.coverEn} alt={c.titleZh} data-src-zh={c.coverZh || c.coverEn} data-src-en={c.coverEn || c.coverZh} data-alt-zh={c.titleZh} data-alt-en={c.titleEn} width={c.w} height={c.h} loading="lazy" decoding="async" />
