      <script is:inline>
      // ── Raindrop Bookmarks ──
      // Newest bookmark opens up with its cover; the rest stay one line each.
      // Hovering or focusing a row swaps it into the open slot.
      (function() {
        var data = window.__RAINDROP_DATA__;
        if (!data || !data.bookmarks || !data.bookmarks.length) return;

        var card = document.getElementById('bookmarks');
        var featured = document.getElementById('raindropFeatured');
        var list = document.getElementById('raindropList');
        var items = data.bookmarks.slice(0, 6);
        var NEW_DAYS = 7;

        var head = card.querySelector('.feed-head');
        if (data.total) {
          document.getElementById('raindropTotal').textContent = data.total;
          head.hidden = false;
        }

        // Drop a trailing " | Site", then split "Name — tagline" so the
        // tagline can sit dimmer than the name.
        function splitTitle(title) {
          var parts = (title || '').split(' | ');
          if (parts.length > 1) parts.pop();
          if (parts.length > 1) return { main: parts[0], sub: parts.slice(1).join(' · ') };
          var m = parts[0].match(/^(.+?)\s+[—–-]\s+(.+)$/);
          return m ? { main: m[1], sub: m[2] } : { main: parts[0], sub: '' };
        }
        // Covers come from the bookmarked sites, which can be heavy or refuse
        // to be embedded, so they go through a resizing proxy first.
        function coverSrc(url) {
          return 'https://wsrv.nl/?url=' + encodeURIComponent(url) + '&w=640&h=336&fit=cover&output=webp';
        }
        function parseDate(created) {
          var p = (created || '').split('.');
          return p.length === 3 ? new Date(+p[0], p[1] - 1, +p[2]) : null;
        }
        function mmdd(created) {
          var p = (created || '').split('.');
          return p.length === 3 ? p[1] + '/' + p[2] : created || '';
        }
        function el(tag, cls, text) {
          var e = document.createElement(tag);
          if (cls) e.className = cls;
          if (text != null) e.textContent = text;
          return e;
        }
        function favicon(domain) {
          var img = el('img', 'rd-fav');
          img.src = 'https://rdl.ink/favicon/' + encodeURIComponent(domain);
          img.alt = '';
          img.width = 14;
          img.height = 14;
          img.loading = 'lazy';
          img.referrerPolicy = 'no-referrer';
          img.onerror = function() { img.style.visibility = 'hidden'; };
          return img;
        }
        function titleSpans(target, b, sep) {
          var t = splitTitle(b.title);
          target.appendChild(document.createTextNode(t.main));
          if (t.sub) target.appendChild(el('span', 'rd-sub', sep + t.sub));
        }
        function coverPlaceholder(b) {
          var ph = el('div', 'rd-cover-ph');
          ph.appendChild(favicon(b.domain));
          ph.appendChild(el('span', '', b.domain));
          return ph;
        }

        function renderFeatured(b) {
          var a = el('a', 'rd-feat');
          a.href = b.link;
          a.target = '_blank';
          a.rel = 'noopener';

          var cover = el('div', 'rd-cover');
          if (b.cover) {
            var img = el('img');
            img.alt = '';
            img.loading = 'lazy';
            img.decoding = 'async';
            img.referrerPolicy = 'no-referrer';
            img.onerror = function() {
              if (img.src !== b.cover) img.src = b.cover;
              else cover.replaceChildren(coverPlaceholder(b));
            };
            img.src = coverSrc(b.cover);
            cover.appendChild(img);
          } else {
            cover.appendChild(coverPlaceholder(b));
          }
          a.appendChild(cover);

          var body = el('div', 'rd-feat-body');
          var title = el('div', 'rd-feat-title');
          titleSpans(title, b, ' — ');
          body.appendChild(title);

          // Only my own note gets the accent bar; a site's blurb stays muted.
          if (b.note) body.appendChild(el('div', 'rd-note', b.note));
          else if (b.excerpt) body.appendChild(el('div', 'rd-excerpt', b.excerpt));

          var meta = el('div', 'rd-meta');
          var d = parseDate(b.created);
          if (d && (Date.now() - d.getTime()) / 86400000 < NEW_DAYS) {
            var badge = el('span', 'wl-new', window.currentLang === 'en' ? 'NEW' : '新');
            badge.setAttribute('data-i18n', 'rd_new');
            meta.appendChild(badge);
          }
          meta.appendChild(el('span', '', b.domain));
          meta.appendChild(el('span', '', '·'));
          meta.appendChild(el('span', '', mmdd(b.created)));
          body.appendChild(meta);
          a.appendChild(body);

          featured.replaceChildren(a);
        }

        var rows = [];
        items.forEach(function(b, i) {
          if (i === 0) return;
          var a = el('a', 'rd-row');
          a.href = b.link;
          a.target = '_blank';
          a.rel = 'noopener';
          a.appendChild(favicon(b.domain));
          var title = el('span', 'rd-row-title');
          titleSpans(title, b, ' ');
          a.appendChild(title);
          var lead = el('span', 'wl-lead');
          lead.setAttribute('aria-hidden', 'true');
          a.appendChild(lead);
          a.appendChild(el('span', 'rd-row-domain', b.domain));
          a.appendChild(el('span', 'rd-row-date', mmdd(b.created)));
          rows.push(a);
          list.appendChild(a);
        });

        var active = 0;
        function show(i) {
          if (i === active) return;
          active = i;
          renderFeatured(items[i]);
          rows.forEach(function(r, j) { r.classList.toggle('is-active', j + 1 === i); });
        }
        renderFeatured(items[0]);

        // Swap on hover only where hover exists, so a tap on a phone just
        // opens the link instead of moving it.
        if (window.matchMedia('(hover: hover)').matches) {
          rows.forEach(function(r, j) {
            r.addEventListener('mouseenter', function() { show(j + 1); });
            r.addEventListener('focus', function() { show(j + 1); });
          });
          var preloaded = false;
          card.addEventListener('mouseenter', function() {
            if (preloaded) return;
            preloaded = true;
            items.forEach(function(b) { if (b.cover) new Image().src = coverSrc(b.cover); });
          });
          card.addEventListener('mouseleave', function() {
            if (!card.contains(document.activeElement)) show(0);
          });
          card.addEventListener('focusout', function(e) {
            if (!card.contains(e.relatedTarget)) show(0);
          });
        }
      })();
      </script>

