  <script is:inline>
    // ── Music Card: Last.fm album collage ──
    // Nine most-played albums of the chosen period (user.getTopAlbums, kept
    // in window.__MUSIC_DATA__ by scripts/update_feed.py): #1 spans 2×2 with
    // its name and plays, the others show rank + plays, name on hover.
    (function () {
      var data = window.__MUSIC_DATA__;
      if (!data || !data.periods || !data.periods.some(function (p) { return p.albums && p.albums.length; })) return;
      var grid = document.getElementById('mlGrid');
      var seg = document.getElementById('mlSeg');
      var LABEL = { '7day': '7d', '1month': '30d', '12month': '1y', 'overall': 'all' };
      var cur = '1month';
      var first = true;
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function fmt(n) { return Number(n).toLocaleString('en-US'); }
      function period(k) { return data.periods.filter(function (p) { return p.key === k; })[0]; }
      function art(al) {
        if (al.image) return '<img src="' + esc(al.image) + '" alt="" loading="lazy" decoding="async">';
        return '<span class="ml-sleeve"><b>' + esc(al.name) + '</b><i>' + esc(al.artist) + '</i></span>';
      }
      seg.querySelectorAll('button').forEach(function (b) {
        if (!(period(b.dataset.k) || {}).albums || !period(b.dataset.k).albums.length) b.hidden = true;
        b.addEventListener('click', function () { draw(b.dataset.k); });
      });
      function draw(k) {
        cur = k;
        var p = period(k), pname = t('music_period_' + k), h = '';
        p.albums.forEach(function (al, i) {
          var label = al.name + ' — ' + al.artist + ' · ' + al.plays + ' plays';
          if (i === 0) {
            h += '<a class="ml-t hd" style="--i:0" href="' + esc(al.url) + '" target="_blank" rel="noopener" aria-label="#1 ' + esc(label) + '">' + art(al) +
              '<span class="cap"><span class="k">#1 · ' + esc(pname) + '</span><b>' + esc(al.name) + '</b><i>' + esc(al.artist) + '</i>' +
              '<span class="n">' + fmt(al.plays) + '<small>plays</small></span></span></a>';
          } else {
            h += '<a class="ml-t" style="--i:' + i + '" href="' + esc(al.url) + '" target="_blank" rel="noopener" aria-label="#' + (i + 1) + ' ' + esc(label) + '">' + art(al) +
              '<span class="rk">' + (i + 1) + '</span><span class="pc">' + fmt(al.plays) + '</span>' +
              '<span class="ov"><b>' + esc(al.name) + '</b><i>' + esc(al.artist) + '</i><em>' + fmt(al.plays) + ' plays · #' + (i + 1) + '</em></span></a>';
          }
        });
        grid.innerHTML = h;
        seg.querySelectorAll('button').forEach(function (b) {
          var on = b.dataset.k === k;
          b.classList.toggle('on', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.getElementById('mlCmd').textContent = LABEL[k];
        var top = p.albums.reduce(function (s, a) { return s + a.plays; }, 0);
        document.getElementById('mlAlbums').innerHTML = t('music_albums_in').replace('{p}', esc(pname)).replace('{n}', '<strong>' + fmt(p.albumTotal || p.albums.length) + '</strong>');
        document.getElementById('mlTop').innerHTML = t('music_top_albums').replace('{k}', String(p.albums.length)).replace('{n}', '<strong>' + fmt(top) + '</strong>');
        if (!first) { grid.classList.remove('anim'); void grid.offsetWidth; grid.classList.add('anim'); }
        first = false;
      }
      document.getElementById('mlScrobbles').textContent = fmt(data.totalScrobbles);
      document.getElementById('mlSince').textContent = data.registeredYear || '';
      var ready = window._i18nReady && window._i18nReady.then ? window._i18nReady : Promise.resolve();
      ready.then(function () { draw(cur); });
      window.addEventListener('langchange', function () { first = true; draw(cur); });
    })();

    // ── Now Playing Card ──
    (function () {
      var LASTFM_KEY = 'f1d1edd883ce6098652b5f10f1ff42c4';
      var LASTFM_USER = 'airingursb';
      var POLL_INTERVAL = 30000; // 30s
      var listEl = document.getElementById('rtList');
      var heroEl = document.getElementById('npHero');
      var npDiscEl = document.getElementById('npDisc');
      var npCoverEl = document.getElementById('npCover');
      var npStateEl = document.getElementById('npState');
      var npTrackEl = document.getElementById('npTrack');
      var npArtistEl = document.getElementById('npArtist');
      if (!listEl) return;

      function timeAgo(uts) {
        if (!uts) return '';
        var diff = Math.floor(Date.now() / 1000) - parseInt(uts, 10);
        if (diff < 0) return '0s';
        if (diff < 60) return diff + 's';
        if (diff < 3600) return Math.floor(diff / 60) + 'm';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h';
        return Math.floor(diff / 86400) + 'd';
      }

      function escHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      function renderTracks(tracks) {
        var nowTrack = null;
        var rest = [];
        tracks.forEach(function (t) {
          if (t.nowplaying) nowTrack = t;
          else rest.push(t);
        });

        // The open slot always holds a track: the one playing now, or else
        // the last one played, with its record tucked back in the sleeve.
        var heroTrack = nowTrack || rest.shift();
        if (heroTrack && heroEl) {
          heroEl.classList.remove('np-hidden');
          heroEl.classList.toggle('is-playing', !!nowTrack);
          if (heroTrack.url) heroEl.href = heroTrack.url;
          else heroEl.removeAttribute('href');
          npStateEl.textContent = nowTrack ? 'NOW PLAYING' : 'LAST PLAYED · ' + timeAgo(heroTrack.ts) + ' ago';
          npTrackEl.textContent = heroTrack.name;
          npArtistEl.textContent = heroTrack.album ? heroTrack.artist + ' · ' + heroTrack.album : heroTrack.artist;
          if (heroTrack.image) {
            npCoverEl.src = heroTrack.image;
            npCoverEl.hidden = false;
            npDiscEl.style.setProperty('--np-label', 'url("' + heroTrack.image.replace(/"/g, '%22') + '")');
          } else {
            npCoverEl.hidden = true;
            npDiscEl.style.removeProperty('--np-label');
          }
        } else if (heroEl) {
          heroEl.classList.add('np-hidden');
        }

        // Track list
        listEl.innerHTML = '';
        rest.forEach(function (t) {
          var tag = t.url ? 'a' : 'div';
          var el = document.createElement(tag);
          el.className = 'rt-item';
          if (t.url) {
            el.href = t.url;
            el.target = '_blank';
            el.rel = 'noopener';
            el.style.textDecoration = 'none';
            el.style.color = 'inherit';
          }
          el.innerHTML = (t.image ? '<img class="rt-cover" src="' + escHtml(t.image) + '" alt="" loading="lazy">' : '<span class="rt-cover"></span>') +
            '<span class="rt-track">' + escHtml(t.name) + ' <span class="rt-artist">' + escHtml(t.artist) + '</span></span>' +
            '<span class="wl-lead" aria-hidden="true"></span>' +
            '<span class="rt-time">' + timeAgo(t.ts) + '</span>';
          listEl.appendChild(el);
        });
      }

      function parseTracks(data) {
        var raw = data && data.recenttracks && data.recenttracks.track;
        if (!raw || !raw.length) return [];
        return raw.slice(0, 6).map(function (t) {
          var np = t['@attr'] && t['@attr'].nowplaying === 'true';
          var artist = typeof t.artist === 'object' ? (t.artist['#text'] || '') : String(t.artist || '');
          var album = typeof t.album === 'object' ? (t.album['#text'] || '') : String(t.album || '');
          var image = '';
          if (t.image && t.image.length) {
            // Largest size first: the open slot shows it at 76px.
            for (var k = t.image.length - 1; k >= 0 && !image; k--) image = t.image[k]['#text'] || '';
          }
          return {
            name: t.name || '',
            artist: artist,
            album: album,
            image: image,
            url: t.url || '',
            nowplaying: np,
            ts: np ? '' : (t.date && t.date.uts || ''),
          };
        });
      }

      // The Intro card's member list shows what is playing right now. It reads
      // this poll instead of starting its own: window.__lastfmNowPlaying plus a
      // `lastfm-nowplaying` event whenever the track changes. Only live
      // results count; the prebuilt list is hours old.
      var sharedNow = '';
      function shareNowPlaying(tracks) {
        var t = tracks.filter(function (x) { return x.nowplaying; })[0];
        var now = t ? { name: t.name, artist: t.artist, image: t.image, url: t.url } : null;
        var key = JSON.stringify(now);
        if (key === sharedNow) return;
        sharedNow = key;
        window.__lastfmNowPlaying = now;
        window.dispatchEvent(new CustomEvent('lastfm-nowplaying', { detail: now }));
      }

      function fetchAndRender() {
        var url = 'https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks' +
          '&user=' + LASTFM_USER + '&api_key=' + LASTFM_KEY +
          '&format=json&limit=6';
        fetch(url).then(function (r) { return r.json(); }).then(function (data) {
          var tracks = parseTracks(data);
          if (tracks.length) renderTracks(tracks);
          shareNowPlaying(tracks);
        }).catch(function () {});
      }

      // Initial render from pre-built data
      var prebuilt = window.__NOWPLAYING_DATA__;
      if (prebuilt && prebuilt.length) renderTracks(prebuilt);

      // Live poll
      fetchAndRender();
      setInterval(fetchAndRender, POLL_INTERVAL);
    })();
  </script>

  <script is:inline>
    // ── Uptime ──
    (function () {
      var START = new Date('2014-12-02T00:00:00+08:00').getTime();
      var el = document.getElementById('uptimeText');
      if (!el) return;

      function pad(n) { return n < 10 ? '0' + n : '' + n; }

      function update() {
        var diff = Date.now() - START;
        var s = Math.floor(diff / 1000);
        var m = Math.floor(s / 60); s %= 60;
        var h = Math.floor(m / 60); m %= 60;
        var d = Math.floor(h / 24); h %= 24;
        var y = Math.floor(d / 365); d %= 365;

        var parts = [];
        if (y > 0) parts.push('<span class="uptime-num">' + y + '</span>y');
        parts.push('<span class="uptime-num">' + d + '</span>d');
        parts.push('<span class="uptime-num">' + pad(h) + '</span>h');
        parts.push('<span class="uptime-num">' + pad(m) + '</span>m');
        parts.push('<span class="uptime-num">' + pad(s) + '</span>s');

        el.innerHTML = t('uptime_prefix') + ' ' + parts.join(' ');
      }

      update();
      setInterval(update, 1000);
    })();
  </script>

  <!-- Highlights -->
  <script is:inline>
    // Newest highlight open, the next five one line each. Hovering or focusing
    // a row swaps it into the open slot; "shuf -n 1" pulls a random one there.
    (function () {
      var data = window.__HIGHLIGHTS_DATA__;
      if (!data || !data.highlights || !data.highlights.length) return;

      var card = document.getElementById('highlights');
      var featured = document.getElementById('hlFeatured');
      var list = document.getElementById('hlList');
      var btn = document.getElementById('hlShuffle');
      var highlights = data.highlights;
      var items = highlights.slice(0, 6);

      var head = card.querySelector('.feed-head');
      if (data.total) {
        document.getElementById('hlTotal').textContent = data.total.toLocaleString('en-US');
        head.hidden = false;
      }

      // Readwise cuts long tweets mid-thought: fold the newlines, drop a
      // dangling tail ("需求 1. !", "- ") and fall back to the last full sentence.
      function cleanText(t) {
        t = (t || '').replace(/\s*\n+\s*/g, ' ').replace(/\s{2,}/g, ' ').trim();
        t = t.replace(/(\s*[-–—•!！]|\s+\d+\.)+$/, '').trim();
        if (!/[。！？.!?」”"')）]$/.test(t)) {
          var m = t.match(/^(.*[。！？.!?])/);
          if (m && m[1].length > t.length * 0.5) t = m[1];
          else t += '…';
        }
        return t;
      }
      // "Tweets From 陈大黄" + "@realchendahuang on Twitter" → 陈大黄 @realchendahuang · X
      function source(h) {
        var m = (h.title || '').match(/^Tweets [Ff]rom (.+)$/);
        if (m) {
          var handle = ((h.author || '').match(/@\w+/) || [''])[0];
          return { name: m[1], extra: handle, site: 'X', short: handle || m[1] };
        }
        return { name: '《' + (h.title || '') + '》', extra: h.author || '', site: '', short: h.author || h.title || '' };
      }
      function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text != null) e.textContent = text;
        return e;
      }
      function linkOrDiv(h, cls) {
        var e = el(h.url ? 'a' : 'div', cls);
        if (h.url) {
          e.href = h.url;
          e.target = '_blank';
          e.rel = 'noopener';
        }
        return e;
      }

      function renderFeatured(h, animate) {
        var s = source(h);
        var box = linkOrDiv(h, 'hl-feat' + (animate ? ' is-new' : ''));
        var text = el('div', 'hl-feat-text', cleanText(h.text));
        text.dir = 'auto';
        box.appendChild(text);
        var meta = el('div', 'hl-feat-meta');
        meta.appendChild(el('span', 'hl-feat-who', s.name));
        if (s.extra) meta.appendChild(el('span', '', s.extra));
        if (s.site) meta.appendChild(el('span', '', '· ' + s.site));
        if (h.url) meta.appendChild(el('span', 'hl-feat-go', '↗'));
        box.appendChild(meta);
        featured.replaceChildren(box);
      }

      var rows = [];
      items.forEach(function (h, i) {
        if (i === 0) return;
        var row = linkOrDiv(h, 'hl-row');
        row.appendChild(el('span', 'hl-row-q', '“'));
        var text = el('span', 'hl-row-text', cleanText(h.text));
        text.dir = 'auto';
        row.appendChild(text);
        var lead = el('span', 'wl-lead');
        lead.setAttribute('aria-hidden', 'true');
        row.appendChild(lead);
        row.appendChild(el('span', 'hl-row-who', source(h).short));
        rows.push(row);
        list.appendChild(row);
      });

      // `base` is what the open slot shows at rest: the newest highlight,
      // or whatever "shuf -n 1" last pulled in.
      var base = items[0];
      var active = -1;
      function show(i) {
        if (i === active) return;
        active = i;
        renderFeatured(i < 0 ? base : items[i], false);
        rows.forEach(function (r, j) { r.classList.toggle('is-active', j + 1 === i); });
      }
      renderFeatured(base, false);

      if (window.matchMedia('(hover: hover)').matches) {
        rows.forEach(function (r, j) {
          r.addEventListener('mouseenter', function () { show(j + 1); });
          r.addEventListener('focus', function () { show(j + 1); });
        });
        card.addEventListener('mouseleave', function () {
          if (!card.contains(document.activeElement)) show(-1);
        });
        card.addEventListener('focusout', function (e) {
          if (!card.contains(e.relatedTarget)) show(-1);
        });
      }

      btn.addEventListener('click', function () {
        var pool = highlights.filter(function (h) { return h !== base && items.indexOf(h) < 1; });
        if (!pool.length) return;
        base = pool[Math.floor(Math.random() * pool.length)];
        active = -1;
        rows.forEach(function (r) { r.classList.remove('is-active'); });
        renderFeatured(base, true);
      });
    })();
  </script>

  <script is:inline>
    // ── Vibe Coding + Life Cards ──
    (function() {
      var data = window.__LOCAL_DATA__;
      if (!data) return;

      var el = function(id) { return document.getElementById(id); };

      function fmtTokens(n) {
        if (n >= 1e9) return (n / 1e9).toFixed(1) + 'B';
        if (n >= 1e6) return (n / 1e6).toFixed(0) + 'M';
        if (n >= 1e3) return (n / 1e3).toFixed(0) + 'K';
        return String(n);
      }

      function fmtNum(n) {
        return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }

      var MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function money(n) { return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
      function ymd(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
      // One floating tooltip for the barcode, the model lanes and the mood stripes.
      var tipEl = null;
      function bindTips(root) {
        root.querySelectorAll('[data-tip]').forEach(function(node) {
          node.addEventListener('mousemove', function(e) {
            if (!tipEl) { tipEl = document.createElement('div'); tipEl.className = 'hm-tip'; document.body.appendChild(tipEl); }
            tipEl.textContent = node.getAttribute('data-tip');
            tipEl.style.left = (e.clientX + 12) + 'px';
            tipEl.style.top = (e.clientY - 30) + 'px';
            tipEl.classList.add('on');
          });
          node.addEventListener('mouseleave', function() { if (tipEl) tipEl.classList.remove('on'); });
        });
      }
      // Run a card's entrance once it scrolls into view (skipped with reduced motion).
      function onView(node, fn) {
        if (!node || !('IntersectionObserver' in window)) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var io = new IntersectionObserver(function(es) { if (es[0].isIntersecting) { fn(); io.disconnect(); } }, { threshold: 0.3 });
        io.observe(node);
      }

      // ── Vibe Coding: ccusage printed as a receipt ──
      var vc = data.vibeCoding;
      if (vc && vc.daily && Object.keys(vc.daily).length) {
        var daily = vc.daily;
        var days = Object.keys(daily).sort();
        var first = new Date(days[0] + 'T00:00:00'), last = new Date(days[days.length - 1] + 'T00:00:00');
        var span = Math.round((last - first) / 864e5) + 1;
        // Every calendar day, used or not: unused days are gaps in the barcode and the lanes.
        var cal = [];
        for (var ci = 0; ci < span; ci++) {
          var cd = new Date(first); cd.setDate(cd.getDate() + ci);
          cal.push({ k: ymd(cd), d: cd, v: daily[ymd(cd)] });
        }
        var months = {};
        days.forEach(function(k) {
          var m = k.slice(0, 7);
          months[m] = months[m] || { cost: 0, days: 0 };
          months[m].cost += daily[k].cost; months[m].days++;
        });
        var mk = Object.keys(months).sort();
        var maxMonth = Math.max.apply(null, mk.map(function(m) { return months[m].cost; }));
        var busiest = days.reduce(function(a, b) { return daily[b].cost > daily[a].cost ? b : a; });

        el('vcSince').textContent = days[0];
        el('vcSpan').textContent = span;

        var r = '<div class="rc-c rc-shop">VIBE CODING CO.</div>' +
          '<div class="rc-c rc-dim">ursb.me · Singapore</div>' +
          '<div class="rc-c rc-dim">' + days[0].replace(/-/g, '.') + ' → ' + days[days.length - 1].replace(/-/g, '.') + '</div><hr>' +
          '<div class="rc-ln rc-dim"><span>ITEM</span><span class="rc-sp"></span><span>QTY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;AMOUNT</span></div>';
        mk.forEach(function(m) {
          var o = months[m];
          r += '<div class="rc-ln"><span>' + MON[+m.slice(5) - 1].toUpperCase() + ' ' + m.slice(0, 4) + '</span><span class="rc-dots"></span>' +
            '<span>' + o.days + 'd ' + money(o.cost).padStart(11, '\u00a0') + '</span></div>' +
            '<div class="rc-bar" style="width:' + (o.cost / maxMonth * 100).toFixed(1) + '%"></div>';
        });
        r += '<hr>' +
          '<div class="rc-ln"><span>TOKENS</span><span class="rc-dots"></span><span>' + fmtTokens(vc.totalTokens) + '</span></div>' +
          '<div class="rc-ln"><span>ACTIVE DAYS</span><span class="rc-dots"></span><span>' + days.length + ' / ' + span + '</span></div>' +
          '<div class="rc-ln"><span>AVG / WEEK</span><span class="rc-dots"></span><span>' + money(vc.avgWeekCost) + '</span></div>' +
          '<div class="rc-ln"><span>BUSIEST ' + busiest.slice(5).replace('-', '/') + '</span><span class="rc-dots"></span><span>' + money(daily[busiest].cost) + '</span></div>' +
          '<hr class="rc-dbl">' +
          '<div class="rc-ln rc-total"><span>TOTAL</span><span class="rc-sp"></span><span>' + money(vc.totalCost) + '</span></div>' +
          '<div class="rc-ln rc-dim"><span>PAID WITH</span><span class="rc-sp"></span><span>MAX PLAN</span></div>' +
          '<div class="rc-stamp">PAID</div>';
        // Barcode: one bar per day, thicker the more it cost; unused days are gaps.
        var maxDay = daily[busiest].cost, bc = '';
        cal.forEach(function(c) {
          if (!c.v) { bc += '<i class="gap"></i>'; return; }
          bc += '<i style="flex:' + (0.6 + 3.4 * Math.sqrt(c.v.cost / maxDay)).toFixed(2) + '" data-tip="' + c.k + ' · ' + money(c.v.cost) + '"></i>';
        });
        r += '<div class="rc-barcode">' + bc + '</div>' +
          '<div class="rc-bc-cap"><span>' + days[0].slice(5).replace('-', '') + '</span><span>1 bar = 1 day</span><span>' + days[days.length - 1].slice(5).replace('-', '') + '</span></div>' +
          '<div class="rc-c rc-dim rc-thanks">THANK YOU · KEEP SHIPPING</div>';
        el('vcReceipt').innerHTML = r;

        // Model lanes, ordered by first use, so the switches between models show.
        var colorByName = {};
        (vc.models || []).forEach(function(m) { colorByName[m.name] = m.color; });
        var FAMILY = { fable: '#c084fc', opus: '#8b5cf6', sonnet: '#f59e0b', haiku: '#10b981', gpt: '#22c55e' };
        function modelName(id) {
          var parts = id.replace(/^claude-/, '').split('-'), out = [];
          parts.forEach(function(p) {
            var prev = out[out.length - 1];
            if (/^\d+$/.test(p) && prev && /^\d+$/.test(prev)) out[out.length - 1] = prev + '.' + p;
            else out.push(p === 'gpt' ? 'GPT' : p.charAt(0).toUpperCase() + p.slice(1));
          });
          return out.join(' ');
        }
        var lanes = {};
        cal.forEach(function(c, i) {
          if (!c.v) return;
          (c.v.models || []).forEach(function(id) {
            if (!/^[a-z][a-z0-9.-]*-\d/.test(id)) return;   // skips "(未识别)", "probe", "claude 4 sonnet"
            var n = modelName(id);
            lanes[n] = lanes[n] || { first: i, on: {}, fam: id.replace(/^claude-/, '').split('-')[0] };
            lanes[n].on[i] = 1;
          });
        });
        var names = Object.keys(lanes).filter(function(n) { return Object.keys(lanes[n].on).length >= 2; })
          .sort(function(a, b) { return lanes[a].first - lanes[b].first; });
        var lh = '';
        names.forEach(function(n) {
          var L = lanes[n], cells = '';
          for (var i = 0; i < span; i++) cells += L.on[i] ? '<i class="on" data-tip="' + n + ' · ' + cal[i].k + '"></i>' : '<i></i>';
          lh += '<div class="vc-lane" style="--m:' + (colorByName[n] || FAMILY[L.fam] || '#64748b') + '"><span class="vc-lane-nm">' + esc(n) + '</span>' +
            '<span class="vc-lane-tr">' + cells + '</span><span class="vc-lane-d">' + Object.keys(L.on).length + 'd</span></div>';
        });
        var ticks = '';
        cal.forEach(function(c, i) { if (i === 0 || c.d.getDate() === 1) ticks += '<span style="left:' + (i / span * 100).toFixed(2) + '%">' + MON[c.d.getMonth()] + '</span>'; });
        lh += '<div class="vc-axis"><span></span><span class="vc-axis-ticks">' + ticks + '</span><span></span></div>';
        el('vcLanes').innerHTML = lh;
        if (names.length) {
          var most = names.slice().sort(function(a, b) { return Object.keys(lanes[b].on).length - Object.keys(lanes[a].on).length; })[0];
          el('vcNote').innerHTML = names.length + ' models · most used <b>' + esc(most) + '</b> (' + Object.keys(lanes[most].on).length + 'd) · newest <b>' + esc(names[names.length - 1]) + '</b>';
        }
        bindTips(el('vibe-coding'));
        var printer = el('vcPrinter');
        onView(printer, function() { printer.classList.add('printing'); });
      }

      // ── Mood: today's mood as a wttr.in report ──
      var mood = data.mood;
      if (mood && mood.recentMoods && mood.recentMoods.length) {
        var moods = mood.recentMoods;   // newest first, one entry per day
        var VAL = { rad: 5, good: 4, meh: 3, bad: 2, awful: 1 };
        var WX = {
          rad:   ['<span class="y">    \\   /    </span>', '<span class="y">     .-.     </span>', '<span class="y">  ― (   ) ―  </span>', '<span class="y">     `-’     </span>', '<span class="y">    /   \\    </span>'],
          good:  ['<span class="y">   \\  /</span>      ', '<span class="y"> _ /""</span><span class="c">.-.    </span>', '<span class="y">   \\_</span><span class="c">(   ).  </span>', '<span class="y">   /</span><span class="c">(___(__) </span>', '             '],
          meh:   ['             ', '<span class="c">     .--.    </span>', '<span class="c">  .-(    ).  </span>', '<span class="c"> (___.__)__) </span>', '             '],
          bad:   ['<span class="c">     .-.     </span>', '<span class="c">    (   ).   </span>', '<span class="c">   (___(__)  </span>', '<span class="r">    ‘ ‘ ‘ ‘  </span>', '<span class="r">   ‘ ‘ ‘ ‘   </span>'],
          awful: ['<span class="c">     .-.     </span>', '<span class="c">    (   ).   </span>', '<span class="c">   (___(__)  </span>', '<span class="r">  ‚‘</span><span class="z">⚡</span><span class="r">‘‚</span><span class="z">⚡</span><span class="r">‚‘ </span>', '<span class="r">  ‚’‚’</span><span class="z">⚡</span><span class="r">’‚’  </span>']
        };
        var COND = { rad: 'wx_sunny', good: 'wx_partly', meh: 'wx_overcast', bad: 'wx_rain', awful: 'wx_storm' };
        var COND_EN = { rad: 'Sunny', good: 'Partly cloudy', meh: 'Overcast', bad: 'Light rain', awful: 'Thunderstorm' };
        var COLOR = { rad: '#fbbf24', good: 'var(--accent)', meh: 'rgba(var(--c-overlay-rgb),0.16)', bad: '#f472b6', awful: '#ef4444' };
        var TEXT = { rad: '#fbbf24', good: 'var(--accent)', meh: '#38bdf8', bad: '#f472b6', awful: '#ef4444' };
        var ICON = {
          rad:   '<circle cx="11" cy="9" r="4" fill="#fbbf24"/><g stroke="#fbbf24" stroke-width="1.4" stroke-linecap="round"><path d="M11 1.5v2M11 14.5v2M3.5 9h2M16.5 9h2M5.7 3.7l1.4 1.4M14.9 12.9l1.4 1.4M5.7 14.3l1.4-1.4M14.9 5.1l1.4-1.4"/></g>',
          good:  '<circle cx="8" cy="7" r="3.6" fill="#fbbf24"/><path d="M7 15.5h10a3 3 0 0 0 0-6 4.3 4.3 0 0 0-8.2.9A2.6 2.6 0 0 0 7 15.5z" fill="var(--c-text-muted)"/>',
          meh:   '<path d="M5 15h12a3.4 3.4 0 0 0 0-6.8 5 5 0 0 0-9.6 1A2.9 2.9 0 0 0 5 15z" fill="var(--c-text-muted)"/>',
          bad:   '<path d="M5 11.5h12a3.2 3.2 0 0 0 0-6.4 4.8 4.8 0 0 0-9.2.9A2.8 2.8 0 0 0 5 11.5z" fill="var(--c-text-muted)"/><g stroke="#38bdf8" stroke-width="1.4" stroke-linecap="round"><path d="M7.5 13.5l-1 2.5M11.5 13.5l-1 2.5M15.5 13.5l-1 2.5"/></g>',
          awful: '<path d="M5 11h12a3.2 3.2 0 0 0 0-6.4 4.8 4.8 0 0 0-9.2.9A2.8 2.8 0 0 0 5 11z" fill="var(--c-text-muted)"/><path d="M11.5 11l-2.5 3.6h2.4L10 18l3.6-4.6h-2.4l1.4-2.4z" fill="#fbbf24"/><path d="M6.5 13l-1 2.4M16 13l-1 2.4" stroke="#38bdf8" stroke-width="1.4" stroke-linecap="round"/>'
        };
        // Dates count back from the day the data was synced, not from today.
        var anchor = new Date(((data.updatedAt || '').slice(0, 10) || ymd(new Date())) + 'T12:00:00');
        function dayOf(i) { var d = new Date(anchor); d.setDate(d.getDate() - i); return d; }
        function md(d) { return MON[d.getMonth()] + ' ' + d.getDate(); }
        function avg(list) { return list.reduce(function(s, m) { return s + (VAL[m] || 3); }, 0) / Math.max(list.length, 1); }
        var now = moods[0];
        var avg7 = avg(moods.slice(0, 7)), delta = avg7 - avg(moods.slice(7, 14));

        el('wxEntries').textContent = fmtNum(mood.totalEntries || moods.length);
        el('wxDate').textContent = ymd(anchor);
        el('wxArt').innerHTML = (WX[now] || WX.meh).join('\n');
        el('wxRead').innerHTML =
          '<div class="wx-cond"><span data-i18n="' + COND[now] + '">' + COND_EN[now] + '</span><em style="color:' + TEXT[now] + '" data-i18n="mood_' + now + '">' + now + '</em></div>' +
          '<div><b>' + VAL[now] + '°</b> <span class="wx-dim">· <span data-i18n="mood_avg7">7-day avg</span></span> ' + avg7.toFixed(1) + '° ' + (delta >= 0 ? '↑' : '↓') + Math.abs(delta).toFixed(1) + '</div>' +
          ((mood.recentActivities || []).length ? '<div class="wx-ell">↗ ' + esc(mood.recentActivities.slice(0, 3).join(' · ')) + '</div>' : '') +
          (mood.since ? '<div class="wx-dim"><span data-i18n="mood_since_lc">since</span> ' + esc(mood.since) + '</div>' : '');

        var fc = '';
        for (var fi = Math.min(6, moods.length - 1); fi >= 0; fi--) {
          var fd = dayOf(fi), fm = moods[fi];
          fc += '<div class="wx-day' + (fi === 0 ? ' today' : '') + '" data-tip="' + md(fd) + ' · ' + fm + '">' +
            '<span class="wx-dn" data-i18n="' + (fi === 0 ? 'wd_today' : 'wd_' + fd.getDay()) + '">' + (fi === 0 ? 'today' : ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][fd.getDay()]) + '</span>' +
            '<svg viewBox="0 0 22 18" aria-hidden="true">' + (ICON[fm] || ICON.meh) + '</svg><span class="wx-deg">' + (VAL[fm] || 3) + '°</span></div>';
        }
        el('wxFc').innerHTML = fc;

        var st = '';
        for (var si = moods.length - 1; si >= 0; si--) st += '<i style="background:' + (COLOR[moods[si]] || COLOR.meh) + '" data-tip="' + md(dayOf(si)) + ' · ' + moods[si] + '"></i>';
        el('wxStripes').innerHTML = st;
        el('wxN').textContent = moods.length;
        el('wxFrom').textContent = md(dayOf(moods.length - 1));
        el('wxTo').textContent = md(anchor);
        bindTips(el('mood'));
      }

      // ── Activity: Apple Health as an htop snapshot ──
      // Ring goals match the old rings card: 1500 kJ move, 30 min exercise,
      // 12 h stand. Sleep is shown as a share of the 24-hour day.
      var health = data.health;
      if (health) {
        var GOAL = { move: 1500, exercise: 30, stand: 12 };
        var asOf = new Date(health.date + 'T00:00:00');
        var age = Math.max(0, Math.floor((Date.now() - asOf.getTime()) / 864e5));
        var pct = function(v, g) { return Math.round(v / g * 100) + '%'; };
        // A meter is htop's [||||    value] bar; the bars are clipped to the fill.
        var meter = function(k, frac, val, cls, tip) {
          var f = Math.max(0, Math.min(1, frac));
          return '<div class="ht-m" data-tip="' + esc(tip) + '"><span class="k">' + k + '</span><span class="br">[</span>' +
            '<span class="bar"><span class="trk"><span class="fill ' + cls + '" style="width:' + (f * 100).toFixed(1) + '%">' + new Array(200).join('|') + '</span></span>' +
            '<span class="val">' + val + '</span></span><span class="br">]</span></div>';
        };
        // Heart and lungs never stop (R); sleep and legs wait (S); a day with
        // no exercise leaves the exercise process a zombie (Z).
        var procs = [
          { pid: 1, user: 'root', s: 'R', v: health.restingHR + ' bpm', cmd: 'heart', arg: '--resting', t: 'resting heart rate' },
          { pid: 2, user: 'root', s: 'R', v: health.spo2 + ' %', cmd: 'lungs', arg: '--spo2', t: 'blood oxygen saturation' },
          { pid: 3, user: 'airing', s: 'S', v: health.sleep + ' h', cmd: 'sleep', arg: '--last-night', t: 'sleep duration' },
          { pid: 4, user: 'airing', s: 'S', v: fmtNum(health.steps), cmd: 'legs', arg: '--steps', t: 'step count' },
          { pid: 5, user: 'airing', s: health.exerciseMin > 0 ? 'S' : 'Z', v: health.exerciseMin + ' min', cmd: 'exercise', arg: health.exerciseMin > 0 ? '' : '<defunct>', t: 'exercise minutes · goal ' + GOAL.exercise }
        ];
        var running = procs.filter(function(p) { return p.s === 'R'; }).length;
        var zombies = procs.filter(function(p) { return p.s === 'Z'; }).length;
        var h = meter('Move', health.activeEnergy / GOAL.move, health.activeEnergy + '/' + GOAL.move + 'kJ', 'mv', 'move ring · ' + pct(health.activeEnergy, GOAL.move)) +
          meter('Exer', health.exerciseMin / GOAL.exercise, health.exerciseMin + '/' + GOAL.exercise + 'min', 'ex', 'exercise ring · ' + pct(health.exerciseMin, GOAL.exercise)) +
          meter('Stand', health.standHours / GOAL.stand, health.standHours + '/' + GOAL.stand + 'h', 'st', 'stand ring · ' + pct(health.standHours, GOAL.stand)) +
          meter('Sleep', health.sleep / 24, health.sleep + '/24h', 'sl', 'sleep · ' + pct(health.sleep, 24) + ' of the day');
        h += '<div class="ht-info">' +
          '<div><span class="c">Tasks:</span> <b>' + procs.length + '</b>, <b>' + running + '</b> running' + (zombies ? ', <b class="z">' + zombies + '</b> zombie' : '') + '</div>' +
          '<div><span class="c">Load average:</span> <b>' + health.restingHR + '</b> bpm <span class="dim">resting</span></div>' +
          '<div><span class="c">Snapshot:</span> <b>' + esc(health.date) + '</b> <span class="z">(' + age + 'd ago)</span></div></div>';
        h += '<div class="ht-tb"><div class="ht-row hd"><span class="pid">PID</span><span>USER</span><span>S</span><span class="v">VALUE</span><span>Command</span></div>';
        procs.forEach(function(p, i) {
          h += '<div class="ht-row' + (i === 0 ? ' sel' : '') + '" data-tip="' + esc(p.t + ' · ' + p.v + ' · ' + health.date) + '">' +
            '<span class="pid">' + p.pid + '</span><span>' + p.user + '</span><span class="s ' + p.s + '">' + p.s + '</span>' +
            '<span class="v">' + p.v + '</span><span class="cmd"><b>' + p.cmd + '</b> <i>' + esc(p.arg) + '</i></span></div>';
        });
        h += '</div>';
        // The function-key bar is decoration, as in htop.
        h += '<div class="ht-fk" aria-hidden="true">' + [['F1', 'Help'], ['F3', 'Search'], ['F5', 'Tree'], ['F6', 'SortBy'], ['F10', 'Quit']].map(function(k) {
          return '<span><b>' + k[0] + '</b><em>' + k[1] + '</em></span>';
        }).join('') + '</div>';
        var ht = el('actHtop');
        ht.innerHTML = h;
        // The cyan selection bar follows the pointer, like moving through htop.
        var rows = ht.querySelectorAll('.ht-row:not(.hd)');
        rows.forEach(function(r) {
          r.addEventListener('mouseenter', function() { rows.forEach(function(x) { x.classList.toggle('sel', x === r); }); });
        });
        bindTips(ht);
        el('actDate').textContent = health.date;
        el('actGoalMove').textContent = GOAL.move;
        el('actGoalEx').textContent = GOAL.exercise;
        el('actGoalStand').textContent = GOAL.stand;
      }
    })();
  </script>

  <!-- Online presence (site-wide, tiered + i18n) -->
