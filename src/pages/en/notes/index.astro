---
/**
 * Notes index (en) — "Field Notes" catalogue. Layout and behaviour live in
 * src/components/notes/NotesIndex.astro (shared with /notes/).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotesIndex from '../../../components/notes/NotesIndex.astro';
import { tSite } from '../../../lib/i18n';

const s = tSite('en').notes;
const hreflang = {
  zh: new URL('/notes/', Astro.site).href,
  en: new URL('/en/notes/', Astro.site).href,
};
---

<BaseLayout title={`${s.siteTitle} | Airing`} description="Airing's notes on frontend engineering, mathematics, design, philosophy, and other curiosities, including interactive technical deep dives." lang="en" hreflang={hreflang}>
  <NotesIndex lang="en" />

  <script is:inline>
    if (localStorage.getItem('preferred_lang') === 'zh') {
      window.location.replace('/notes');
    }
  </script>
</BaseLayout>
