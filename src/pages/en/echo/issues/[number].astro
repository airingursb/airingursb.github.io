---
import IssueView from "../../../../features/echo/components/IssueView.astro";
import { issuesFor } from "../../../../features/echo/data/issues";
export function getStaticPaths() {
  return issuesFor('en').map(issue => ({ params: { number: issue.number }, props: { issue } }));
}
const { issue } = Astro.props;
---
<IssueView issue={issue} />
