---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LangSwitch from '../../../components/LangSwitch.astro';
import ReadingCard from '../../../components/reading/ReadingCard.astro';
import { fetchReadingItems, readingMonth, readingSourceLabel } from '../../../lib/reading';
import '../../../styles/reading.css';

const items = await fetchReadingItems();
const sourceCounts = new Map<string, number>();
const monthCounts = new Map<string, number>();
for (const item of items) {
  sourceCounts.set(item.source, (sourceCounts.get(item.source) ?? 0) + 1);
  const month = readingMonth(item.saved_at);
  monthCounts.set(month, (monthCounts.get(month) ?? 0) + 1);
}
const sources = [...sourceCounts.entries()].sort((a, b) => b[1] - a[1]);
const months = [...monthCounts.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const latest = items[0]?.updated_at || items[0]?.saved_at;
const latestLabel = latest
  ? new Date(latest).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai' })
  : '—';
---

<BaseLayout
  title="Reading Stream · Airing's Blog"
  description="Things I read and chose to keep. Follow Airing's Reading Stream on the web, by RSS, or in a weekly email."
  lang="en"
  hreflang={{ zh: '/reading/', en: '/en/reading/' }}
>
  <div class="reading-page">
    <header class="reading-shell">
      <div class="reading-mast-top"></div>
      <div class="reading-mast-bar">
        <a class="reading-brand" href="/en/blog/">Airing's Blog</a>
        <nav class="reading-nav" aria-label="Blog navigation">
          <a href="/en/blog/">Blog</a>
          <a href="/en/moments/">Moment</a>
          <a href="/en/notes/">Notes</a>
          <a class="active" href="/en/reading/" aria-current="page">Reading</a>
          <a href="/photos/">Photos</a>
          <a href="/en/friends/">Friends</a>
        </nav>
      </div>
      <div class="reading-subbar">
        <span>ursb.me / reading</span>
        <LangSwitch lang="en" currentPath="/en/reading/" />
      </div>
    </header>

    <main class="reading-shell">
      <section class="reading-hero">
        <div>
          <div class="reading-eyebrow">Curated daily</div>
          <h1 class="reading-title">Reading Stream</h1>
          <p class="reading-desc">Things I read and chose to keep, collected from X, GitHub, newsletters, and the open web.</p>
        </div>
        <div class="reading-hero-actions">
          <div class="reading-updated"><span data-visible-count>{items.length}</span> items<br />updated {latestLabel}</div>
          <button class="reading-rss" type="button" data-subscribe-open data-subscribe-context="reading">
            Subscribe
          </button>
        </div>
      </section>

      <div class="reading-content">
        <aside class="reading-sidebar" aria-label="Reading Stream filters">
          <section class="reading-side-section" data-filter-group="source">
            <div class="reading-side-title">Source</div>
            <button class="reading-filter active" type="button" data-filter="all">
              <span>All</span><span class="reading-filter-count">{items.length}</span>
            </button>
            {sources.map(([source, count]) => (
              <button class="reading-filter" type="button" data-filter={source}>
                <span>{readingSourceLabel(source, 'en')}</span><span class="reading-filter-count">{count}</span>
              </button>
            ))}
          </section>

          <section class="reading-side-section" data-filter-group="month">
            <div class="reading-side-title">Archive</div>
            <button class="reading-filter active" type="button" data-filter="all">
              <span>All months</span>
            </button>
            {months.map(([month, count]) => (
              <button class="reading-filter" type="button" data-filter={month}>
                <span>{month}</span><span class="reading-filter-count">{count}</span>
              </button>
            ))}
          </section>

          <section class="reading-side-section weekly" id="weekly">
            <div class="reading-side-title">Weekly letter</div>
            <p class="reading-weekly-copy">One email connecting the reads worth revisiting from the past week.</p>
            <button class="reading-weekly-open" type="button" data-subscribe-open data-subscribe-context="reading">
              Manage subscriptions →
            </button>
          </section>
        </aside>

        <section>
          <div class="reading-stream-head">
            <span class="reading-stream-label">Latest reads</span>
            <span class="reading-stream-range">Newest saved first</span>
          </div>

          {items.length > 0 ? (
            <>
              <div class="reading-grid" data-reading-grid>
                {items.map((item, index) => <ReadingCard item={item} lang="en" eager={index < 3} />)}
              </div>
              <p class="reading-empty" data-reading-empty hidden>No items match these filters.</p>
            </>
          ) : (
            <p class="reading-empty">No public reading notes yet.</p>
          )}

          <section class="reading-side-section weekly reading-weekly-mobile" id="weekly-mobile">
            <div class="reading-side-title">Weekly letter</div>
            <p class="reading-weekly-copy">One email connecting the reads worth revisiting from the past week.</p>
            <button class="reading-weekly-open" type="button" data-subscribe-open data-subscribe-context="reading">
              Manage subscriptions →
            </button>
          </section>
        </section>
      </div>
    </main>

    <footer class="reading-shell reading-footer">© 2026 Airing · Reading Stream</footer>
  </div>

  <script>
    const filters = { source: 'all', month: 'all' };
    const cards = Array.from(document.querySelectorAll('[data-reading-card]'));
    const count = document.querySelector('[data-visible-count]');
    const empty = document.querySelector('[data-reading-empty]');

    function applyFilters() {
      let visible = 0;
      cards.forEach((card) => {
        const matchesSource = filters.source === 'all' || card.getAttribute('data-source') === filters.source;
        const matchesMonth = filters.month === 'all' || card.getAttribute('data-month') === filters.month;
        card.toggleAttribute('hidden', !(matchesSource && matchesMonth));
        if (matchesSource && matchesMonth) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.toggleAttribute('hidden', visible !== 0);
    }

    document.querySelectorAll('[data-filter-group]').forEach((group) => {
      group.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest('[data-filter]');
        if (!button) return;
        const type = group.getAttribute('data-filter-group');
        if (type !== 'source' && type !== 'month') return;
        filters[type] = button.getAttribute('data-filter') || 'all';
        group.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('active', item === button));
        applyFilters();
      });
    });
  </script>
</BaseLayout>
