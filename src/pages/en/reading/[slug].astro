---
import SiteHeader from "../../../components/SiteHeader.astro";
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReadingShareModal from '../../../components/reading/ReadingShareModal.astro';
import {
  fetchReadingItems,
  localizeReadingItem,
  readingDate,
  readingSourceLabel,
  readingTypeLabel,
  type ReadingItem,
} from '../../../lib/reading';
import '../../../styles/reading.css';
import '../../../styles/photos.css';

export async function getStaticPaths() {
  const items = await fetchReadingItems();
  return items.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      item,
      newer: items[index - 1] ?? null,
      older: items[index + 1] ?? null,
    },
  }));
}

interface Props {
  item: ReadingItem;
  newer: ReadingItem | null;
  older: ReadingItem | null;
}

const props = Astro.props;
const item = localizeReadingItem(props.item, 'en');
const newer = props.newer ? localizeReadingItem(props.newer, 'en') : null;
const older = props.older ? localizeReadingItem(props.older, 'en') : null;
const description = item.summary || `${item.author ? `${item.author} · ` : ''}${item.source} reading note`;
const summaryLines = (item.summary || '').split('\n').map((line) => line.trim()).filter(Boolean);
const summaryIsList = summaryLines.length > 1 && summaryLines.every((line) => /^[-*]\s+/.test(line));
const shareUrl = new URL(`/en/reading/${item.slug}/`, Astro.site ?? 'https://ursb.me').href;
---

<BaseLayout
  title={`${item.title} · Reading Stream`}
  description={description}
  ogImage={item.cover_url}
  ogType="article"
  lang="en"
  hreflang={{ zh: `/reading/${item.slug}/`, en: `/en/reading/${item.slug}/` }}
>
  <div class="reading-page">
    <SiteHeader lang="en" />

    <main class="reading-shell">
      <header class="reading-detail-head">
        <div>
          <div class="reading-eyebrow">Reading note · {item.source}</div>
          <h1>{item.title}</h1>
          <div class="reading-detail-byline">
            {item.author && <span>{item.author}</span>}
            <span class="reading-source">{readingSourceLabel(item.source, 'en')}</span>
            <span>Saved {readingDate(item.saved_at, 'en-US')}</span>
          </div>
        </div>
        <div class="reading-detail-actions">
          <ReadingShareModal coverUrl={item.cover_url} lang="en" shareTitle={item.title} shareUrl={shareUrl} />
          {item.original_url && (
            <a class="reading-action primary" href={item.original_url} target="_blank" rel="noopener noreferrer" data-umami-event="reading-source-open" data-umami-event-slug={item.slug} data-umami-event-source={item.source} data-umami-event-surface="detail-header" data-umami-event-lang="en">
              Read source ↗
            </a>
          )}
        </div>
      </header>

      <article class="reading-detail-grid">
        <div>
          <button class="reading-poster" type="button" data-open-lightbox aria-label="View full image" data-umami-event="reading-original-open" data-umami-event-slug={item.slug} data-umami-event-lang="en">
            <Image
              src={item.cover_url}
              alt={item.title}
              width={1440}
              height={960}
              widths={[720, 1440]}
              sizes="(max-width: 720px) 100vw, (max-width: 1080px) calc(100vw - 64px), 883px"
              format="webp"
              quality={75}
              priority
            />
            <span class="reading-zoom-label">⌕ View full image</span>
          </button>
          <div class="reading-caption">
            <span>Agent-generated reading card · 1536 × 1024</span>
          </div>
        </div>

        <aside class="reading-detail-side">
          {item.summary && (
            <section>
              <h2>Key takeaways</h2>
              {summaryIsList ? (
                <ul class="reading-summary-list">
                  {summaryLines.map((line) => <li>{line.replace(/^[-*]\s+/, '')}</li>)}
                </ul>
              ) : (
                <p class="reading-summary">{item.summary}</p>
              )}
            </section>
          )}
          <section>
            <h2>Details</h2>
            <dl class="reading-facts">
              {item.author && <div><dt>Author</dt><dd>{item.author}</dd></div>}
              <div><dt>Source</dt><dd>{readingSourceLabel(item.source, 'en')}{item.item_type ? ` · ${readingTypeLabel(item.item_type, 'en')}` : ''}</dd></div>
              {item.original_published_at && <div><dt>Published</dt><dd>{readingDate(item.original_published_at, 'en-US')}</dd></div>}
              <div><dt>Saved</dt><dd>{readingDate(item.saved_at, 'en-US')}</dd></div>
            </dl>
          </section>
          {(item.topics.length > 0 || item.original_url) && (
            <section>
              {item.topics.length > 0 && (
                <>
                  <h2>Topics</h2>
                  <div class="reading-topics">
                    {item.topics.map((topic) => <span class="reading-topic">{topic}</span>)}
                  </div>
                </>
              )}
              {item.original_url && (
                <a class="reading-action primary" style="width:100%;margin-top:18px" href={item.original_url} target="_blank" rel="noopener noreferrer" data-umami-event="reading-source-open" data-umami-event-slug={item.slug} data-umami-event-source={item.source} data-umami-event-surface="detail-sidebar" data-umami-event-lang="en">
                  Open original ↗
                </a>
              )}
            </section>
          )}
        </aside>
      </article>

      {(newer || older) && (
        <nav class="reading-prev-next" aria-label="Adjacent reading notes">
          {newer ? (
            <a class="reading-related" href={`/en/reading/${newer.slug}/`} data-umami-event="reading-card-open" data-umami-event-slug={newer.slug} data-umami-event-source={newer.source} data-umami-event-surface="detail-related" data-umami-event-direction="newer" data-umami-event-lang="en">
              <Image src={newer.cover_url} alt="" loading="lazy" width={360} height={240} format="webp" quality={75} />
              <span><small>← Newer</small><strong>{newer.title}</strong></span>
            </a>
          ) : <span />}
          {older && (
            <a class="reading-related" href={`/en/reading/${older.slug}/`} data-umami-event="reading-card-open" data-umami-event-slug={older.slug} data-umami-event-source={older.source} data-umami-event-surface="detail-related" data-umami-event-direction="older" data-umami-event-lang="en">
              <Image src={older.cover_url} alt="" loading="lazy" width={360} height={240} format="webp" quality={75} />
              <span><small>Older →</small><strong>{older.title}</strong></span>
            </a>
          )}
        </nav>
      )}
    </main>
  </div>

  <div class="reading-lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Full reading card">
    <button class="reading-lightbox-close" type="button" data-close-lightbox aria-label="Close">×</button>
    <img data-original-src={item.cover_url} alt={item.title} />
  </div>

  <script>
    const lightbox = document.querySelector('[data-lightbox]');
    const lightboxImage = lightbox?.querySelector('img[data-original-src]');
    const closeLightbox = () => lightbox?.classList.remove('open');
    document.querySelector('[data-open-lightbox]')?.addEventListener('click', () => {
      if (lightboxImage instanceof HTMLImageElement && !lightboxImage.src) {
        lightboxImage.src = lightboxImage.dataset.originalSrc || '';
      }
      lightbox?.classList.add('open');
    });
    document.querySelector('[data-close-lightbox]')?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeLightbox();
    });
  </script>
</BaseLayout>
