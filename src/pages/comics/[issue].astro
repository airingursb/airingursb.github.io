---
// /comics/[issue].astro
import ComicIssuePage from '../../components/comics/ComicIssuePage.astro';
import { fetchComics } from '../../lib/comics';

export async function getStaticPaths() {
  const comics = await fetchComics();
  return comics.map((c, i) => ({
    params: { issue: String(c.issue_number) },
    props: {
      comic: c,
      prev: comics[i + 1] || null,
      next: comics[i - 1] || null,
      allComics: comics,
    },
  }));
}

const { comic, prev, next, allComics } = Astro.props;
---

<ComicIssuePage comic={comic} prev={prev} next={next} allComics={allComics} lang="zh" />
