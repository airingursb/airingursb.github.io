---
import BaseLayout from '../layouts/BaseLayout.astro';
import MomentsArchive from '../components/moments/MomentsArchive.astro';
---
<BaseLayout title="Moments · 动态 | Airing" description="Airing 的日常动态：按时间翻阅碎片想法、阅读、旅行与生活记录。" lang="zh" persistentTheme={true} hreflang={{zh:'/moments/',en:'/en/moments/'}}>
  <MomentsArchive />
  <script is:inline>
    if(localStorage.getItem('preferred_lang')==='en')window.location.replace('/en/moments/');
  </script>
</BaseLayout>
