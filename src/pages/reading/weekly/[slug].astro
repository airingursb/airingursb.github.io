---
import ReadingWeeklyIssue from '../../../components/reading/ReadingWeeklyIssue.astro';
import { readingWeeklyIssues } from '../../../data/reading-weekly';

export function getStaticPaths() {
  return readingWeeklyIssues.map((issue) => ({ params: { slug: issue.slug }, props: { issue } }));
}

const { issue } = Astro.props;
---

<ReadingWeeklyIssue issue={issue} lang="zh" />
