---
import SiteHeader from "../../components/SiteHeader.astro";
import '../../styles/workouts.css';
import '../../styles/photos.css';   // for .share-modal/.share-card/.share-row CSS
import 'mapbox-gl/dist/mapbox-gl.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteStrings } from '../../lib/i18n';
import { getCollection, render } from 'astro:content';
import { existsSync, readFileSync } from 'node:fs';
import { resolve as resolvePath } from 'node:path';
import WorkoutHeader from '../../components/workouts/WorkoutHeader.astro';
import WorkoutDetail from '../../components/workouts/WorkoutDetail.tsx';
import WorkoutShareModal from '../../components/workouts/WorkoutShareModal.astro';
import { defaultWorkoutTitle } from '../../components/workouts/format.mjs';

export async function getStaticPaths() {
  const idxPath = resolvePath('./src/data/workouts.json');
  const pubIdxPath = resolvePath('./src/data/workouts-public.json');
  const idxFile = existsSync(idxPath) ? idxPath : (existsSync(pubIdxPath) ? pubIdxPath : null);
  if (!idxFile) return [];
  const items = JSON.parse(readFileSync(idxFile, 'utf8')) as Array<any>;
  return items.map((w) => ({ params: { id: w.id } }));
}

const { id } = Astro.params;
const localPath = resolvePath(`./src/data/workouts/${id}.json`);
const pubPath   = resolvePath(`./src/data/workouts-public/${id}.json`);
const detailPath = existsSync(localPath) ? localPath : (existsSync(pubPath) ? pubPath : null);
if (!detailPath) throw new Error(`Workout not found: ${id}`);
const detail = JSON.parse(readFileSync(detailPath, 'utf8'));

const contentEntries = await getCollection('workouts');
// Astro 5 lowercases content collection IDs; workout UUIDs are uppercase.
const contentEntry = contentEntries.find(e => e.id.toLowerCase() === id?.toLowerCase());
const titleZh = contentEntry?.data.title.zh ?? defaultWorkoutTitle(detail.start, detail.type, 'zh');
const Body = contentEntry?.body ? (await render(contentEntry)).Content : null;

const s = siteStrings.zh.workouts;
const shareUrl = new URL(`/workouts/${id}`, Astro.site ?? 'https://ursb.me').href;
const ogImage = detail?.og?.zh as string | undefined;
---

<BaseLayout
  title={`${titleZh} · ${s.title} · Airing`}
  description={contentEntry?.data.description?.zh ?? ''}
  ogImage={ogImage}
  lang="zh"
  hreflang={{ zh: `/workouts/${id}`, en: `/en/workouts/${id}` }}
>
  <div class="workout-detail-page">
    <SiteHeader lang="zh">
      <a href="/workouts/">{s.backToList}</a>
    </SiteHeader>

    <main style="padding: 24px 16px;">
      <article class="workout-card" style="position: relative;">
        <WorkoutShareModal ogImage={ogImage} shareUrl={shareUrl} shareTitle={titleZh} />
        <WorkoutHeader
          type={detail.type}
          distanceKm={detail.stats.distanceKm}
          durationSec={detail.durationSec}
          name={titleZh}
        />
        <WorkoutDetail workout={detail} client:visible />
      </article>

      {Body && (
        <section style="max-width: 760px; margin: 24px auto 0; padding: 0 4px;">
          <Body />
        </section>
      )}
    </main>
  </div>

  <style>
  </style>
  <style is:global>
    body:has(.workout-detail-page) { display: block; padding: 0; align-items: stretch; justify-content: stretch; }
  </style>
</BaseLayout>
