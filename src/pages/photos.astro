---
import SiteHeader from "../components/SiteHeader.astro";
import '../styles/photos.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteStrings } from '../lib/i18n';
import photosData from '../data/photos.json';

const s = siteStrings.en.photos;
const photos = photosData as Array<any>;
---

<BaseLayout
  title={`${s.title} · Airing`}
  description={s.desc}
  lang="en"
>
  <div class="photos-page">
    <SiteHeader lang="en" hasEnVersion={false} />


    <main class="photos-main">
      <h1 class="photos-title">{s.title}</h1>
      <p class="photos-desc">{s.desc}</p>

      <nav class="view-switcher" aria-label="Photo views">
        <span class="view-switcher-active">Grid</span>
        <a href="/photos/calendar">Calendar</a>
        <a href="/photos/albums">Albums</a>
        <a href="/photos/world">Map</a>
      </nav>

      {photos.length === 0 ? (
        <p class="photos-empty">{s.noPhotos}</p>
      ) : (
        <ul class="photos-grid">
          {photos.map((p) => (
            <li class="photo-card" style={`--dom: ${p.dominantColor}`}>
              <a href={`/photos/${p.slug}`} class="photo-link" aria-label={p.title || p.slug}>
                <picture>
                  <source
                    type="image/avif"
                    srcset={`${p.variants.thumb.avif} 400w, ${p.variants.medium.avif} 1200w`}
                    sizes="(max-width: 768px) 50vw, (max-width: 1280px) 33vw, 25vw"
                  />
                  <source
                    type="image/webp"
                    srcset={`${p.variants.thumb.webp} 400w, ${p.variants.medium.webp} 1200w`}
                    sizes="(max-width: 768px) 50vw, (max-width: 1280px) 33vw, 25vw"
                  />
                  <img
                    src={p.variants.medium.webp}
                    alt={p.title || p.slug}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
            </li>
          ))}
        </ul>
      )}
    </main>
  </div>

  <style>
    /* Nav — matches site convention exactly (moments.astro / blog.astro) */
    /* Mobile dropdown is provided globally — see global.css and BaseLayout.astro */

    .view-switcher {
      display: flex; gap: 1rem;
      margin: 0 0 1.5rem;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .view-switcher a {
      color: var(--c-text-dim);
      text-decoration: none;
    }
    .view-switcher a:hover { color: var(--c-text); }
    .view-switcher-active {
      color: var(--c-text);
      font-weight: 600;
    }
  </style>

  <style is:global>
    /* Reset global.css body flex+padding when this page is rendered */
    body:has(.photos-page) {
      display: block;
      padding: 0;
      align-items: stretch;
      justify-content: stretch;
    }
  </style>

  <script is:inline define:vars={{ currentView: 'grid' }}>
    document.addEventListener('click', function (e) {
      if (typeof umami === 'undefined') return;
      var t = e.target;
      if (!t || !t.closest) return;
      var a = t.closest('.view-switcher a');
      if (!a) return;
      umami.track('view-switch', { from: currentView, to: (a.textContent || '').trim().toLowerCase() });
    });
  </script>
</BaseLayout>
