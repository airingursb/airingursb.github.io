---
// src/components/SessionsCard.astro
//
// Homepage "Work Sessions" card, built from src/data/rize.json (refreshed
// daily by scripts/fetch-rize.mjs in the deploy workflow).
//
//   1. `time`-style readout of the last 365 days + yesterday's bar
//   2. a year of days (26 weeks on phones, so nothing scrolls sideways)
//   3. hours by month, split into five buckets · weekday × hour rhythm
//   4. a 24-hour dial of yesterday over the 60-day average · top apps
import rize from '../data/rize.json';

type Bucket = 'build' | 'talk' | 'write' | 'read' | 'off';
const BK: [Bucket, string, string][] = [
  ['build', 'sess_build', 'Coding'],
  ['talk', 'sess_talk', 'Comms'],
  ['write', 'sess_write', 'Writing'],
  ['read', 'sess_read', 'Research'],
  ['off', 'sess_off', 'Leisure'],
];
const M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const WD = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const TARGET = 8;

interface Day { d: string; w: number; mt: number; br: number; c: Record<Bucket, number> }
const days: Day[] = (rize.days as number[][] & string[][]).map((r: any[]) => ({
  d: r[0], w: r[1], mt: r[2], br: r[3],
  c: { build: r[4], talk: r[5], write: r[6], read: r[7], off: r[8] },
}));
const byD = new Map(days.map((x) => [x.d, x]));
const p2 = (n: number) => String(n).padStart(2, '0');
const hm = (h: number) => { const m = Math.round(h * 60); return `${Math.floor(m / 60)}h${p2(m % 60)}m`; };
const wdOf = (s: string) => (new Date(s + 'T00:00:00Z').getUTCDay() + 6) % 7;
const isoAdd = (s: string, n: number) => { const d = new Date(s + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };
const ctot = (c: Record<string, number>) => Object.values(c).reduce((a, b) => a + b, 0) || 1;

// Mid-day deploys would otherwise show a partial "today". Feature yesterday
// in Asia/Singapore (a complete day), even when it is 0h. Today's hours still
// roll into the 365-day and monthly totals.
const sgtToday = new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
const yesterday = isoAdd(sgtToday, -1);
const ti = days.findIndex((x) => x.d === yesterday);
const td = (ti >= 0 ? days[ti] : undefined) ?? { d: yesterday, w: 0, mt: 0, br: 0, c: { build: 0, talk: 0, write: 0, read: 0, off: 0 } };
const tdc = ctot(td.c);

// 365-day readout
const last = days.slice(-365);
const sum = { w: 0, br: 0 };
const cs: Record<Bucket, number> = { build: 0, talk: 0, write: 0, read: 0, off: 0 };
for (const x of last) { sum.w += x.w; sum.br += x.br; for (const [k] of BK) cs[k] += x.c[k]; }
const cT = ctot(cs);
const active = last.filter((x) => x.w >= 1);
const longest = last.reduce((a, b) => (b.w > a.w ? b : a), last[0] ?? td);
let streak = 0;
if (ti >= 0) {
  for (let i = ti; i >= 0 && days[i].w >= 1; i--) streak++;
}
const wk = ti >= 0 ? days.slice(Math.max(0, ti - 6), ti + 1).reduce((a, x) => a + x.w, 0) : 0;
const pwk = ti >= 0 ? days.slice(Math.max(0, ti - 13), Math.max(0, ti - 6)).reduce((a, x) => a + x.w, 0) : 0;
const ROWS = [
  { k: 'real', v: sum.w, key: 'sess_work', lb: 'work', pc: '', color: 'var(--c-text)' },
  ...BK.slice(0, 4).map(([k, key, lb]) => ({ k, v: cs[k] / cT * sum.w, key, lb, pc: Math.round(cs[k] / cT * 100) + '%', color: `var(--rz-${k})` })),
  { k: 'idle', v: sum.br, key: 'sess_break', lb: 'break', pc: '', color: 'var(--c-text-muted)' },
];

// Year of days: n weeks (Mon rows) ending with the latest day's week
const AL = [0, 0.22, 0.4, 0.6, 0.8, 1];
const lvl = (w: number) => (w <= 0.05 ? 0 : w < 2 ? 1 : w < 4 ? 2 : w < 6 ? 3 : w < 8 ? 4 : 5);
// Heatmap ends at yesterday so today's partial cell is not shown as a short day.
const lastDate = yesterday;
function yearCells(nW: number) {
  const start = isoAdd(lastDate, -wdOf(lastDate) - (nW - 1) * 7);
  const months: { col: number; m: string }[] = [];
  const cells: { col: number; row: number; tip?: string; l: number; fut: boolean }[] = [];
  let lm = -1;
  for (let w = 0; w < nW; w++) {
    const ws = isoAdd(start, w * 7), mo = +ws.slice(5, 7) - 1;
    if (mo !== lm && +ws.slice(8) <= 7) { months.push({ col: w + 2, m: M[mo] }); lm = mo; }
    for (let r = 0; r < 7; r++) {
      const k = isoAdd(start, w * 7 + r), x = byD.get(k);
      if (k > lastDate) { cells.push({ col: w + 2, row: r + 2, l: 0, fut: true }); continue; }
      const top = x ? BK.map(([b, , n]) => [n, x.c[b]] as const).sort((a, b) => b[1] - a[1]).filter((t) => t[1] > 0.1).slice(0, 2) : [];
      cells.push({
        col: w + 2, row: r + 2, fut: false, l: x ? lvl(x.w) : 0,
        tip: x && x.w > 0.05 ? `${k} ${WD[r]} · ${x.w.toFixed(1)}h · ${top.map(([n, h]) => `${n.toLowerCase()} ${h.toFixed(1)}h`).join(' · ')}` : `${k} · —`,
      });
    }
  }
  return { nW, months, cells };
}
const YEARS = [yearCells(53), yearCells(26)];

// Hours by month, last 13 months
const mo = new Map<string, { w: number; c: Record<Bucket, number> }>();
for (const x of days) {
  const k = x.d.slice(0, 7);
  if (!mo.has(k)) mo.set(k, { w: 0, c: { build: 0, talk: 0, write: 0, read: 0, off: 0 } });
  const m = mo.get(k)!; m.w += x.w; for (const [b] of BK) m.c[b] += x.c[b];
}
const MK = [...mo.keys()].sort().slice(-13);
const moMax = Math.max(1, ...MK.map((k) => mo.get(k)!.w));
const MIX = MK.map((k) => {
  const m = mo.get(k)!, ct = ctot(m.c), name = M[+k.slice(5) - 1];
  return {
    k, name, tot: Math.round(m.w), h: (m.w / moMax).toFixed(3),
    segs: BK.map(([b]) => ({ b, pct: (m.c[b] / ct * 100).toFixed(1) })),
    tip: `${k} · ${Math.round(m.w)}h · ` + BK.map(([b, , n]) => `${n.toLowerCase()} ${Math.round(m.c[b] / ct * 100)}%`).join(' · '),
  };
});

// Weekday × hour rhythm and the dial, from the 60-day hourly table
const hourly = rize.hourly as Record<string, number[][]>;
const hDays = Object.keys(hourly).sort();
const grid = WD.map(() => new Array(24).fill(0));
const wdCount = new Array(7).fill(0);
const avgHour = new Array(24).fill(0);
for (const d of hDays) {
  const w = wdOf(d); wdCount[w]++;
  hourly[d].forEach(([a, m], h) => { grid[w][h] += a + m; avgHour[h] += a + m; });
}
grid.forEach((row, w) => row.forEach((_, h) => { row[h] = wdCount[w] ? row[h] / wdCount[w] : 0; }));
avgHour.forEach((_, h) => { avgHour[h] = hDays.length ? avgHour[h] / hDays.length : 0; });
const gMax = Math.max(1, ...grid.flat());
let pk = [0, 0];
grid.forEach((r, w) => r.forEach((v, h) => { if (v > grid[pk[0]][pk[1]]) pk = [w, h]; }));
const busyHours = avgHour.map((v, h) => [h, v]).filter(([, v]) => v > 5).map(([h]) => h);
const daySpan = busyHours.length ? `${p2(busyHours[0])}:00–${p2(busyHours.at(-1)! + 1)}:00` : '';

// Dial: the same complete day as the featured bar (yesterday).
const dialDay = yesterday;
const dialHrs = hourly[dialDay] ?? new Array(24).fill([0, 0, 0]);
const aMax = Math.max(1, ...avgHour);
const cx = 150, cy = 150, R0 = 62, R1 = 104, R2 = 112, R3 = 138;
const ang = (h: number) => (h / 24) * Math.PI * 2 - Math.PI / 2;
const f1 = (n: number) => n.toFixed(1);
const arc = (r0: number, r1: number, a0: number, a1: number) => {
  const [c0, s0, c1, s1] = [Math.cos(a0), Math.sin(a0), Math.cos(a1), Math.sin(a1)];
  return `M${f1(cx + r1 * c0)} ${f1(cy + r1 * s0)}A${r1} ${r1} 0 0 1 ${f1(cx + r1 * c1)} ${f1(cy + r1 * s1)}L${f1(cx + r0 * c1)} ${f1(cy + r0 * s1)}A${r0} ${r0} 0 0 0 ${f1(cx + r0 * c0)} ${f1(cy + r0 * s0)}Z`;
};
const AVG_ARCS: { d: string; tip: string }[] = [];
const DAY_ARCS: { d: string; fill: string; op: string; tip: string }[] = [];
for (let h = 0; h < 24; h++) {
  const a0 = ang(h) + 0.015, a1 = ang(h + 1) - 0.015, v = avgHour[h];
  if (v > 0.5) AVG_ARCS.push({ d: arc(R2, R2 + (R3 - R2) * v / aMax, a0, a1), tip: `${p2(h)}:00 · 60-day avg ${Math.round(v)}m` });
  const [w, m, b] = dialHrs[h], tot = Math.min(60, w + m);
  const tip = `${p2(h)}:00 · work ${w}m${m ? ` · meeting ${m}m` : ''}${b ? ` · break ${b}m` : ''} · avg ${Math.round(v)}m`;
  if (tot) DAY_ARCS.push({ d: arc(R0, R0 + (R1 - R0) * tot / 60, a0, a1), fill: m > w / 2 ? 'var(--rz-talk)' : 'var(--rz-build)', op: (0.45 + 0.55 * tot / 60).toFixed(2), tip });
  else if (b > 15) DAY_ARCS.push({ d: arc(R0, R0 + 8, a0, a1), fill: 'var(--rz-brk)', op: '1', tip });
}
const TICKS = Array.from({ length: 8 }, (_, i) => i * 3).map((h) => {
  const a = ang(h), big = h % 6 === 0;
  return { h: p2(h), big, x1: f1(cx + (R1 + 2) * Math.cos(a)), y1: f1(cy + (R1 + 2) * Math.sin(a)), x2: f1(cx + (R1 + (big ? 8 : 5)) * Math.cos(a)), y2: f1(cy + (R1 + (big ? 8 : 5)) * Math.sin(a)), tx: f1(cx + (R3 + 9) * Math.cos(a)), ty: f1(cy + (R3 + 9) * Math.sin(a) + 3.5) };
});
const act = dialHrs.map(([w, m], h) => [h, w + m]).filter(([, v]) => v >= 5).map(([h]) => h);
const dialSpan = act.length ? `${p2(act[0])}–${p2(act.at(-1)! + 1)}` : '—';

// Top apps over the last 365 days, with hours per month for 12 months
const APP_CAT: Record<string, Bucket> = {
  Warp: 'build', Ghostty: 'build', Superset: 'build', Cursor: 'build', Code: 'build', 'Visual Studio Code': 'build', 'Google Chrome': 'read', 'Google Chrome Canary': 'build', Zed: 'build', Xcode: 'build', Terminal: 'build', iTerm2: 'build', Codex: 'build', Figma: 'build',
  Tana: 'write', Notion: 'write', Linear: 'write', Obsidian: 'write', Todoist: 'write', TickTick: 'write', Bear: 'write', Drafts: 'write', 'Roam Research': 'write',
  Telegram: 'talk', WeChat: 'talk', '微信': 'talk', Slack: 'talk', Discord: 'talk', Mail: 'talk', Zoom: 'talk',
};
const apps = rize.apps as Record<string, Record<string, number>>;
const appCut = isoAdd(lastDate, -364);
const AM = Array.from({ length: 12 }, (_, i) => { const d = new Date(lastDate + 'T00:00:00Z'); d.setUTCDate(1); d.setUTCMonth(d.getUTCMonth() - 11 + i); return d.toISOString().slice(0, 7); });
const appTot = new Map<string, number>(), appMo = new Map<string, Map<string, number>>();
for (const [d, o] of Object.entries(apps)) {
  if (d < appCut) continue;
  for (const [n, m] of Object.entries(o)) {
    appTot.set(n, (appTot.get(n) ?? 0) + m);
    if (!appMo.has(n)) appMo.set(n, new Map());
    appMo.get(n)!.set(d.slice(0, 7), (appMo.get(n)!.get(d.slice(0, 7)) ?? 0) + m);
  }
}
const topApps = [...appTot.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
const spMax = Math.max(1, ...topApps.flatMap(([n]) => AM.map((m) => appMo.get(n)!.get(m) ?? 0)));
// Shorter display names so the column doesn't truncate.
const ALIAS: Record<string, string> = { 'Google Chrome': 'Chrome', 'Google Chrome Canary': 'Canary', 'Visual Studio Code': 'VS Code' };
const APPS = topApps.map(([n, min], i) => {
  const c = APP_CAT[n] ?? 'read';
  return {
    i: i + 1, n: ALIAS[n] ?? n, c, h: Math.round(min / 60),
    sp: AM.map((m) => { const v = appMo.get(n)!.get(m) ?? 0; return { h: v ? Math.max(8, v / spMax * 100).toFixed(0) : '6', on: v > 0, tip: `${n} · ${M[+m.slice(5) - 1]} '${m.slice(2, 4)} · ${(v / 60).toFixed(1)}h` }; }),
  };
});
const amLabel = (m: string) => `${M[+m.slice(5) - 1]} '${m.slice(2, 4)}`;
---
<div class="card card-sessions" id="sessions">
  <div class="section-title" data-i18n="sec_sessions">Work Sessions</div>
  <div class="feed-head">
    <span class="feed-head-cmd"><span class="prompt">$</span> rize log --last 365d</span>
    <span class="feed-head-total rz-live"><i></i><span data-i18n="sess_synced">synced</span>{' '}<strong id="rzAgo" data-ts={rize.updatedAt}>·</strong></span>
  </div>

  <div class="rz">
    <div class="rz-top">
      <div class="tm">
        {ROWS.map((r) => (
          <div class="r">
            <span class="k">{r.k}</span><span class="v" style={`color:${r.color}`}>{hm(r.v)}</span><span class="lb" data-i18n={r.key}>{r.lb}</span><span class="pc">{r.pc}</span>
          </div>
        ))}
        <div class="note"># {active.length} <span data-i18n="sess_working_days">working days</span> · avg {(sum.w / Math.max(1, active.length)).toFixed(1)}h<br># <span data-i18n="sess_longest">longest</span>: {longest?.d} ({longest?.w.toFixed(1)}h)</div>
      </div>
      <div class="rz-day">
        <div class="t1">
          <span class="big">{hm(td.w)} <small>/ {TARGET}h · <span class="rz-rel" data-day={td.d}>{td.d.slice(5)}</span></small></span>
          <span class="pct">{Math.round(td.w / TARGET * 100)}%</span>
        </div>
        <div class="bar">{BK.map(([k]) => <span style={`width:${(td.c[k] / tdc * Math.min(td.w / TARGET, 1) * 100).toFixed(2)}%;background:var(--rz-${k})`}></span>)}</div>
        <div class="lg">{BK.map(([k, key, n]) => <span><i style={`background:var(--rz-${k})`}></i><span data-i18n={key}>{n}</span> {hm(td.c[k] / tdc * td.w)}</span>)}</div>
        <div class="chips">
          <span class="chip">streak <b>{streak}d</b></span>
          <span class="chip">7d <b>{wk.toFixed(0)}h</b> {wk >= pwk ? '↑' : '↓'}{Math.abs(wk - pwk).toFixed(0)}h</span>
        </div>
      </div>
    </div>

    <div class="sub">
      <span><span class="h"><span class="yr-full">52 weeks</span><span class="yr-half">26 weeks</span></span> · 1 cell = 1 day</span>
      <span class="scale">less {AL.map((a, i) => <i style={i ? `background:rgba(var(--rz-heat),${a})` : ''}></i>)} more</span>
    </div>
    {YEARS.map((y, yi) => (
      <div class:list={['year', yi ? 'yr-half' : 'yr-full']} style={`--weeks:${y.nW}`}>
        {y.months.map((m) => <span class="ml" style={`grid-column:${m.col}`}>{m.m}</span>)}
        {['M', '', 'W', '', 'F', '', ''].map((l, i) => <span class="wl" style={`grid-row:${i + 2}`}>{l}</span>)}
        {y.cells.map((c) => c.fut
          ? <i class="fut" style={`grid-column:${c.col};grid-row:${c.row}`}></i>
          : <i data-tip={c.tip} style={`grid-column:${c.col};grid-row:${c.row}${c.l ? `;background:rgba(var(--rz-heat),${AL[c.l]})` : ''}`}></i>)}
      </div>
    ))}

    <div class="rz-two">
      <div>
        <div class="sub"><span><span class="h" data-i18n="sess_by_month">by month</span></span></div>
        <div class="mix">
          {MIX.map((m) => (
            <div class="col" data-tip={m.tip}>
              <div class="tot">{m.tot}</div>
              <div class="stk" style={`--h:${m.h}`}>{m.segs.map((s) => <span style={`height:${s.pct}%;background:var(--rz-${s.b})`}></span>)}</div>
              <div class="lab" data-s={m.name[0]}>{m.name}</div>
            </div>
          ))}
        </div>
        <div class="lg" style="margin-top:10px">{BK.map(([k, key, n]) => <span><i style={`background:var(--rz-${k})`}></i><span data-i18n={key}>{n}</span></span>)}</div>
      </div>
      <div>
        <div class="sub"><span><span class="h" data-i18n="sess_rhythm">rhythm</span> · 60d</span></div>
        <div class="pc-grid">
          <span></span>
          {Array.from({ length: 24 }, (_, h) => <span class="hl">{h % 6 === 0 ? p2(h) : ''}</span>)}
          {grid.map((row, w) => [
            <span class="wl">{WD[w]}</span>,
            ...row.map((v, h) => <i data-tip={`${WD[w]} ${p2(h)}:00 · ${Math.round(v)}m avg`} style={v > 0.5 ? `--s:${(0.35 + 0.65 * v / gMax).toFixed(2)};background:rgba(var(--rz-heat),${(0.25 + 0.75 * v / gMax).toFixed(2)})` : ''}></i>),
          ])}
        </div>
        <div class="note" style="margin-top:8px"># busiest: <b>{WD[pk[0]]} {p2(pk[1])}:00</b>{daySpan && ` · ${daySpan}`}</div>
      </div>
    </div>

    <div class="rz-two rz-low">
      <div class="rz-dial">
        <svg class="dial" viewBox="-14 -14 328 328" role="img" aria-label="24-hour dial of the latest day">
          <circle cx={cx} cy={cy} r={(R0 + R1) / 2} fill="none" stroke="rgba(var(--c-overlay-rgb),0.06)" stroke-width={R1 - R0} />
          {AVG_ARCS.map((a) => <path d={a.d} fill="var(--c-text-muted)" opacity="0.4" data-tip={a.tip} />)}
          {DAY_ARCS.map((a) => <path d={a.d} fill={a.fill} opacity={a.op} data-tip={a.tip} />)}
          {TICKS.map((t) => [
            <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="var(--c-text-muted)" stroke-width="1" />,
            t.big && <text x={t.tx} y={t.ty} text-anchor="middle" font-size="10" fill="var(--c-text-muted)">{t.h}</text>,
          ])}
          <text x={cx} y={cy - 4} text-anchor="middle" font-size="22" font-weight="700" fill="var(--c-text)">{dialSpan}</text>
          <text x={cx} y={cy + 15} text-anchor="middle" font-size="10.5" fill="var(--c-text-muted)" class="rz-rel" data-day={dialDay} data-fmt="active">{dialDay.slice(5)}</text>
        </svg>
        <div class="lg dial-lg">
          <span><i style="background:var(--rz-build)"></i><span data-i18n="sess_work">work</span></span>
          <span><i style="background:var(--rz-talk)"></i><span data-i18n="sess_meeting">meeting</span></span>
          <span><i style="background:var(--c-text-muted);opacity:.5"></i>60d avg</span>
        </div>
      </div>
      <div>
        <div class="sub"><span><span class="h" data-i18n="sess_top_apps">top apps</span> · 365d</span><span class="ax">{amLabel(AM[0])} → {M[+AM[11].slice(5) - 1]}</span></div>
        <div class="apps">
          {APPS.map((a) => (
            <div class="app">
              <span class="rk">{a.i}</span>
              <span class="nm" title={a.n}><i style={`background:var(--rz-${a.c})`}></i>{a.n}</span>
              <span class="sp">{a.sp.map((s) => <b data-tip={s.tip} style={`height:${s.h}%${s.on ? `;background:var(--rz-${a.c})` : ''}`}></b>)}</span>
              <span class="h">{a.h}h</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { bindTips } from '../scripts/card-tips';

  const card = document.getElementById('sessions');
  bindTips(card);

  const zh = () => ((window as any).currentLang ?? document.documentElement.lang ?? '').startsWith('zh');
  function relabel() {
    // "synced 6h ago"
    const ago = document.getElementById('rzAgo');
    if (ago?.dataset.ts) {
      const h = Math.max(0, (Date.now() - Date.parse(ago.dataset.ts)) / 3600e3);
      const v = h < 1 ? `${Math.max(1, Math.round(h * 60))}m` : h < 48 ? `${Math.round(h)}h` : `${Math.round(h / 24)}d`;
      ago.textContent = zh() ? `${v} 前` : `${v} ago`;
    }
    // Day labels relative to the viewer's today in the account timezone (+08)
    const now = new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
    const y = new Date(Date.parse(now + 'T00:00:00Z') - 864e5).toISOString().slice(0, 10);
    card?.querySelectorAll<HTMLElement | SVGElement>('.rz-rel').forEach((el) => {
      const d = el.getAttribute('data-day') ?? '';
      const md = d.slice(5);
      const rel = d === y ? (zh() ? `昨天 ${md}` : `yesterday ${md}`) : md;
      el.textContent = el.getAttribute('data-fmt') === 'active' ? (zh() ? `活跃 · ${rel}` : `active · ${rel}`) : rel;
    });
  }
  relabel();
  window.addEventListener('langchange', relabel);
</script>

<style>
  .card-sessions {
    --rz-build: #4ade80; --rz-talk: #a78bfa; --rz-write: #fbbf24; --rz-read: #22d3ee; --rz-off: #6e7681;
    --rz-brk: #3b434d; --rz-heat: 74, 222, 128;
