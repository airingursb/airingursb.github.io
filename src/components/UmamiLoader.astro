---
// Self-hosted Umami (analytics.ursb.me). Injected only on production
// hostnames so localhost / 127.0.0.1 / preview hosts never load or fire it.
---
<script is:inline>
(function () {
  var host = location.hostname;
  if (host !== 'ursb.me' && host !== 'www.ursb.me' && host !== 'airingursb.github.io') return;
  var s = document.createElement('script');
  s.defer = true;
  s.src = 'https://analytics.ursb.me/script.js';
  s.setAttribute('data-website-id', 'aa8d5a16-df21-4058-a0a8-0191cdd3798d');
  document.head.appendChild(s);
})();
</script>
