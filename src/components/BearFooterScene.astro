---
import './bear-footer/scene.css';
import BearBird from './bear-study/BearBird.astro';
interface Props { lang?: 'zh' | 'en' }
const { lang = 'zh' } = Astro.props;
const labels = lang === 'en'
  ? { scene: 'A little bear reading under a tree', bear: 'Say hello to the bear', book: 'Read a passage together', mail: 'Receive new posts by email' }
  : { scene: '树荫下读书的小熊', bear: '和小熊打个招呼', book: '一起读一页书', mail: '接收新文章来信' };
---
<bear-footer-scene class="bear-footer-scene" aria-label={labels.scene}>
  <img src="/bear-footer/poster.webp" alt="" width="340" height="240" loading="lazy" decoding="async" />
  <canvas width="340" height="240" aria-hidden="true" hidden></canvas>
  <BearBird place="garden" />
  <svg class="bear-mailbox" viewBox="0 0 340 240" aria-hidden="true" shape-rendering="crispEdges">
    <path class="bear-mailbox-mouth" d="M39 163h23v21H39z" />
    <g class="bear-mailbox-lid">
      <path d="M39 163h23v21H39z" />
      <path class="bear-mailbox-trim" d="M39 163h23v2H41v19h-2z" />
      <path class="bear-mailbox-slot" d="M43 168h14v2H43z" />
    </g>
    <g class="bear-mailbox-letter">
      <path d="M40 145h20v14H40z" />
      <path class="bear-mailbox-fold" d="m41 146 9 6 9-6M41 158l6-6m6 0 6 6" />
    </g>
  </svg>
  <button type="button" class="bear-footer-hotspot bear-footer-head" data-footer-bear aria-label={labels.bear}></button>
  <button type="button" class="bear-footer-hotspot bear-footer-book" data-book aria-label={labels.book}></button>
  <button type="button" class="bear-footer-hotspot bear-footer-mail" data-footer-subscribe aria-label={labels.mail}></button>
</bear-footer-scene>
<script>
  import { BearFooterScene } from './bear-footer/player';
  if (!customElements.get('bear-footer-scene')) customElements.define('bear-footer-scene', BearFooterScene);
</script>
