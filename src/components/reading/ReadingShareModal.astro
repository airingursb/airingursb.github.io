---
// Share trigger + site-wide native share dialog for a reading note.
import ShareDialog from '../ShareDialog.astro';
import { resolveReadingCoverImage } from '../../lib/reading-cover-image';
import ReadingCover from './ReadingCover.astro';

interface Props {
  coverUrl: string;
  coverLabel?: string;
  lang: 'zh' | 'en';
  shareTitle: string;
  shareUrl: string;
}

const { coverUrl, coverLabel, lang, shareTitle, shareUrl } = Astro.props;
// Keep the card's own ratio (no 3:2 crop) for the preview.
const cover = await resolveReadingCoverImage(coverUrl, coverLabel || `"${shareTitle}"`, {
  inferSize: true,
  widths: [480, 960],
  format: 'webp',
  quality: 75,
});
const labels = lang === 'en'
  ? { share: 'Share', heading: 'Share this reading note', kicker: 'READING / PASS IT ON', save: 'Save card' }
  : { share: '分享', heading: '分享这条阅读', kicker: '阅读流 / 转给朋友', save: '保存卡片' };
const extension = coverUrl.split('?')[0].split('.').pop() || 'png';
---

<button type="button" class="reading-action" data-share-open="reading-share">
  {labels.share}
</button>

<ShareDialog
  id="reading-share"
  lang={lang}
  shareTitle={shareTitle}
  shareUrl={shareUrl}
  heading={labels.heading}
  kicker={labels.kicker}
  caption={shareTitle}
  download={cover ? { href: coverUrl, filename: `reading-card.${extension}`, label: labels.save } : undefined}
  openEvent="reading-share"
  actionEvent="reading-share-action"
>
  {cover && (
    <div slot="preview" class="share-image">
      <ReadingCover
        image={cover}
        alt={shareTitle}
        width={Number(cover.attributes.width) || 720}
        height={Number(cover.attributes.height) || 480}
        sizes="(max-width: 600px) calc(100vw - 58px), 486px"
        loading="lazy"
        decoding="async"
        reuse=".reading-poster img"
      />
    </div>
  )}
</ShareDialog>
