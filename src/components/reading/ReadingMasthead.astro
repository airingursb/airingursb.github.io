---
import LangSwitch from '../LangSwitch.astro';

interface Props {
  lang: 'zh' | 'en';
  currentPath: string;
  breadcrumb: string;
}

const { lang, currentPath, breadcrumb } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
---

<header class="reading-shell">
  <div class="reading-mast-top"></div>
  <div class="reading-mast-bar">
    <a class="reading-brand" href={`${prefix}/blog/`}>Airing's Blog</a>
    <nav class="reading-nav" aria-label={lang === 'en' ? 'Blog navigation' : '博客导航'}>
      <a href={`${prefix}/blog/`}>Blog</a>
      <a href={`${prefix}/moments/`}>Moment</a>
      <a href={`${prefix}/notes/`}>Notes</a>
      <a class="active" href={`${prefix}/reading/`} aria-current="page">Reading</a>
      <a href="/photos/">Photos</a>
      <a href={`${prefix}/friends/`}>Friends</a>
    </nav>
  </div>
  <div class="reading-subbar">
    <span>{breadcrumb}</span>
    <LangSwitch lang={lang} currentPath={currentPath} />
  </div>
</header>
