---
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const title = zh ? 'AI 趋势周刊' : 'AI Trends Weekly';
---
 <div class="issue-cover" aria-label={zh?'第 002 期杂志封面':'Issue 002 magazine cover'}>
  <div class="cover-masthead"><div class="cover-edition"><span>NO. 002</span><span>2026.09.27—10.03</span></div><h1>{title}</h1><p>{zh?'每周一更新 · 理解正在发生的变化':'Every Monday · Understand what is changing'}</p></div>
  <div class="cover-art"><img src="/reading/weekly/002/assets/cover-02-studio.webp" width="1122" height="1402" alt={zh?'小熊在编辑台制作影片，胶片穿过水彩、纸雕与几何风格的场景；AI 概念插画':'Airing’s bear editing a film, with a ribbon of frames crossing watercolor, paper theatre and graphic scenes; AI concept illustration'} fetchpriority="high" decoding="async" /><div class="cover-story"><p>{zh?'封面专题 · 代码与影像':'COVER STORY · CODE & FILM'}</p><strong>Opus 5.5</strong><h2>{zh?'把代码':'Make films'}<br/>{zh?'拍成电影':'with code'}</h2><span>{zh?'导演方案 · 风格文档 · 时间轴 · 逐帧渲染':'Direction · style · timeline · rendering'}</span></div><span class="art-credit">{zh?'小熊编辑台 · AI 概念插画':'The bear’s desk · AI illustration'}</span></div>
  <div class="cover-teasers"><p><small>{zh?'Agent 工程':'AGENT ENGINEERING'}</small>{zh?'Pi 1.0，两条 Agent 路线':'Pi 1.0, two paths for agents'}</p><p><small>{zh?'工具上新':'THE TOOL SHELF'}</small>{zh?'10 款工具，短读速览':'10 tools, in brief'}</p></div>
  <div class="cover-byline"><span>{zh?'编辑':'Edited by'} <a href="https://ursb.me/">Airing</a></span><span>{zh?'45 篇阅读 · 5 个主题':'45 saves · 5 themes'}</span></div>
 </div>
