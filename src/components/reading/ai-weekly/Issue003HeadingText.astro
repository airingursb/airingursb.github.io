---
interface Props { text: string; lang: 'zh' | 'en'; }
const { text, lang } = Astro.props;
const parts = lang === 'zh'
 ? Array.from(new Intl.Segmenter('zh', { granularity: 'word' }).segment(text),
   part => ({ text: part.segment, unbroken: part.isWordLike && /\p{Script=Han}/u.test(part.segment) }))
 : [{ text, unbroken: false }];
---
{parts.map(part => part.unbroken ? <span class="heading-word">{part.text}</span> : part.text)}
