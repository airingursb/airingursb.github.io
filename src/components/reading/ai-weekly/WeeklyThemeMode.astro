---
// Site light/dark mode for the standalone AI Weekly pages (M3, option 1).
// The printed paper stays light on purpose (DESIGN.md → "Print surfaces in
// dark mode"); only the desk around it, the outside bar and the browser
// theme-color follow the reader's site-wide choice.
//   <WeeklyThemeMode part="head" />    inside <head>
//   <WeeklyThemeMode part="toggle" />  in the outside bar
interface Props { part: 'head' | 'toggle'; lang?: 'zh' | 'en'; /** Browser bar colour in light mode (the issue's desk). */ light?: string; }
const { part, lang = 'zh', light = '#e8e5de' } = Astro.props;
const zh = lang === 'zh';
---
{part === 'head' && (
  <Fragment>
    <meta name="theme-color" content={light} data-weekly-theme-color data-light={light} />
    <script is:inline>
      (function () {
        var m = null;
        try { if (localStorage.getItem('blog-mode-set')) m = localStorage.getItem('blog-mode'); } catch (e) {}
        // Same default as BaseLayout: /reading pages open in light.
        var mode = m === 'dark' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-mode', mode);
        var meta = document.querySelector('meta[data-weekly-theme-color]');
        if (meta) meta.setAttribute('content', mode === 'dark' ? '#0d1117' : meta.getAttribute('data-light'));
      })();
    </script>
    <style is:global>
      :root { --weekly-outside-ink: var(--ink); --weekly-outside-muted: var(--muted); --weekly-desk: var(--desk); }
      html[data-mode="dark"] {
        color-scheme: dark;
        /* Site dark canvas (tokens.css --c-bg / --c-text / --c-text-muted). */
        --weekly-desk: #0d1117;
        --weekly-outside-ink: #e6edf3;
        --weekly-outside-muted: #9198a1;
      }
      html[data-mode="dark"] body { background: var(--weekly-desk); }
      html[data-mode="dark"] .paper,
      html[data-mode="dark"] dialog { color-scheme: light; }
      html[data-mode="dark"] .outside-bar,
      html[data-mode="dark"] .outside-footer { color: var(--weekly-outside-muted); }
      html[data-mode="dark"] .outside-bar a { color: var(--weekly-outside-ink); }
      html[data-mode="dark"] .outside-bar a:focus-visible,
      html[data-mode="dark"] .weekly-mode:focus-visible { outline-color: #4ade80; }
    </style>
  </Fragment>
)}
{part === 'toggle' && (
  <button type="button" class="weekly-mode" data-weekly-mode aria-label={zh ? '切换深色 / 浅色' : 'Toggle dark / light'} title={zh ? '切换深色 / 浅色' : 'Toggle dark / light'}>
    <svg class="sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3.5"/><path d="M8 .5v2M8 13.5v2M.5 8h2M13.5 8h2M2.7 2.7l1.4 1.4M11.9 11.9l1.4 1.4M2.7 13.3l1.4-1.4M11.9 4.1l1.4-1.4"/></svg>
    <svg class="moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.5a5.5 5.5 0 01-7-7 5.5 5.5 0 107 7z"/></svg>
  </button>
  <script is:inline>
    (function () {
      var button = document.querySelector('[data-weekly-mode]');
      if (!button) return;
      button.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-mode', next);
        try { localStorage.setItem('blog-mode', next); localStorage.setItem('blog-mode-set', '1'); } catch (e) {}
        var meta = document.querySelector('meta[data-weekly-theme-color]');
        if (meta) meta.setAttribute('content', next === 'dark' ? '#0d1117' : meta.getAttribute('data-light'));
        if (typeof umami !== 'undefined') umami.track('dark-mode-toggle', { mode: next, surface: 'weekly' });
      });
    })();
  </script>
  <style is:global>
    .outside-tools { display: inline-flex; align-items: center; gap: 12px; margin-left: auto; }
    .weekly-mode { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--weekly-outside-ink, var(--ink)); cursor: pointer; }
    .weekly-mode:hover { color: var(--accent); }
    .weekly-mode:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .weekly-mode .moon { display: none; }
    html[data-mode="dark"] .weekly-mode .sun { display: none; }
    html[data-mode="dark"] .weekly-mode .moon { display: block; }
  </style>
)}
