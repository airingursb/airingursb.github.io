---
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const root = '/reading/weekly/003/assets/';
---
<div class="issue-cover cover-003" aria-label={zh ? '第 003 期杂志封面' : 'Issue 003 magazine cover'}>
 <div class="cover-masthead">
  <div class="cover-edition"><span>NO. 003</span><span>2026.10.04—10.10</span></div>
  <h1>{zh ? 'AI 趋势周刊' : 'AI Trends Weekly'}</h1>
  <p>{zh ? '每周一更新 · 理解正在发生的变化' : 'Every Monday · Understand what is changing'}</p>
 </div>
 <div class="cover-art">
  <img src={root+'cover-03-math-960.webp'} srcset={root+'cover-03-math-480.webp 480w, '+root+'cover-03-math-960.webp 960w'} sizes="(min-width: 1280px) 556px, (min-width: 700px) 540px, calc(100vw - 40px)" width="960" height="1200" alt={zh ? '熊猫在研究桌前，用放大镜和铅笔检查数学手稿；AI 概念插画' : 'Airing’s panda examining mathematical manuscripts with a magnifying glass and pencil; AI concept illustration'} fetchpriority="high" decoding="async"/>
  <div class="cover-story"><p>{zh ? '封面专题 · 突破、抵制与合作' : 'COVER STORY · PROGRESS & RESISTANCE'}</p><strong>OpenAI</strong><h2>{zh ? '交出数学手稿' : 'After the'}<br/>{zh ? '之后' : 'manuscripts'}</h2><span>{zh ? '数学家将怎样与 AI 共事？' : 'How will researchers work with AI?'}</span></div>
  <span class="art-credit">{zh ? '熊猫研究室 · AI 概念插画' : 'The panda’s study · AI illustration'}</span>
 </div>
 <div class="cover-teasers"><p><small>{zh ? 'Agent 工程' : 'AGENT ENGINEERING'}</small>{zh ? '压缩、缓存与任务恢复' : 'Context, cache and recovery'}</p><p><small>{zh ? '研究与工具' : 'RESEARCH & TOOLS'}</small>{zh ? 'Dream-RSI · 10 款新品' : 'Dream-RSI · 10 tools'}</p></div>
 <div class="cover-byline"><span>{zh ? '编辑' : 'Edited by'} <a href="https://ursb.me/">Airing</a></span><span>{zh ? '28 篇阅读 · 5 个主题' : '28 saves · 5 themes'}</span></div>
</div>
