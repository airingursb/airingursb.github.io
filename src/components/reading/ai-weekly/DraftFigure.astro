---
interface Props {
 item: {file:string;width:number;height:number;title:{zh:string;en:string};caption:{zh:string;en:string};sourceUrl:string;sourceLabel:string};
 lang:'zh'|'en';
}
const { item, lang } = Astro.props;
const zh = lang==='zh';
const src = `/reading/weekly/002/assets/${item.file}`;
---
<figure class="source-figure">
 <div class="source-figure-heading"><h5>{item.title[lang]}</h5><a href={src} target="_blank" rel="noopener" aria-label={`${zh?'打开完整图像：':'Open full image: '}${item.title[lang]}`}>{zh?'放大查看':'Full image'} ↗</a></div>
 <img src={src} width={item.width} height={item.height} alt={item.title[lang]} loading="lazy" decoding="async" />
 <figcaption><p>{item.caption[lang]}</p><a href={item.sourceUrl}>{zh?'图像来源：':'Image source: '}{item.sourceLabel} ↗</a></figcaption>
</figure>
