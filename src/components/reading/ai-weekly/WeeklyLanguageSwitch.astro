---
// "中 · EN" switch for the AI Weekly outside bar — same form as the site's
// LangSwitch (no external-link arrow; it is the same issue in another language).
interface Props { lang: 'zh' | 'en'; href: string; }
const { lang, href } = Astro.props;
const zh = lang === 'zh';
---
<span class="weekly-lang">
  {zh ? <strong aria-current="true">中</strong> : <a href={href} lang="zh-CN" hreflang="zh-CN" data-language-switch aria-label="简体中文">中</a>}
  <span aria-hidden="true">·</span>
  {zh ? <a href={href} lang="en" hreflang="en" data-language-switch aria-label="English">EN</a> : <strong aria-current="true">EN</strong>}
</span>
<style>
  .weekly-lang { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .weekly-lang strong { font-weight: 700; color: var(--weekly-outside-ink, var(--ink)); }
  .weekly-lang a { position: relative; display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-decoration: none; }
  .weekly-lang a::after { content: ''; position: absolute; inset: 0 -14px; }
  .weekly-lang a:hover { color: var(--weekly-outside-ink, var(--ink)); }
</style>
