---
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const root = '/reading/weekly/004/';
---
<div class="issue-cover cover-004" aria-label={zh ? '第 004 期杂志封面' : 'Issue 004 magazine cover'}>
 <div class="cover-masthead">
  <div class="cover-edition"><span>NO. 004</span><span>2026.10.11—10.17</span></div>
  <p class="cover-name">{zh ? 'AI 趋势周刊' : 'AI Trends Weekly'}</p>
  <p>{zh ? '每周一更新 · 理解正在发生的变化' : 'Every Monday · Understand what is changing'}</p>
 </div>
 <div class="cover-art">
  <img src={root+'cover-04-handoff-960.webp'} srcset={`${root}cover-04-handoff-480.webp 480w, ${root}cover-04-handoff-960.webp 960w`} sizes="(min-width:1280px) 556px, (min-width:700px) 540px, calc(100vw - 40px)" width="960" height="1200" alt={zh ? '戴蓝色贝雷帽的 Airing 熊猫在编辑台检查任务进展、证据和下一步；AI 概念插画。' : 'Airing, a panda in a blue beret, checks progress, evidence and next steps at an editing desk; AI concept illustration.'} fetchpriority="high" decoding="async"/>
  <div class="cover-story">
   <p>{zh ? '封面专题 · 常驻与交付' : 'COVER STORY · PERSISTENCE & HANDOFFS'}</p>
   <strong>Agent</strong>
   <h2>{zh ? '常驻之后' : 'Always on.'}<br/>{zh ? '怎样放心交付？' : 'Ready to hand over?'}</h2>
   <span>{zh ? '让进展、证据和下一步一起留下' : 'Leave progress, evidence and a next step'}</span>
  </div>
  <span class="art-credit">{zh ? '熊猫编辑台 · AI 概念插画' : 'The panda’s desk · AI illustration'}</span>
 </div>
 <div class="cover-teasers">
  <p><small>{zh ? 'Agent 工程' : 'AGENT ENGINEERING'}</small>{zh ? 'Scion：代码多了以后' : 'Scion: when code scales'}</p>
  <p><small>{zh ? '研究与工具' : 'RESEARCH & TOOLS'}</small>{zh ? '研究新同事 · 5 款工具' : 'Research agents · 5 tools'}</p>
 </div>
 <div class="cover-byline"><span>{zh ? '编辑' : 'Edited by'} <a href="https://ursb.me/">Airing</a></span><span>{zh ? '34 篇阅读 · 5 个主题' : '34 saves · 5 themes'}</span></div>
</div>
