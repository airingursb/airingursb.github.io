---
import Issue003HeadingText from './Issue003HeadingText.astro';
interface Props { type: string; lang: 'zh' | 'en'; }
const { type, lang } = Astro.props;
const p = (zh: string, en: string) => lang === 'zh' ? zh : en;
const positions = [
 {speaker:'OpenAI',role:p('手稿发布方','Manuscript publisher'),claim:p('用尚未解决的数学问题，检验内部模型的研究能力。','Evaluate an internal model on unsolved mathematical problems.'),request:p('开放手稿与部分研究轨迹，让外界检查结果。','Release manuscripts and some research traces for outside scrutiny.')},
 {speaker:'AHM',role:p('人类数学协会','Association for Human Mathematics'),claim:p('批量生成证明，不等于数学共同体获得了理解。','Producing proofs in bulk is not the same as developing shared mathematical understanding.'),request:p('呼吁停止与 OpenAI 合作，主张科研以人的理解为中心。','Calls for an end to collaboration with OpenAI and for research centered on human understanding.')},
 {speaker:'AGMAI',role:p('数学与人工智能咨询小组','Advisory Group on Mathematics and AI'),claim:p('工具可及、研究自主与共同体消化成果的能力，都应进入评价。','Access, research autonomy and the community’s capacity to assimilate results belong in the evaluation.'),request:p('建议停止在专有模型上测试高等数学，并通过独立机构资助共同体消化工作。','Recommends stopping advanced-math testing on proprietary models and funding community assimilation through independent institutions.')}
];
const history = [
 {id:'four-color',name:p('数学：怎样相信机器参与的证明？','Mathematics: how do we trust a machine-assisted proof?'),events:[
  {year:'1976',title:p('计算机辅助证明','Computer-assisted proof'),text:p('四色定理的证明依赖大量机器检查，引出可靠性与理解的讨论。','The four-color proof relies on extensive computation, raising questions of reliability and understanding.')},
  {year:'1994',title:p('理解也是研究成果','Understanding matters'),text:p('Thurston 讨论证明如何帮助数学家传播理解。','Thurston discusses how proof communicates understanding among mathematicians.')},
  {year:'2005',title:p('加入形式化核验','Formal verification'),text:p('Gonthier 的形式化证明进一步建立可由机器检查的依据。','Gonthier’s formal proof supplies a further machine-checkable foundation.')}],
  lesson:p('后续进展增加了核验方法，也继续追问如何理解。','Later work adds ways to verify while keeping understanding in view.'),
  difference:p('这次 AI 还在生成研究论证；大量产出、专有工具和研究机会的分配，是额外的问题。','Today AI also generates research arguments. Output scale, proprietary tools and access to research add further issues.')},
 {id:'artists',name:p('创作：谁的作品训练了模型？','Creative work: whose work trained the model?'),events:[
  {year:'2024',title:p('反对未经许可的训练','Opposition to unlicensed training'),text:p('创作者联署关注作品被使用的许可，以及创作者的生计。','Creators’ statement focuses on permission to use their work and threats to livelihoods.')},
  {year:'2025',title:p('部分合作开始谈条件','Some partnerships negotiate terms'),text:p('WMG 与 Suno 宣布许可合作，包含创作者选择是否参与的安排。','WMG and Suno announce licensed collaboration with a creator opt-in framework.')}],
  lesson:p('技术采用与争取许可、报酬和选择权，可以同时发生。','Adoption can coexist with negotiation over permission, pay and choice.'),
  difference:p('一项合作公告不代表所有创作者受益；艺术价值也不能像数学命题一样接受真假检验。','One partnership does not establish universal benefit. Artistic value also lacks a theorem’s true-or-false test.')}
];
const loop = [
 {n:'01',title:p('提出一个值得追问的问题','Frame a worthwhile question'),text:p('人和 AI 都可以提出候选；交代为什么值得研究。','People and AI propose candidates and explain why they matter.')},
 {n:'02',title:p('生成论证，也寻找反例','Develop arguments and counterexamples'),text:p('并行尝试引理、计算案例与不同证明路线。','Explore lemmas, examples and alternative proof routes.')},
 {n:'03',title:p('核验并讲清贡献','Check and explain the contribution'),text:p('检查推导、原命题、已有工作和方法的适用范围。','Check derivations, intended statements, prior work and scope.')},
 {n:'04',title:p('让别人能接着研究','Make further research possible'),text:p('分享解释、工具与失败经验，形成下一轮问题。','Share explanations, tools and failed approaches to enable new questions.')}
];
---
{type === 'release-timeline' && <figure class="analysis-figure release-timeline">
 <figcaption><p class="kicker">BACKGROUND / THE RELEASE AND RESPONSE</p><h5><Issue003HeadingText text={p('先把这件事放回时间线','First, put the release in context')} lang={lang}/></h5></figcaption>
 <ol class="release-events">
  <li><time>09.29</time><div><h6><Issue003HeadingText text={p('发布之前，已有分歧','Concerns predate the release')} lang={lang}/></h6><p>{p('独立学者咨询小组 AGMAI 发布建议，关注研究自主与成果消化。','AGMAI, an independent advisory group, publishes advice on autonomy and assimilation.')}</p></div></li>
  <li><time>10.06</time><div><h6><Issue003HeadingText text={p('OpenAI 公开数学手稿','OpenAI releases manuscripts')} lang={lang}/></h6><p>{p('内部模型尝试开放问题；公开材料供外界检查。','An internal model attempts open problems; materials are released for scrutiny.')}</p></div></li>
  <li><time>10.07</time><div><h6><Issue003HeadingText text={p('修正错误，争议扩大','Corrections and public opposition')} lang={lang}/></h6><p>{p('仓库记录 3 份撤回；人类数学协会 AHM 发布抵制声明。','Three withdrawals are recorded; the Association for Human Mathematics (AHM) calls for a boycott.')}</p></div></li>
 </ol>
 <div class="release-ledger">
  <div class="manuscript-count"><span>{p('最初发布','Initial release')}</span><strong>722</strong><span class="count-delta">− 3 {p('撤回','withdrawn')} <span class="count-arrow" aria-hidden="true">→</span></span><strong>719</strong><span>{p('现存手稿','remaining manuscripts')}</span></div>
  <p>{p('719 份手稿覆盖 372 个问题家族；同一家族可以有不止一份手稿。','The 719 manuscripts cover 372 problem families; one family can contain multiple manuscripts.')}</p>
 </div>
 <div class="formal-coverage">
  <div class="coverage-heading"><strong>300 / 719</strong><span>{p('手稿的主要结论已形式化，约 42%','manuscripts have formalized top-line results, about 42%')}</span></div>
  <div class="coverage-bar" role="img" aria-label={p('719 份手稿中，300 份的主要结论已形式化，419 份尚无这项形式化记录。','Of 719 manuscripts, 300 have formalized top-line results and 419 have no such formalization recorded.')}><span class="coverage-done" style="width:41.7246%"></span><span class="coverage-rest"></span></div>
  <div class="coverage-key"><span><i></i>300 {p('已形式化','formalized')}</span><span><i></i>419 {p('尚无这项记录','without this record')}</span></div>
 </div>
 <p class="analysis-caption">{p('数量依据本期核对的仓库版本。“手稿”“独立问题”和“同行评审论文”不是同一个计量单位；未形式化也不等于已被证伪。','Counts use the repository version checked for this issue. Manuscripts, distinct problems and peer-reviewed papers are different units; absence of formalization does not mean a result is false.')}</p>
</figure>}
{type === 'ai-contribution' && <figure class="analysis-figure ai-contribution">
 <figcaption><p class="kicker">CAPABILITY / A RESEARCH PATH</p><h5><Issue003HeadingText text={p('AI 的作用，可以沿一条研究路径来看','Follow a research path to see what AI contributes')} lang={lang}/></h5></figcaption>
 <div class="research-path">
  <div class="path-question"><span class="diagram-label">{p('起点','START')}</span><h6><Issue003HeadingText text={p('一个尚未解决的问题','An unsolved problem')} lang={lang}/></h6><p>{p('现有文献、定义与限制条件','Prior work, definitions and constraints')}</p></div>
  <span class="path-arrow" aria-hidden="true">→</span>
  <div class="path-search"><span class="diagram-label">{p('AI 参与探索','AI-ASSISTED EXPLORATION')}</span><div class="search-branches"><span>A<br/>{p('引理','Lemma')}</span><span>B<br/>{p('反例','Refute')}</span><span>C<br/>{p('新路径','New route')}</span></div><h6><Issue003HeadingText text={p('把尝试变成候选论证','Turn attempts into candidate arguments')} lang={lang}/></h6></div>
  <span class="path-arrow" aria-hidden="true">→</span>
  <div class="path-result"><span class="diagram-label">{p('进入公共知识','TOWARD SHARED KNOWLEDGE')}</span><ul><li>{p('推导是否成立','Check the derivation')}</li><li>{p('与已有结果是什么关系','Establish its relation to prior work')}</li><li>{p('别人能否理解与复用','Make it understandable and reusable')}</li></ul></div>
 </div>
 <div class="research-feedback"><span aria-hidden="true">↶</span><p>{p('反例、检查结果和新理解，继续改变下一轮探索。','Counterexamples, checks and new understanding reshape the next attempt.')}</p></div>
 <p class="analysis-caption">{p('研究过程示意，A/B/C 不代表此次实验的实际分支数。AI 可以参与探索、核验和解释；这幅图不规定人与 AI 的永久分工。','Process schematic; A/B/C are not measured branch counts. AI can help explore, verify and explain. The diagram does not prescribe a permanent human–AI division of work.')}</p>
</figure>}
{type === 'debate-positions' && <figure class="analysis-figure debate-positions">
 <figcaption><p class="kicker">DEBATE / THE DIFFERENT CLAIMS</p><h5><Issue003HeadingText text={p('同一批手稿，三种不同的关注点','One release, three different concerns')} lang={lang}/></h5></figcaption>
 <div class="position-head" aria-hidden="true"><span>{p('谁在说','Speaker')}</span><span>{p('核心判断','Central claim')}</span><span>{p('提出什么行动','Proposed action')}</span></div>
 <div class="position-list">{positions.map(v=><div class="position-row"><div><h6><Issue003HeadingText text={v.speaker} lang={lang}/></h6><p>{v.role}</p></div><p><span class="mobile-field">{p('核心判断','Central claim')}</span>{v.claim}</p><p><span class="mobile-field">{p('行动','Action')}</span>{v.request}</p></div>)}</div>
 <p class="analysis-caption">{p('依据各方一手声明概括。AGMAI 提供建议不等于为发布背书；陶哲轩博客刊载 AHM 客座文章，不等于他代表全体数学家发言。','Paraphrased from primary statements. AGMAI’s advice is not an endorsement; Tao’s hosting of AHM’s guest article does not make it a statement for all mathematicians.')}</p>
</figure>}
{type === 'research-checks' && <figure class="analysis-figure research-checks">
 <figcaption><p class="kicker">WORKED EXAMPLE / CHECK THE STATEMENT</p><h5><Issue003HeadingText text={p('多加一个条件，证明可能对了，问题却变了','An extra condition can make the proof work—and change the question')} lang={lang}/></h5></figcaption>
 <div class="assumption-example">
  <div class="statement-original"><span class="diagram-label">{p('原本要证明','INTENDED STATEMENT')}</span><p class="statement-formula">∀ n ∈ ℤ, n² &gt; 0</p><p>{p('所有整数的平方都大于 0。','Every integer has a positive square.')}</p><div class="statement-verdict"><strong>n = 0 → 0² = 0</strong><span>{p('一个反例，就足以推翻。','One counterexample disproves it.')}</span></div></div>
  <span class="statement-arrow" aria-hidden="true">→</span>
  <div class="statement-changed"><span class="diagram-label">{p('改写时增加条件','ADDED DURING TRANSLATION')}</span><p class="statement-formula">∀ n ∈ ℤ, <mark>n ≠ 0</mark> ⇒ n² &gt; 0</p><p>{p('所有非零整数的平方都大于 0。','Every nonzero integer has a positive square.')}</p><div class="statement-verdict"><strong>{p('这个命题成立','This statement is true')}</strong><span>{p('但它排除了原问题中的 n = 0。','But it excludes n = 0 from the original claim.')}</span></div></div>
 </div>
 <div class="check-questions"><span>{p('推导成立？','Valid derivation?')}</span><span>{p('命题相同？','Same statement?')}</span><span>{p('结果新吗？','Novel result?')}</span><span>{p('方法有用吗？','Useful method?')}</span></div>
 <p class="analysis-caption">{p('编者设计的入门例子，不是这次手稿的错误案例，也不是 Lean 代码或运行结果。形式核验检查被编码的命题；我们仍要核对编码是否忠实表达了原问题。','An introductory example, not an error found in these manuscripts, Lean code or an executed checker result. Formal verification checks the encoded claim; fidelity to the intended question still needs scrutiny.')}</p>
</figure>}
{type === 'research-work' && <figure class="analysis-figure research-work">
 <figcaption><p class="kicker">ACCESS / WHAT REACHES THE COMMUNITY?</p><h5><Issue003HeadingText text={p('能读到成果，与能使用研究工具，是两种机会','Access to results and access to research tools are different opportunities')} lang={lang}/></h5></figcaption>
 <div class="access-lanes">
  <div><span class="diagram-label">{p('只有输出','RESULTS ONLY')}</span><div class="access-route"><strong>{p('内部模型','Internal model')}</strong><span aria-hidden="true">→</span><strong>{p('公开手稿','Public manuscripts')}</strong><span aria-hidden="true">→</span><strong>{p('读者消化','Readers assimilate')}</strong></div><p>{p('大家可以检查结果，但不一定有条件发起同样的探索。','Readers can inspect outputs without necessarily being able to initiate comparable research.')}</p></div>
  <div class="access-participation"><span class="diagram-label">{p('加入参与条件','ADD THE MEANS TO PARTICIPATE')}</span><div class="access-route"><strong>{p('自主问题','Independent questions')}</strong><span aria-hidden="true">↔</span><strong>{p('可用工具','Accessible tools')}</strong><span aria-hidden="true">↔</span><strong>{p('共享解释','Shared explanations')}</strong></div><p>{p('工具、资源与学术认可，使研究者能继续选题、理解和训练下一代。','Tools, resources and recognition support question-setting, understanding and training new researchers.')}</p></div>
 </div>
 <p class="analysis-caption">{p('编者概括的两种研究条件，不是对工具开放程度或研究成本的定量测量。','An editorial comparison of research conditions, not a quantitative measure of access or cost.')}</p>
</figure>}
{type === 'history-comparison' && <figure class="analysis-figure history-comparison">
 <figcaption><p class="kicker">HISTORY / WHAT ACTUALLY CHANGED?</p><h5><Issue003HeadingText text={p('历史里的变化，发生在核验方法和合作条件上','Historical changes involve verification and the terms of cooperation')} lang={lang}/></h5></figcaption>
 <div class="history-columns">{history.map(track=><section class={'history-track history-'+track.id}><h6><Issue003HeadingText text={track.name} lang={lang}/></h6><ol>{track.events.map(v=><li><time>{v.year}</time><div><strong>{v.title}</strong><p>{v.text}</p></div></li>)}</ol><p class="history-lesson">{track.lesson}</p><p class="history-difference"><strong>{p('这次有什么不同','What differs today')}</strong>{track.difference}</p></section>)}</div>
 <p class="analysis-caption">{p('资料：Thurston、Gonthier、2024 训练声明与 WMG 公告。按事件先后排列；不表示时间间隔或必然走向。','Sources: Thurston, Gonthier, the 2024 training statement and WMG’s announcement. Events are ordered, not drawn to time scale or as an inevitable sequence.')}</p>
</figure>}
{type === 'collaboration-loop' && <figure class="analysis-figure collaboration-loop">
 <figcaption><p class="kicker">RELATIONSHIP / KEEP THE LOOP OPEN</p><h5><Issue003HeadingText text={p('成果要回到下一轮研究里','Results should feed the next round of research')} lang={lang}/></h5></figcaption>
 <ol class="collaboration-stages">{loop.map(v=><li class={'loop-step loop-step-'+v.n}><span>{v.n}</span><div><h6><Issue003HeadingText text={v.title} lang={lang}/></h6><p>{v.text}</p></div><b class="loop-arrow" aria-hidden="true">{v.n==='01'?'→':v.n==='02'?'↓':v.n==='03'?'←':'↑'}</b></li>)}</ol>
 <div class="collaboration-return"><span aria-hidden="true">↶</span><p>{p('理解、工具与人的成长，成为新问题的起点。','Understanding, tools and developed expertise become the starting point for new questions.')}</p></div>
 <p class="analysis-caption">{p('编者提出的合作方式：人和 AI 可以参与各阶段。它能否形成，取决于工具可及、研究资源和学术评价，而不只取决于模型能解多少题。','A proposed practice in which people and AI participate across stages. Access, research resources and academic incentives matter alongside model capability.')}</p>
</figure>}
{type === 'memory-handoff' && <figure class="analysis-figure memory-handoff">
 <figcaption><p class="kicker">COMPACTION / WHAT SURVIVES?</p><h5><Issue003HeadingText text={p('同一句要求，怎样在摘要里丢掉一半？','How does a summary lose half of a request?')} lang={lang}/></h5></figcaption>
 <blockquote class="original-instruction"><span class="diagram-label">{p('用户原话','ORIGINAL REQUEST')}</span><p>{p('“整理成中英双语周刊，先给我预览。”','“Make this a bilingual Chinese–English issue and show me a preview first.”')}</p></blockquote>
 <div class="handoff-fork" aria-hidden="true"><span>↓</span><span>↓</span></div>
 <div class="handoff-comparison">
  <div class="handoff-loss"><span class="diagram-label">{p('压缩得过头','LOSSY SUMMARY')}</span><p class="summary-sample">{p('整理一份周刊。','Prepare a weekly issue.')}</p><ul><li>{p('任务还在','Task retained')}</li><li class="lost">{p('中英双语：丢失','Bilingual requirement: lost')}</li><li class="lost">{p('先给预览：丢失','Preview first: lost')}</li></ul></div>
  <div class="handoff-useful"><span class="diagram-label">{p('能接着工作的交接','USEFUL HANDOFF')}</span><p class="summary-sample">{p('整理中英双语周刊；下一步交付预览。','Prepare both languages; deliver a preview next.')}</p><ul><li>{p('目标与语言保留','Goal and languages retained')}</li><li>{p('交付顺序保留','Delivery order retained')}</li><li>{p('附上草稿位置与待办','Keep draft location and remaining work')}</li></ul></div>
 </div>
 <p class="analysis-caption">{p('编者任务示例，不是 Pi 的实测输出。摘要质量应看接手者能否继续正确工作，而不只看字数缩短了多少。','Editorial task example, not measured Pi output. Judge a summary by whether work can continue correctly, as well as by its length.')}</p>
</figure>}
{type === 'continuity-records' && <figure class="analysis-figure continuity-records">
 <figcaption><p class="kicker">RECOVERY / TWO KINDS OF MEMORY</p><h5><Issue003HeadingText text={p('恢复工作，需要同时记得目标和已经发生的事','Resuming needs both the goal and a record of what happened')} lang={lang}/></h5></figcaption>
 <div class="recovery-records">
  <section><span class="record-tab">A / {p('语义记录','TASK RECORD')}</span><h6><Issue003HeadingText text={p('接下来要完成什么','What remains to be done')} lang={lang}/></h6><dl><div><dt>{p('目标','Goal')}</dt><dd>{p('整理中英双语周刊','Prepare both language editions')}</dd></div><div><dt>{p('交付','Delivery')}</dt><dd>{p('先交付预览','Preview first')}</dd></div><div><dt>{p('待办','Next')}</dt><dd>{p('检查配图与英文版','Review figures and English text')}</dd></div></dl></section>
  <section><span class="record-tab">B / {p('执行记录','EXECUTION RECORD')}</span><h6><Issue003HeadingText text={p('哪些动作已经完成','Which actions have completed')} lang={lang}/></h6><dl><div><dt>{p('产物','Artifact')}</dt><dd>{p('已保存的草稿版本','Saved draft version')}</dd></div><div><dt>{p('调用','Call')}</dt><dd>{p('工具参数与任务标识','Tool inputs and task identifier')}</dd></div><div><dt>{p('状态','State')}</dt><dd>{p('已完成 / 未完成 / 结果待确认','Completed / pending / outcome unknown')}</dd></div></dl></section>
 </div>
 <div class="record-merge"><span aria-hidden="true">↘</span><span aria-hidden="true">↙</span></div>
 <div class="recovery-decision"><strong>{p('从已确认的状态继续','Continue from confirmed state')}</strong><p>{p('回执不明的外部动作，先查询结果；已经完成的动作，避免重复。','For uncertain external actions, inspect the outcome; avoid repeating completed actions.')}</p></div>
 <p class="analysis-caption">{p('编者应用示例。任务摘要与持久化执行记录解决不同问题，需要应用层把它们接在一起。','Editorial application example. Summaries and durable execution records solve different problems; application logic must connect them.')}</p>
</figure>}
{type === 'evidence-branches' && <figure class="analysis-figure evidence-branches">
 <figcaption><p class="kicker">EVIDENCE / COUNT SOURCES, NOT VOICES</p><h5><Issue003HeadingText text={p('三个 Agent 同意，可能只代表一个来源','Three agreeing agents may still represent one source')} lang={lang}/></h5></figcaption>
 <div class="evidence-comparison">
  <section><h6><Issue003HeadingText text={p('重复同一条消息','Repeating one report')} lang={lang}/></h6><div class="evidence-origin"><span>{p('一篇二手报道','One secondary report')}</span></div><div class="source-fan" aria-hidden="true"><span>↙</span><span>↓</span><span>↘</span></div><div class="evidence-agents"><span>Agent A</span><span>Agent B</span><span>Agent C</span></div><div class="source-fan" aria-hidden="true"><span>↘</span><span>↓</span><span>↙</span></div><p class="evidence-outcome">{p('表述一致，证据没有增加。','Agreement has not added evidence.')}</p></section>
  <section><h6><Issue003HeadingText text={p('分别核对不同材料','Check different primary materials')} lang={lang}/></h6><div class="evidence-primary"><span>{p('发布说明','Release')}</span><span>{p('修订记录','Revisions')}</span><span>{p('反对声明','Objections')}</span></div><div class="source-fan" aria-hidden="true"><span>↓</span><span>↓</span><span>↓</span></div><div class="evidence-agents"><span>Agent A</span><span>Agent B</span><span>Agent C</span></div><div class="source-fan" aria-hidden="true"><span>↘</span><span>↓</span><span>↙</span></div><p class="evidence-outcome">{p('把可核对的依据带进同一个结论。','Bring traceable evidence into the synthesis.')}</p></section>
 </div>
 <p class="analysis-caption">{p('用本期调研做的任务示意，不是 PANDA 论文的实验结果。来源更多仍不保证结论正确，但让检查分歧成为可能。','An editorial research example, not a PANDA experiment. More sources do not guarantee correctness, but make disagreements inspectable.')}</p>
</figure>}
