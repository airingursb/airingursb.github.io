---
import type { AIWeeklyIssue, WeeklyLocale } from '../../../data/ai-weekly';

interface Props { issue: AIWeeklyIssue; lang: WeeklyLocale }
const { issue, lang } = Astro.props;
---

{issue.title[lang].map((phrase, index) => <Fragment>{index > 0 ? ' ' : ''}<span class:list={{ 'ai-weekly-title-phrase': lang === 'zh' }}>{phrase}</span></Fragment>)}
