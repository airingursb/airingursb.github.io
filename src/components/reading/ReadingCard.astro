---
import { Image } from 'astro:assets';
import type { ReadingItem } from '../../lib/reading';
import { localizeReadingItem, readingDate, readingMonth, readingSourceLabel } from '../../lib/reading';

interface Props {
  item: ReadingItem;
  eager?: boolean;
  lang?: 'zh' | 'en';
  position?: number;
  surface?: 'list' | 'home';
}

const { item: rawItem, eager = false, lang = 'zh', position = 0, surface = 'list' } = Astro.props;
const item = localizeReadingItem(rawItem, lang);
const detailHref = `${lang === 'en' ? '/en' : ''}/reading/${item.slug}/`;
---

<article
  class="reading-card"
  data-reading-card
  data-source={item.source}
  data-month={readingMonth(item.saved_at)}
>
  <a
    class="reading-card-cover"
    href={detailHref}
    aria-label={item.title}
    data-umami-event="reading-card-open"
    data-umami-event-slug={item.slug}
    data-umami-event-source={item.source}
    data-umami-event-surface={surface}
    data-umami-event-position={position}
    data-umami-event-lang={lang}
  >
    <Image
      src={item.cover_url}
      alt={item.title}
      width={720}
      height={480}
      widths={[360, 720]}
      sizes="(max-width: 720px) 100vw, (max-width: 1080px) 50vw, 360px"
      format="webp"
      quality={75}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </a>
  <h2 class="reading-card-title">
    <a
      href={detailHref}
      data-umami-event="reading-card-open"
      data-umami-event-slug={item.slug}
      data-umami-event-source={item.source}
      data-umami-event-surface={surface}
      data-umami-event-position={position}
      data-umami-event-lang={lang}
    >{item.title}</a>
  </h2>
  <div class="reading-card-meta">
    <span class="reading-source">{readingSourceLabel(item.source, lang)}</span>
    <time datetime={item.saved_at}>{readingDate(item.saved_at, lang === 'en' ? 'en-US' : 'zh-CN')}</time>
    {item.author && <span class="reading-author">{item.author}</span>}
    {item.original_url && (
      <a
        class="reading-original"
        href={item.original_url}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="reading-source-open"
        data-umami-event-slug={item.slug}
        data-umami-event-source={item.source}
        data-umami-event-surface="card"
        data-umami-event-lang={lang}
      >
        {lang === 'en' ? 'Source ↗' : '原文 ↗'}
      </a>
    )}
  </div>
</article>
