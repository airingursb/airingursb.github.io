---
import { resolveReadingCoverImage, type ReadingCoverImage } from '../../lib/reading-cover-image';

interface Props {
  image?: ReadingCoverImage | null;
  src?: string;
  alt: string;
  label?: string;
  width: number;
  height: number;
  widths?: number[];
  sizes?: string;
  format?: 'webp' | 'jpeg' | 'png' | 'avif';
  quality?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'auto' | 'sync';
  priority?: boolean;
}

const {
  image: provided,
  src,
  alt,
  label,
  width,
  height,
  widths,
  sizes,
  format = 'webp',
  quality = 75,
  loading,
  fetchpriority,
  decoding,
  priority = false,
} = Astro.props;

const image = provided !== undefined
  ? provided
  : src && label
    ? await resolveReadingCoverImage(src, label, { width, height, widths, format, quality })
    : null;
---

{image && (
  <img
    src={image.src}
    srcset={image.srcSet?.attribute || undefined}
    sizes={sizes}
    width={image.attributes.width ?? width}
    height={image.attributes.height ?? height}
    alt={alt}
    loading={priority ? 'eager' : loading}
    fetchpriority={priority ? 'high' : fetchpriority}
    decoding={decoding}
  />
)}
