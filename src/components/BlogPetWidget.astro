---
/**
 * BlogPetWidget — SHU-818 oil-motion circular look.
 * Single 360° sprite atlas, pointer angle maps to frame via setDirection.
 */
---

<aside
  id="blog-pet"
  class="blog-pet"
  hidden
  aria-label="博客水墨熊猫桌宠"
>
  <button
    type="button"
    class="blog-pet-dismiss"
    id="blogPetDismiss"
    aria-label="隐藏桌宠"
    title="隐藏"
  >×</button>
  <canvas
    id="blogPetCanvas"
    class="blog-pet-canvas"
    width="288"
    height="288"
    aria-hidden="true"
  ></canvas>
  <img
    class="blog-pet-fallback"
    src="/oil-motion/blog-pet/poster.png"
    alt=""
    width="144"
    height="144"
    loading="eager"
    decoding="async"
  />
</aside>

<style>
  .blog-pet {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 80;
    width: 144px;
    height: 144px;
    pointer-events: none;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.18));
  }
  .blog-pet[hidden] {
    display: none !important;
  }
  .blog-pet-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .blog-pet-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    display: none;
  }
  .blog-pet.is-fallback .blog-pet-canvas {
    display: none;
  }
  .blog-pet.is-fallback .blog-pet-fallback {
    display: block;
  }
  .blog-pet-dismiss {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(127, 127, 127, 0.35);
    background: rgba(255, 255, 255, 0.72);
    color: #666;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 2;
    pointer-events: auto;
  }
  .blog-pet:hover .blog-pet-dismiss,
  .blog-pet:focus-within .blog-pet-dismiss {
    opacity: 1;
  }
  @media (max-width: 800px) {
    .blog-pet {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-pet-canvas {
      display: none;
    }
    .blog-pet-fallback {
      display: block;
    }
  }
  @media print {
    .blog-pet {
      display: none !important;
    }
  }
</style>

<script>
  import type { AtlasManifest } from "../lib/blog-pet-animator";
  import {
    createAtlasRenderer,
    createFrameAnimator,
  } from "../lib/blog-pet-animator";
  import { computePointerVector } from "../lib/blog-pet-pointer";

  type CircularManifest = {
    version: number;
    type: "blog-pet-circular";
    frameCount: number;
    fps: number;
    circular: boolean;
    initialFrame?: number;
    startAngleRadians?: number;
  };

  const STORAGE_KEY = "blog-pet-dismissed";
  const BASE = "/oil-motion/blog-pet/";

  const root = document.getElementById("blog-pet");
  const canvas = document.getElementById("blogPetCanvas") as HTMLCanvasElement | null;
  const dismiss = document.getElementById("blogPetDismiss");

  if (!root || !canvas || !dismiss) {
    // no-op
  } else if (localStorage.getItem(STORAGE_KEY) === "1") {
    root.remove();
  } else {
    const reduced =
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const boot = async () => {
      root.hidden = false;

      if (reduced) return;

      let site: CircularManifest;
      let atlas: AtlasManifest;
      try {
        const [siteRes, atlasRes] = await Promise.all([
          fetch(`${BASE}manifest.json`),
          fetch(`${BASE}motion.json`),
        ]);
        if (!siteRes.ok || !atlasRes.ok) throw new Error("manifest");
        site = await siteRes.json();
        atlas = await atlasRes.json();
      } catch {
        root.classList.add("is-fallback");
        return;
      }

      const image = new Image();
      image.decoding = "async";
      image.src = `${BASE}${atlas.asset}`;

      try {
        await new Promise<void>((resolve, reject) => {
          image.onload = () => resolve();
          image.onerror = () => reject(new Error("atlas"));
        });
      } catch {
        root.classList.add("is-fallback");
        return;
      }

      const startAngle =
        atlas.startAngleRadians ??
        site.startAngleRadians ??
        -Math.PI * 0.75;
      const initialFrame = atlas.initialFrame ?? site.initialFrame ?? 0;

      const renderer = createAtlasRenderer({ canvas, image, manifest: atlas });
      const animator = createFrameAnimator({
        frameCount: site.frameCount,
        initialFrame,
        circular: true,
        smoothTime: 0.32,
        maxSpeed: 48,
        reducedMotion: false,
        render(frame) {
          renderer.render(frame);
        },
      });

      const onMove = (e: PointerEvent) => {
        const vector = computePointerVector({
          clientX: e.clientX,
          clientY: e.clientY,
          viewportWidth: window.innerWidth,
          viewportHeight: window.innerHeight,
        });
        if (vector.inDeadZone) {
          animator.setTarget(initialFrame);
          return;
        }
        animator.setDirection(vector.dx, vector.dy, startAngle);
      };

      const onResize = () => {
        renderer.resize();
        renderer.render(Math.round(animator.getCurrentFrame()));
      };

      window.addEventListener("pointermove", onMove, { passive: true });
      window.addEventListener("resize", onResize, { passive: true });

      dismiss.addEventListener("click", () => {
        localStorage.setItem(STORAGE_KEY, "1");
        animator.destroy();
        renderer.destroy();
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("resize", onResize);
        root.remove();
      });

      renderer.render(initialFrame);
    };

    void boot();
  }
</script>
