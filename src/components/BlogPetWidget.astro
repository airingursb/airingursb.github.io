---
/**
 * BlogPetWidget — the author's IP panda reading in the corner (desktop only).
 * Gaze: single 360° sprite atlas, pointer angle maps to frame via setDirection.
 * End of article / poke: close and react layers from lib/blog-pet-stage.
 */
interface Props { lang?: "zh" | "en"; }
const { lang = "zh" } = Astro.props;
---

<div
  id="blog-pet"
  class="blog-pet"
  hidden
  aria-label={lang === "en" ? "Poke the panda" : "戳一下熊猫"}
>
  <canvas
    id="blogPetCanvas"
    class="blog-pet-canvas"
    width="288"
    height="288"
    aria-hidden="true"
  ></canvas>
  <img
    class="blog-pet-fallback"
    src="/editorial-motion/ip-panda/gaze/poster.png"
    alt=""
    width="144"
    height="144"
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .blog-pet {
    position: fixed;
    right: 16px;
    /* Sits above the fixed theme switcher (bottom: 24px, ~40px tall) so the
       two never stack on top of each other. */
    bottom: 72px;
    z-index: 80;
    width: 144px;
    height: 144px;
    /* Only opaque pixels take the pointer (.is-hot, set by the hit test). */
    pointer-events: none;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.18));
    outline: none;
  }
  /* Dark mode: a faint light rim keeps the black ears and paws off the page. */
  :global(html:not([data-mode="light"])) .blog-pet {
    filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.35)) drop-shadow(0 0 0.5px rgba(255, 255, 255, 0.3)) drop-shadow(0 6px 14px rgba(0, 0, 0, 0.18));
  }
  .blog-pet[hidden] {
    display: none !important;
  }
  /* !important: global.css sets a custom cursor on * with !important. */
  .blog-pet.is-hot {
    pointer-events: auto;
    cursor: pointer !important;
  }
  .blog-pet[data-pet-interactive]:focus-visible {
    outline: 2px dashed rgba(var(--accent-rgb), 0.7);
    outline-offset: 2px;
    border-radius: 14px;
  }
  .blog-pet-canvas,
  .blog-pet :global(.blog-pet-layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .blog-pet :global(.blog-pet-layer) {
    opacity: 0;
    pointer-events: none;
  }
  .blog-pet :global(.blog-pet-layer.is-on) {
    opacity: 1;
  }
  /* The layers are pixel-aligned with the gaze atlas, so they swap without a fade. */
  .blog-pet.is-layered .blog-pet-canvas {
    opacity: 0;
  }
  /* A poke during the close: a small squash, nothing else. */
  .blog-pet.is-ack canvas {
    animation: blog-pet-ack 0.32s ease-out;
    transform-origin: 50% 88%;
  }
  @keyframes blog-pet-ack {
    35% { transform: scale(0.95, 0.93); }
    70% { transform: scale(1.02); }
  }
  .blog-pet-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    display: none;
  }
  .blog-pet.is-fallback .blog-pet-canvas {
    display: none;
  }
  .blog-pet.is-fallback .blog-pet-fallback {
    display: block;
  }
  /* Article layouts go single-column at 1100px; below that the 144px pet
     would sit on top of the text column (42px overlap at 860px). */
  @media (max-width: 1100px) {
    .blog-pet {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-pet-canvas {
      display: none;
    }
    .blog-pet-fallback {
      display: block;
    }
  }
  @media print {
    .blog-pet {
      display: none !important;
    }
  }
</style>

<script>
  import type { AtlasManifest } from "../lib/blog-pet-animator";
  import {
    createAtlasRenderer,
    createFrameAnimator,
  } from "../lib/blog-pet-animator";
  import { computePointerVector } from "../lib/blog-pet-pointer";
  import { createBlogPetStage, createBlogPetStill } from "../lib/blog-pet-stage";
  import { IP_PANDA_BASE } from "../lib/blog-pet-motion";

  const BASE = `${IP_PANDA_BASE}gaze/`;

  const root = document.getElementById("blog-pet");
  const canvas = document.querySelector<HTMLCanvasElement>("#blogPetCanvas");
  const still = root?.querySelector<HTMLImageElement>(".blog-pet-fallback");

  if (root && canvas && still) {
    let cleanup = () => {};
    document.addEventListener("astro:before-swap", () => cleanup(), { once: true });

    const reduced =
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const desktop = window.matchMedia("(min-width: 1101px)"); // matches the CSS hide breakpoint

    const fallback = () => {
      root.classList.add("is-fallback");
      cleanup = createBlogPetStill(root, still, `${BASE}poster.png`);
    };

    const boot = async () => {
      if (!desktop.matches || !root.isConnected) return;
      root.hidden = false;

      // Reduced motion: a still that swaps to the closed book at the end; no poking.
      if (reduced) {
        fallback();
        return;
      }

      let atlas: AtlasManifest;
      try {
        const atlasRes = await fetch(`${BASE}motion.json`);
        if (!atlasRes.ok) throw new Error("manifest");
        atlas = await atlasRes.json();
        if (
          atlas.parameterSpace !== "circular" ||
          !atlas.circular ||
          atlas.frameCount < 2
        ) {
          throw new Error("invalid circular atlas");
        }
      } catch {
        fallback();
        return;
      }

      const image = new Image();
      image.decoding = "async";
      image.src = `${BASE}${atlas.asset}`;

      try {
        await image.decode();
      } catch {
        fallback();
        return;
      }

      if (!root.isConnected) return;

      const startAngle =
        atlas.startAngleRadians ?? -Math.PI * 0.75;
      const initialFrame = atlas.initialFrame ?? 0;

      const renderer = createAtlasRenderer({ canvas, image, manifest: atlas });
      const animator = createFrameAnimator({
        frameCount: atlas.frameCount,
        initialFrame,
        circular: true,
        reducedMotion: false,
        render(frame) {
          renderer.render(frame);
        },
      });

      const onMove = (e: PointerEvent) => {
        // petHold: the stage owns the gaze while it turns, closes or reacts.
        if (document.hidden || root.dataset.petHold) return;
        const rect = canvas.getBoundingClientRect();
        const vector = computePointerVector({
          clientX: e.clientX,
          clientY: e.clientY,
          originX: rect.left + rect.width / 2,
          originY: rect.top + rect.height / 2,
          deadZone: Math.min(rect.width, rect.height) * 0.08,
        });
        if (vector.inDeadZone) return;
        animator.setDirection(vector.dx, vector.dy, startAngle);
      };

      const onResize = () => {
        renderer.resize();
        renderer.render(Math.round(animator.getCurrentFrame()));
      };

      window.addEventListener("pointermove", onMove, { passive: true });
      window.addEventListener("resize", onResize, { passive: true });

      renderer.render(initialFrame);
      const disposeStage = createBlogPetStage({ root, canvas, image, atlas, animator, startAngle });

      cleanup = () => {
        disposeStage();
        animator.destroy();
        renderer.destroy();
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("resize", onResize);
      };
    };

    desktop.addEventListener("change", () => {
      if (desktop.matches && root.hidden) void boot();
    });
    void boot();
  }
</script>
