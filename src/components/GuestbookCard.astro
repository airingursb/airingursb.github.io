---
// src/components/GuestbookCard.astro
//
// Homepage guestbook as `git log --graph` (design: guestbook r3, direction C).
// main is the guestbook itself, every post is a coloured branch, every root
// comment across the site is a commit (short hash from its id), and the
// latest reply forks off its commit as a dashed side commit. The form is
// `$ git commit -m "…"` with `--author=` and an optional email; a sent
// message shows `[pending abc1234]` and a hollow `(HEAD -> pending)` dot on
// top until the feed carries it (remembered across reloads).
//
// Data: GET /api/comments/recent (keyset cursor; total / branches /
// latest_reply / is_author, never emails) and POST /api/comments with
// post_slug "guestbook". Behaviour lives in src/scripts/guestbook.ts, the
// graph model in src/lib/guestbook-graph.ts.
interface Props {
  /** slug → { zh, en } post / note titles (window.__GB_TITLES__) */
  titles: Record<string, { zh?: string; en?: string }>;
}
const { titles } = Astro.props;
// `astro dev` reads through the read-only /__chat proxy (astro.config.mjs):
// chat.ursb.me only allows ursb.me origins.
const api = import.meta.env.DEV ? '/__chat' : 'https://chat.ursb.me';
---
<div class="card card-guestbook" id="guestbook" data-gb data-api={api}>
  <div class="section-title-row">
    <div class="section-title" id="gbTitle" data-i18n="sec_guestbook">Guestbook</div>
    <!-- The feed is every post's latest comments, not only guestbook messages. -->
    <span class="gb-scope" data-i18n="gb_scope">latest across the site</span>
  </div>
  <div class="feed-head gg-head">
    <span class="feed-head-cmd"><span class="prompt">$</span> git log --graph --all --oneline</span>
    <span class="feed-head-total" data-gb-total><strong>—</strong></span>
  </div>
  <div class="gg-list" data-gb-list aria-labelledby="gbTitle" aria-busy="true">
    <div class="gg-term" role="status"><span class="prompt">$</span> git fetch origin<br><span class="m">remote: Counting objects: <span class="dots"></span></span></div>
  </div>
  <hr class="gb-divider">
  <form class="gg-form" data-gb-form novalidate>
    <div class="gb-input-row">
      <span class="gb-prompt" aria-hidden="true">$ git commit -m&nbsp;</span><span class="q" aria-hidden="true">"</span>
      <input type="text" class="gb-input" id="gbMessage" name="m" maxlength="200" required
        data-i18n-placeholder="gb_msg_placeholder" placeholder="Type your message here..."
        aria-label="Message" aria-describedby="gbStatus" autocomplete="off">
      <span class="q" aria-hidden="true">"</span>
      <button type="submit" class="gb-submit" data-gb-submit aria-label="Send message">↵</button>
    </div>
    <div class="gbf-id">
      <label for="gbName"><span>--author=</span><input type="text" id="gbName" name="n" maxlength="20" autocomplete="nickname" placeholder="anonymous"></label>
      <label for="gbEmail" class="gbf-mail"><span class="lt" aria-hidden="true">&lt;</span><input type="email" id="gbEmail" name="e" maxlength="100" autocomplete="email" placeholder="email (optional, never shown)" aria-label="Email"><span class="lt" aria-hidden="true">&gt;</span></label>
    </div>
    <p class="gbf-status" id="gbStatus" role="status" aria-live="polite"></p>
    <div class="gg-out" data-gb-out aria-live="polite"></div>
  </form>
</div>

<script is:inline define:vars={{ titles }}>
  window.__GB_TITLES__ = titles;
</script>

<script>
  import { initGuestbook } from '../scripts/guestbook';

  initGuestbook();
</script>

<style is:global>
  /* Branch colours: the accent is main; posts cycle through six hues. */
  .card-guestbook {
    --g1: #f87171; --g2: #60a5fa; --g3: #fbbf24; --g4: #c084fc; --g5: #22d3ee; --g6: #fb923c; --hash: #fbbf24;
    container: gb / inline-size;
  }
  [data-mode='light'] .card-guestbook {
    --g1: #dc2626; --g2: #2563eb; --g3: #b45309; --g4: #9333ea; --g5: #0e7490; --g6: #c2410c; --hash: #a16207;
  }
  .card-guestbook .gb-scope { font-size: 11px; color: var(--c-text-muted); letter-spacing: 0.3px; }
  .card-guestbook .gg-head { margin: -4px 0 var(--space-4); }
  .card-guestbook .gg-head .feed-head-total { flex: none; white-space: nowrap; }
  .card-guestbook a { text-decoration: none; }
  .card-guestbook :is(a, button, input, [tabindex]):focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  .card-guestbook .gb-input:focus-visible { outline: none; }

  .card-guestbook .dim { color: var(--c-text-dim); }
  .card-guestbook .src { color: var(--c-text-dim); transition: color 0.2s; }
  .card-guestbook .src:hover { color: var(--accent); }
  .card-guestbook .src .t { border-bottom: 1px dotted rgba(var(--c-overlay-rgb), 0.22); }
  .card-guestbook .more { padding: 0; border: 0; background: none; color: var(--c-text-dim); font: inherit; font-size: 11px; cursor: pointer; }
  .card-guestbook .more:hover { color: var(--accent); }
  .card-guestbook .txtbtn { padding: 0; border: 0; background: none; font: inherit; color: var(--c-text); cursor: pointer; border-bottom: 1px dotted rgba(var(--c-overlay-rgb), 0.35); }
  .card-guestbook .txtbtn:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .card-guestbook .dots::after { content: '...'; display: inline-block; width: 3ch; text-align: left; overflow: hidden; vertical-align: bottom; animation: gg-dots 1.2s steps(4) infinite; }
  @keyframes gg-dots { from { width: 0; } to { width: 3ch; } }
  .card-guestbook .fresh { animation: gg-fade 0.45s ease-out both; }
  @keyframes gg-fade { from { opacity: 0; transform: translateY(-6px); } }

  /* The graph: one absolutely positioned SVG drawn from each row's real height. */
  .card-guestbook .gg { position: relative; min-width: 0; }
  .card-guestbook .gg svg.gg-lines { position: absolute; left: 0; top: 0; overflow: visible; pointer-events: none; }
  .card-guestbook .gg-row { position: relative; padding: 6px 0 8px var(--gw, 60px); min-width: 0; font-size: 12px; line-height: 1.6; }
  .card-guestbook .gg-row:focus { outline: none; }
  .card-guestbook .gg-l1 { display: flex; align-items: baseline; gap: 8px; min-width: 0; white-space: nowrap; }
  .card-guestbook .gg-hash { color: var(--hash); flex: none; font-variant-numeric: tabular-nums; }
  .card-guestbook .gg-deco { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--lc); }
  .card-guestbook .gg-deco b { font-weight: 700; }
  .card-guestbook .gg-fill { flex: 1 1 0; }
  .card-guestbook .gg-src { flex: 0 1 auto; min-width: 0; max-width: 18em; overflow: hidden; text-overflow: ellipsis; }
  .card-guestbook .gg-time { flex: none; color: var(--c-text-dim); }
  .card-guestbook .gg-msg { margin: 1px 0 0; color: var(--c-text); font-size: 13px; overflow-wrap: anywhere; white-space: pre-line; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-guestbook .gg-msg.open { display: block; }
  .card-guestbook .gg-msg .au { color: var(--c-text-muted); }
  .card-guestbook .gg-q { color: var(--c-text-dim); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-guestbook .gg-q::before { content: '> '; }
  .card-guestbook .gg-row.head .gg-msg { font-size: 14px; }
  .card-guestbook .gg-row.reply .gg-msg { color: var(--c-text-muted); font-size: 12.5px; }
  .card-guestbook .gg-row.mine .gg-msg { color: var(--c-text-muted); }
  .card-guestbook .gg-pend { color: var(--accent); }
  .card-guestbook .gg-sub { display: none; font-size: 11px; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Loading / failed / empty read as terminal output. */
  .card-guestbook .gg-term { font-size: 12px; line-height: 1.8; color: var(--c-text-dim); overflow-wrap: anywhere; padding: 4px 0; }
  .card-guestbook .gg-term .prompt { color: var(--accent); }
  .card-guestbook .gg-term .m { color: var(--c-text-muted); }
  .card-guestbook .gg-term .bad { color: var(--g1); }
  .card-guestbook .gg-term + .gg { margin-top: 8px; }
  .card-guestbook .gg-bar { display: inline-block; width: 18ch; max-width: 40%; height: 0.7em; vertical-align: -1px; background: rgba(var(--c-overlay-rgb), 0.08); position: relative; overflow: hidden; }
  .card-guestbook .gg-bar i { position: absolute; inset: 0 auto 0 0; width: 87%; background: var(--accent); opacity: 0.7; animation: gg-bar 1.6s ease-in-out infinite; }
  @keyframes gg-bar { from { width: 8%; } to { width: 92%; } }
  .card-guestbook .gg-more { display: block; margin-top: 6px; padding: 4px 0 0 var(--gw, 60px); border: 0; background: none; font: inherit; font-size: 12px; color: var(--c-text-muted); cursor: pointer; text-align: left; }
  .card-guestbook .gg-more:hover { color: var(--accent); }
  .card-guestbook .gg-more .prompt { color: var(--accent); }
  .card-guestbook .gg-more:disabled { cursor: default; opacity: 0.6; }

  /* Form: $ git commit -m "…"  /  --author= name  <email> */
  .card-guestbook .gg-form .gb-input-row { gap: 0; min-width: 0; }
  .card-guestbook .gg-form .gb-prompt { padding-left: 2px; white-space: nowrap; }
  .card-guestbook .gg-form .q { color: var(--c-text-muted); font-size: 13px; flex: none; }
  .card-guestbook .gg-form .gb-input { padding: 0 2px; }
  .card-guestbook .gg-form .gb-submit { margin-left: 8px; }
  .card-guestbook .gg-form .gb-input-row:has([aria-invalid='true']) { box-shadow: 0 0 0 1px #ef4444; }
  .card-guestbook .gbf-id { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; margin-top: 6px; padding-left: 2px; font-size: 11px; color: var(--c-text-dim); min-width: 0; }
  .card-guestbook .gbf-id label { display: inline-flex; align-items: baseline; gap: 6px; min-width: 0; }
  .card-guestbook .gbf-id .gbf-mail { gap: 0; }
  .card-guestbook .gbf-id input { width: 12ch; padding: 1px 0; border: 0; border-bottom: 1px dotted rgba(var(--c-overlay-rgb), 0.22); background: transparent; color: var(--c-text-muted); font: inherit; font-size: 11px; outline: none; min-width: 0; border-radius: 0; }
  .card-guestbook .gbf-id input[type='email'] { width: 30ch; }
  .card-guestbook .gbf-id input:focus { border-bottom-color: var(--accent); color: var(--c-text); }
  .card-guestbook .gbf-id input::placeholder { color: var(--c-text-dim); }
  .card-guestbook .gbf-id input[aria-invalid='true'] { border-bottom-color: #ef4444; }
  .card-guestbook .gbf-status { margin: 8px 0 0; font-size: 12px; color: var(--c-text-muted); padding-left: 2px; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.7; }
  .card-guestbook .gbf-status:empty { display: none; }
  .card-guestbook .gbf-status.err { color: #ef4444; }
  [data-mode='light'] .card-guestbook .gbf-status.err { color: color-mix(in srgb, #ef4444 75%, var(--c-text)); }
  .card-guestbook .gg-out { margin-top: 8px; font-size: 12px; line-height: 1.7; color: var(--c-text-muted); white-space: pre-wrap; overflow-wrap: anywhere; }
  .card-guestbook .gg-out:empty { display: none; }
  .card-guestbook .gg-out .h { color: var(--hash); }
  .card-guestbook .gg-out .acc { color: var(--accent); }

  @container gb (max-width: 520px) {
    .card-guestbook .gg-src { display: none; }
    .card-guestbook .gg-row .gg-sub { display: block; }
  }
  @container gb (max-width: 460px) {
    .card-guestbook .gg-head { flex-wrap: wrap; row-gap: 2px; }
    .card-guestbook .gg-head .feed-head-cmd { font-size: 11px; flex-basis: 100%; }
    .card-guestbook .gbf-id label { flex: 1 1 100%; }
    .card-guestbook .gbf-id input,
    .card-guestbook .gbf-id input[type='email'] { flex: 1; width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-guestbook *, .card-guestbook *::before, .card-guestbook *::after { animation: none !important; transition: none !important; }
  }
</style>
