---
// Renders a note title with the highlight spans taken from its immersive
// page hero (see titleParts in src/lib/field-notes.ts).
import type { TitlePart } from '../../lib/field-notes';
interface Props { parts: TitlePart[] }
const { parts } = Astro.props;
---
{parts.map((p) => (p.tone ? <span class={`fn-hl-${p.tone}`}>{p.text}</span> : p.text))}
