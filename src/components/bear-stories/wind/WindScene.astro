---
import { windCopy } from './copy';
import BearKeepsakeTable from '../../bear-study/BearKeepsakeTable.astro';
import './wind.css';
interface Props { readonly lang?: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props;
const copy = windCopy[lang];
---
<bear-wind data-lang={lang} data-clip="gust" data-frame="0" data-resting="false">
  <img class="wind-poster" src="/bear-stories/wind/gust-poster.png" width="320" height="192" alt="" />
  <canvas class="wind-canvas" width="320" height="192" aria-hidden="true" hidden></canvas>
  <button class="wind-hotspot wind-window" type="button" data-wind-choice="window" aria-label={copy.close} aria-pressed="false"></button>
  <button class="wind-hotspot wind-paperweight" type="button" data-wind-choice="paperweight" aria-label={copy.paperweight}></button>
  <span class="wind-live" aria-live="polite" aria-atomic="true"></span>
  <BearKeepsakeTable lang={lang} />
</bear-wind>
<script>
  import { BearWind } from './player';
  if (!customElements.get('bear-wind')) customElements.define('bear-wind', BearWind);
</script>
