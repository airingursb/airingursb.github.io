<span class="search-delight" data-search-delight data-editorial-actor="/blog-delights/search/manifest.json" data-actor-rendering="pixelated" data-actor-state="poster" aria-hidden="true">
  <img data-actor-poster src="/blog-delights/search/poster.webp" alt="" width="160" height="192" decoding="async" />
  <canvas data-actor-canvas width="160" height="192" hidden></canvas>
</span>

<script>
  import { mountSearchDelight } from './controller';
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountSearchDelight, { once: true });
  else mountSearchDelight();
  window.addEventListener('pageshow', event => { if (event.persisted) mountSearchDelight(); });
</script>

<style>
  .search-delight { display: block; flex: 0 0 96px; position: relative; width: 96px; aspect-ratio: 5 / 6; pointer-events: none; }
  img, canvas { display: block; width: 100%; height: 100%; position: absolute; inset: 0; object-fit: contain; image-rendering: pixelated; }
  [hidden] { display: none; }
  @media (max-width: 768px) { .search-delight { width: 72px; flex-basis: 72px; } }
</style>
