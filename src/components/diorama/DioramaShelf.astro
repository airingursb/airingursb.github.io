---
import { dioramas, dioramaUrl } from '../../data/dioramas';
const recent = dioramas.slice(0, 8);
---
{recent.length > 0 && <section aria-labelledby="diorama-shelf-title" id="diorama-shelf">
  <div class="section-title-row">
    <h2 class="section-title" id="diorama-shelf-title" data-i18n="sec_diorama">日常箱庭</h2>
    <a class="photos-strip-more" href="/diorama/" data-i18n="diorama_view_all">查看全部 →</a>
  </div>
  <div class="comics-strip" role="list">
    {recent.map(scene => <a class="comics-strip-item" role="listitem" href={dioramaUrl(scene)} aria-labelledby={`diorama-title-${scene.slug}`}>
      <div class="comics-strip-thumb diorama-thumb">
        <img src={scene.cover} alt={scene.coverAlt} data-i18n-alt={`diorama_${scene.slug}_alt`} width="800" height="450" loading="lazy" />
      </div>
      <div class="comics-strip-cap">
        <span class="comics-strip-title" id={`diorama-title-${scene.slug}`} data-i18n={`diorama_${scene.slug}_title`}>{scene.title}</span>
        <time class="comics-strip-issue" datetime={scene.date}>{scene.date.replaceAll('-', '.')}</time>
      </div>
    </a>)}
  </div>
</section>}
<style>
  h2 { margin:0; }
  .diorama-thumb { aspect-ratio:16/9; }
  :global(html[lang='en']) .comics-strip-title { white-space:normal; line-height:1.5; min-height:3em; text-wrap:pretty; }
  a:focus-visible { outline:2px solid var(--accent); outline-offset:-2px; border-radius:6px; }
  @media(prefers-reduced-motion:reduce) { .diorama-thumb { transition:none; } }
</style>
