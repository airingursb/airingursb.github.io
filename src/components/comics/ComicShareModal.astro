---
// src/components/comics/ComicShareModal.astro
// Share trigger + the site-wide native share dialog for a comic issue.
// The preview reuses the exact strip URL the page already shows, so it is
// cached by the time the dialog opens; issue number and title sit below the
// image as plain text instead of overlapping the panels.
import ShareDialog from '../ShareDialog.astro';
import type { Comic } from '../../lib/comics';
import { formatDisplayDate } from '../../lib/display-date';

interface Props {
  comic: Comic;
  lang: 'zh' | 'en';
  /** Optimised strip image already used on the page. */
  preview?: { src: string; srcset?: string; width?: number; height?: number };
}

const { comic, lang, preview } = Astro.props;

const slugBase = lang === 'en' ? '/en/comics' : '/comics';
const fullUrl = new URL(`${slugBase}/${comic.issue_number}/`, 'https://ursb.me').href;
const title = comic.title[lang] || comic.title.zh;
const issueLabel = `No. ${String(comic.issue_number).padStart(2, '0')}`;
const dateStr = formatDisplayDate(comic.published_at || comic.created_at, lang);
const shareText = lang === 'en'
  ? `${issueLabel} · ${title} — Comics by Airing`
  : `${issueLabel} · ${title} — Airing 的四格`;
const altText = comic.panels?.alt?.[lang] || comic.panels?.alt?.zh || title;
const original = comic.panels?.original || comic.panels?.url || '';
const extension = original.split('?')[0].split('.').pop() || 'png';
const labels = lang === 'en'
  ? { share: 'Share this issue', heading: 'Share this strip', kicker: 'COMICS / PASS IT ON', save: 'Save strip' }
  : { share: '分享这一期', heading: '分享这一格', kicker: '四格 / 转给朋友', save: '保存漫画' };
const dialogId = 'comic-share';
---

<button type="button" class="comic-share-btn" data-share-open={dialogId} aria-label={labels.share} title={labels.share}>
  {/* Tabler TbShare */}
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="6" cy="12" r="3" />
    <circle cx="18" cy="6" r="3" />
    <circle cx="18" cy="18" r="3" />
    <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
    <line x1="8.6" y1="10.5" x2="15.4" y2="6.5" />
  </svg>
</button>

<ShareDialog
  id={dialogId}
  lang={lang}
  shareTitle={shareText}
  shareUrl={fullUrl}
  heading={labels.heading}
  kicker={labels.kicker}
  caption={`${issueLabel} · ${title} · ${dateStr}`}
  download={original ? { href: original, filename: `airing-comics-${comic.issue_number}.${extension}`, label: labels.save } : undefined}
  openEvent="comic-share"
  actionEvent="comic-share-action"
  eventData={{ issue: comic.issue_number }}
>
  {preview && (
    <img
      slot="preview"
      data-share-reuse=".comic-detail .strip-img-full"
      src={preview.src}
      srcset={preview.srcset}
      sizes="(max-width: 600px) calc(100vw - 58px), 486px"
      width={preview.width}
      height={preview.height}
      alt={altText}
      loading="lazy"
      decoding="async"
    />
  )}
</ShareDialog>
