---
import './window.css';
---
<bear-window>
  <button type="button" class="bear-window-button" aria-label="拉上小熊的窗帘" aria-pressed="false" disabled>
    <span class="bear-window-art" aria-hidden="true">
      <img class="bear-window-day" src="/bear-study/window-day.webp" alt="" width="148" height="173" decoding="async" />
      <img class="bear-window-night" src="/bear-study/window-night.webp" alt="" width="148" height="173" decoding="async" />
      <span class="bear-window-glass">
        <span class="bear-window-cloud"></span>
        <span class="bear-window-rain"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="bear-window-splashes"><i></i><i></i><i></i></span>
        <span class="bear-window-drying"><i></i><i></i><i></i></span>
      </span>
      <span class="bear-window-curtain"></span>
    </span>
  </button>
</bear-window>

<script>
  import { BearWindow } from './window';
  if (!customElements.get('bear-window')) customElements.define('bear-window', BearWindow);
</script>
