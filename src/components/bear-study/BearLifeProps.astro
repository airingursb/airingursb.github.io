---
import type { LifeContent } from './life';
interface Props { post: LifeContent | null; photo: LifeContent | null }
const { post, photo } = Astro.props;
---
<button class="bear-lamp" data-action="lamp" aria-label="打开小熊的台灯" aria-pressed="false" type="button" hidden data-lamp-control>
  <svg viewBox="0 0 32 58" aria-hidden="true" shape-rendering="crispEdges">
    <path class="prop-outline" d="M12 4h13v3h3v10H9V7h3ZM15 17h4v30h8v4H7v-4h8Z" />
    <path class="prop-sage" d="M13 7h11v3h2v5H11v-5h2Z" />
    <path class="prop-light" d="M11 15h15v3H11Z" />
    <path class="prop-sage" d="M9 47h16v2H9Z" />
  </svg>
</button>
<div class="bear-lamp-glow" aria-hidden="true"></div>
<a class="bear-book-link" data-book href="/reading/" aria-label="看看小熊书桌上的阅读收藏" hidden></a>
<svg class="bear-stool" viewBox="0 0 80 24" aria-hidden="true" shape-rendering="crispEdges">
  <path class="prop-outline" d="M2 2h76v6H2Zm7 6h5v15H9Zm57 0h5v15h-5Z" />
  <path class="prop-wood" d="M4 3h72v3H4Zm7 5h2v13h-2Zm57 0h2v13h-2Z" />
</svg>
{post && <a class="bear-keepsake bear-letter" data-keepsake="letter" data-published-at={post.publishedAt} href={post.href} aria-label={`读新文章：${post.title}`} hidden>
  <svg viewBox="0 0 32 28" aria-hidden="true" shape-rendering="crispEdges">
    <path class="prop-outline" d="M3 5h26v17H3Z" />
    <path class="prop-cream" d="M5 7h22v13H5Z" />
    <path class="prop-sage" d="M5 7h3v2h3v2h3v2h4v-2h3V9h3V7h3v2h-3v2h-3v2h-3v2h-4v-2h-3v-2H8V9H5Z" />
    <path class="prop-outline" d="M14 12h4v4h-4Z" />
    <path class="prop-light" d="M15 13h2v2h-2Z" />
  </svg>
</a>}
{photo && <a class="bear-keepsake bear-camera" data-keepsake="camera" data-published-at={photo.publishedAt} href={photo.href} aria-label={`看新旅行照片：${photo.title}`} hidden>
  <svg viewBox="0 0 32 28" aria-hidden="true" shape-rendering="crispEdges">
    <path class="prop-outline" d="M6 4h20v3h3v16H3V7h3Zm2 0v3h16V4Z" />
    <path class="prop-camera" d="M5 9h22v12H5Z" />
    <path class="prop-cream" d="M8 7h5v2H8Zm3 5h10v7H11Z" />
    <path class="prop-outline" d="M13 10h6v2h3v7h-3v2h-6v-2h-3v-7h3Z" />
    <path class="prop-sage" d="M14 12h4v2h2v3h-2v2h-4v-2h-2v-3h2Z" />
    <path class="prop-cream" d="M14 13h2v2h-2Z" />
  </svg>
</a>}
