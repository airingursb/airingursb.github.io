---
import './bird.css';
interface Props { place: 'window' | 'garden' }
const { place } = Astro.props;
---
<bear-bird data-place={place} data-state="away" hidden>
  <button type="button" aria-label="和小鸟打个招呼" disabled><span class="bear-bird-flight"><span class="bear-bird-sprite" aria-hidden="true"></span></span></button>
</bear-bird>
<script>
  import { BearBird } from './bird';
  if (!customElements.get('bear-bird')) customElements.define('bear-bird', BearBird);
</script>
