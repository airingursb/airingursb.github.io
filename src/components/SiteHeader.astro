---
import LangSwitch from './LangSwitch.astro';

interface Props {
  readonly lang?: 'zh' | 'en';
  readonly hasEnVersion?: boolean;
  readonly motto?: string;
  readonly breadcrumb?: string;
}

const currentPath = Astro.url.pathname;
const { lang = currentPath.startsWith('/en/') ? 'en' : 'zh', hasEnVersion = true, motto, breadcrumb } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const section = currentPath.replace(/^\/en\//, '/').split('/')[1] ?? '';
const blogSections = ['blog', 'posts', 'archive', 'tags', 'search'];
const links = [
  { path: 'blog', label: 'Blog', href: `${prefix}/blog/` },
  ...(section === 'comics' ? [{ path: 'archive', label: 'Archive', href: `${prefix}/archive/` }] : []),
  { path: 'moments', label: 'Moment', href: `${prefix}/moments/` },
  { path: 'notes', label: 'Notes', href: `${prefix}/notes/` },
  { path: 'reading', label: 'Reading', href: `${prefix}/reading/` },
  { path: 'photos', label: 'Photos', href: '/photos/' },
  ...(section === 'comics' ? [{ path: 'comics', label: 'Comics', href: `${prefix}/comics/` }] : []),
  { path: 'friends', label: 'Friends', href: `${prefix}/friends/` },
];
const activeSection = blogSections.includes(section) ? 'blog' : section;
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="site-header-rule"></div>
    <div class="site-header-bar">
      <a class="site-header-brand" href={`${prefix}/blog/`}>Airing's Blog</a>
      {motto && <span class="site-header-motto">{motto}</span>}
      <button class="site-header-toggle" type="button" aria-label={lang === 'en' ? 'Toggle navigation' : '展开或收起导航'} aria-expanded="false" aria-controls="site-navigation">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 4h12 M2 8h12 M2 12h12" /></svg>
      </button>
      <nav class="site-header-nav" id="site-navigation" aria-label={lang === 'en' ? 'Site navigation' : '全站导航'}>
        {links.map(link => <a href={link.href} aria-current={link.path === activeSection ? 'page' : undefined}>{link.label}</a>)}
      </nav>
    </div>
    <div class="site-header-meta">
      <slot name="meta">
        <span class="site-header-context"><slot />{breadcrumb}</span>
        {section !== 'photos' && <LangSwitch lang={lang} currentPath={currentPath} hasEnVersion={hasEnVersion} />}
      </slot>
    </div>
  </div>
</header>

<style>
  .site-header {
    --header-gutter: 48px;
    --header-gap: 16px;
    --header-font-size: 11px;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  .site-header-inner { max-width: 1200px; margin: 0 auto; padding: 0 var(--header-gutter); }
  .site-header-rule { height: 4px; background: var(--c-text); margin-top: 24px; }
  .site-header-bar { display: flex; justify-content: space-between; align-items: center; gap: var(--header-gap); padding: 14px 0; position: relative; }
  .site-header-brand { flex-shrink: 0; color: var(--c-text-muted); font-size: var(--header-font-size); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; }
  .site-header-motto { position: absolute; left: 50%; transform: translateX(-50%); color: var(--c-text-dim); font-size: 12px; font-style: italic; letter-spacing: .08em; pointer-events: none; }
  .site-header-nav { display: flex; gap: var(--header-gap); }
  .site-header-nav a { color: var(--c-text-dim); font-size: var(--header-font-size); font-weight: 400; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; white-space: nowrap; transition: color 150ms; }
  .site-header-brand:hover, .site-header-nav a:hover, .site-header-nav a[aria-current] { color: var(--c-text); }
  .site-header-meta { display: flex; justify-content: space-between; align-items: center; gap: var(--header-gap); min-height: 29px; padding: 4px 0 8px; border-bottom: 1px solid var(--c-border); color: var(--c-text-dim); font-size: var(--header-font-size); }
  .site-header-context { min-width: 0; overflow-wrap: anywhere; }
  .site-header-meta :global(.mast-date-line) { width: 100%; }
  .site-header-context :global(a) { color: var(--c-text-muted); }
  .site-header-toggle { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: var(--c-text); cursor: pointer; }
  .site-header a:focus-visible, .site-header-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 1100px) { .site-header-motto { display: none; } }
  @media (max-width: 768px) {
    .site-header { --header-gutter: 20px; }
    .site-header-bar { flex-wrap: wrap; padding: 0; min-height: 44px; }
    .site-header-nav { flex-wrap: wrap; width: 100%; gap: 0 var(--header-gap); }
    .site-header-nav a { display: flex; align-items: center; min-height: 44px; }
    .site-header[data-ready] .site-header-toggle { display: inline-flex; }
    .site-header[data-ready] .site-header-nav { display: none; position: absolute; top: 100%; right: 0; z-index: 100; width: min(240px, 100%); padding: 8px 16px; background: var(--c-bg); border: 1px solid var(--c-border); }
    .site-header[data-ready] .site-header-toggle[aria-expanded="true"] + .site-header-nav { display: flex; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .site-header-nav a { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.site-header').forEach(header => {
    const toggle = header.querySelector<HTMLButtonElement>('.site-header-toggle');
    const nav = header.querySelector<HTMLElement>('.site-header-nav');
    if (!toggle || !nav) return;
    header.dataset.ready = '';
    const close = () => toggle.setAttribute('aria-expanded', 'false');
    toggle.addEventListener('click', () => toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true')));
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !header.contains(event.target)) close();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
    nav.addEventListener('click', close);
    window.matchMedia('(max-width: 768px)').addEventListener('change', close);
  });
</script>
