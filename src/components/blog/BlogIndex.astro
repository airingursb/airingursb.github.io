---
// The compact post index the blog page's scripts read (⌘K search, heat-map
// month lists, `shuf`). Built from the posts collection at build time.
import type { ArchivePost, BlogLang } from '../../lib/blog-archive';
interface Props { posts: ArchivePost[]; lang: BlogLang }
const { posts, lang } = Astro.props;
const json = JSON.stringify({ lang, posts }).replace(/</g, '\\u003c');
---
<script type="application/json" id="blog-index" set:html={json}></script>
