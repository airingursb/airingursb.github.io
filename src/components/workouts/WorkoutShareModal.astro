---
// Share trigger + site-wide native share dialog for a workout.
// Rendered inside WorkoutHeader so the trigger sits in the header's flex row.
import { Image } from 'astro:assets';
import ShareDialog from '../ShareDialog.astro';
import { siteStrings } from '../../lib/i18n';

interface Props {
  ogImage?: string;
  shareUrl: string;
  shareTitle: string;
  lang?: 'zh' | 'en';
}
const { ogImage, shareUrl, shareTitle, lang = 'zh' } = Astro.props;
const d = siteStrings[lang].workouts.detailLabels;
const extension = ogImage?.split('?')[0].split('.').pop() || 'png';
---

<button type="button" class="workout-share-btn" data-share-open="workout-share" aria-label={d.shareHeading} title={d.share}>
  {/* Tabler TbPhotoShare */}
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15 8h.01" />
    <path d="M12.5 21h-6.5a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v6.5" />
    <path d="M3 16l5 -5c.928 -.875 2.072 -.875 3 0l3 3" />
    <path d="M14 14l1 -1c.617 -.582 1.327 -.79 2.012 -.626" />
    <path d="M16 22l5 -5" />
    <path d="M21 21.5v-4.5h-4.5" />
  </svg>
</button>

<ShareDialog
  id="workout-share"
  lang={lang}
  shareTitle={shareTitle}
  shareUrl={shareUrl}
  heading={d.shareHeading}
  kicker={d.shareKicker}
  caption={shareTitle}
  download={ogImage ? { href: ogImage, filename: `workout-card.${extension}`, label: d.saveCard } : undefined}
  openEvent="workout-share"
  actionEvent="workout-share-action"
>
  {ogImage
    ? <Image slot="preview" src={ogImage} alt={shareTitle} width={960} height={504} format="webp" quality={82} loading="lazy" decoding="async" />
    : <p slot="preview" class="site-share-caption">{d.noCard}</p>}
</ShareDialog>
