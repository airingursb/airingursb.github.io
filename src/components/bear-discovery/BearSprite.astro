---
interface Props { kind: 'lost'; autoplay?: boolean; }
const { kind, autoplay = false } = Astro.props;
---
<bear-sprite data-kind={kind} data-autoplay={autoplay ? '' : undefined} aria-hidden="true">
  <img src={`/bear-discovery/${kind}-poster.png`} width="128" height="144" alt="" />
  <canvas width="128" height="144" hidden></canvas>
</bear-sprite>
<script>import './sprite';</script>
<style>
  bear-sprite { display: block; position: relative; width: 100%; aspect-ratio: 128 / 144; }
  img, canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }
  canvas { position: absolute; inset: 0; }
  [hidden] { display: none; }
</style>
