---
import { getDeskContent } from './bear-study/desk-content';
import BearLifeProps from './bear-study/BearLifeProps.astro';
import BearWindow from './bear-study/BearWindow.astro';
import BearBird from './bear-study/BearBird.astro';
import BearContentPreview from './bear-study/BearContentPreview.astro';
import { readingPreview } from './bear-study/reading-preview';
import './bear-study/life.css';
interface Props { showcase?: boolean; lang?: 'zh' | 'en' }
const { showcase = false, lang = 'zh' } = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
const { generatedAt, post, photo, postPreview, photoPreview } = await getDeskContent();
---
<bear-home-study class="bear-home-study" lang={lang} data-generated-at={generatedAt} data-showcase={showcase ? 'true' : undefined} data-demo-hour={showcase ? '9' : undefined} data-demo-weather={showcase ? 'sunny' : undefined}>
  <div class="bear-art">
  <BearWindow />
  <BearBird place="window" />
  <img data-bear-poster src="/bear-study/poster.png" alt="" width="232" height="136" loading="eager" />
  <canvas data-bear-canvas width="232" height="160" aria-hidden="true" hidden></canvas>
  <span class="caption" data-caption role="status" aria-live="polite"></span>
  <span class="heart" aria-hidden="true"><svg viewBox="0 0 9 8"><path d="M1 0h2v1h1v1h1V1h1V0h2v1h1v3H8v1H7v1H6v1H5v1H4V7H3V6H2V5H1V4H0V1h1Z" /></svg></span>
  <div class="scene-controls" data-controls hidden>
    <button class="hotspot head" data-action="head" type="button" aria-label={t('摸摸小熊', 'Pet the bear')}></button>
    <button class="hotspot mug" data-action="drink" type="button" aria-label={t('让小熊喝一口', 'Let the bear take a sip')}></button>
    <button class="hotspot laptop" data-action="typing" type="button" aria-label={t('让小熊写代码', 'Let the bear type')}></button>
    <button class="hotspot plant" data-action="water" type="button" aria-label={t('让小熊给植物浇水', 'Water the plant')}></button>
  </div>
  <BearContentPreview idPrefix="desk" post={postPreview} photo={photoPreview} book={readingPreview} lang={lang} />
  <BearLifeProps post={post} photo={photo} />
  </div>
</bear-home-study>

<script>
  import './bear-study/analytics';
  import { DailyBear } from './bear-study/controller';
  if (!customElements.get('bear-home-study')) customElements.define('bear-home-study', DailyBear);
</script>

<style>
  .bear-home-study {
    --bear-width: 232px;
    --bear-heart: #d89987;
    display: block;
    position: relative;
    width: var(--bear-width);
    margin-inline: auto;
    line-height: 0;
  }
  img, canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .bear-home-study [hidden] { display: none; }
  button { font: inherit; cursor: pointer; color: var(--c-text-muted); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hotspot { position: absolute; border: 0; padding: 0; background: transparent; min-width: 44px; min-height: 44px; border-radius: 4px; }
  .head { left: 33%; top: 12%; width: 39%; height: 34%; }
  .mug { left: 4%; top: 57%; width: 20%; height: 33%; }
  .laptop { left: 51%; top: 57%; width: 22%; height: 33%; }
  .plant { left: 75%; top: 57%; width: 22%; height: 33%; }
  .caption { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; pointer-events: none; }
  .heart { position: absolute; top: 6%; left: 64%; display: none; color: var(--bear-heart); pointer-events: none; }
  .heart svg { width: 12px; height: 12px; fill: currentColor; }
  [data-state='pet'] .heart { display: block; }
  @media (max-width: 600px) { .bear-home-study { --bear-width: 200px; } }
</style>

<style is:global>
  .bear-study-wrapper { cursor: default; }
</style>
