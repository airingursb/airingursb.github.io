---
// Bottom shell prompt + `ls -la ~` jump window for the homepage chapters.
// Logic: src/scripts/home-nav.ts · chapters: src/data/home-chapters.ts
---
<script>
  import '../scripts/home-nav.ts';
</script>

<style is:global>
  /* ── 方案 C：底部终端提示符 + ls / ⌘K 命令面板 ── */
  .nc-ps {
    position: fixed;
    left: 50%;
    bottom: calc(22px + env(safe-area-inset-bottom));
    z-index: 150;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 150px);
    height: 38px;
    padding: 0 8px 0 12px;
    border: 1px solid rgba(var(--c-overlay-rgb), .12);
    border-radius: 9px;
    background: color-mix(in srgb, var(--c-bg) 80%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 14px 32px -14px rgba(0, 0, 0, .75), inset 0 1px 0 rgba(var(--c-overlay-rgb), .07);
    font: 13px/1 var(--font-mono);
    color: var(--c-text);
    white-space: nowrap;
    cursor: text;
    transform: translateX(-50%);
    transition: opacity .25s, transform .35s cubic-bezier(.2, .85, .25, 1), border-color .2s;
  }
  html[data-mode="light"] .nc-ps { box-shadow: 0 12px 26px -14px rgba(31, 35, 40, .45), inset 0 1px 0 #fff; background: color-mix(in srgb, var(--c-bg) 84%, transparent); }
  .nc-ps:hover { border-color: rgba(var(--accent-rgb), .45); }
  .nc-ps:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .nc-ps:not(.show) { opacity: 0; transform: translate(-50%, 70px); pointer-events: none; }
  html.nc-open .nc-ps { opacity: 0; transform: translate(-50%, 12px); pointer-events: none; }
  .nc-lights { flex: none; display: flex; gap: 5px; }
  .nc-lights i { width: 7px; height: 7px; border-radius: 50%; background: rgba(var(--c-overlay-rgb), .16); }
  .nc-ps:hover .nc-lights i:nth-child(1), .nc-win .nc-lights i:nth-child(1) { background: #ff5f57; }
  .nc-ps:hover .nc-lights i:nth-child(2), .nc-win .nc-lights i:nth-child(2) { background: #febc2e; }
  .nc-ps:hover .nc-lights i:nth-child(3), .nc-win .nc-lights i:nth-child(3) { background: #28c840; }
  .nc-line { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .nc-u { color: var(--accent); font-weight: 700; }
  .nc-c { color: var(--c-text-dim); }
  .nc-p { color: var(--c-text); }
  .nc-d { color: var(--c-text-muted); margin-left: 1px; }
  .nc-cur { display: inline-block; width: 7px; height: 14px; margin-left: 6px; vertical-align: -2px; background: var(--accent); animation: nc-blink 1.1s steps(1) infinite; }
  .nc-ps.typing .nc-cur { animation: none; }
  @keyframes nc-blink { 50% { opacity: 0; } }
  .nc-kbd { flex: none; display: flex; gap: 3px; margin-left: 4px; }
  .nc-kbd kbd {
    min-width: 18px;
    height: 20px;
    padding: 0 5px;
    border: 1px solid rgba(var(--c-overlay-rgb), .14);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: rgba(var(--c-overlay-rgb), .04);
    color: var(--c-text-muted);
    font: 11px/17px var(--font-mono);
    text-align: center;
  }
  
  /* 面板：一个小终端窗口 */
  .nc-scrim { position: fixed; inset: 0; z-index: 160; background: rgba(1, 4, 9, .5); opacity: 0; pointer-events: none; transition: opacity .2s; }
  html[data-mode="light"] .nc-scrim { background: rgba(31, 35, 40, .22); }
  html.nc-open .nc-scrim { opacity: 1; pointer-events: auto; }
  .nc-win {
    position: fixed;
    left: 50%;
    top: 14vh;
    z-index: 170;
    width: min(620px, calc(100vw - 32px));
    max-height: min(560px, 72vh);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(var(--c-overlay-rgb), .14);
    border-radius: 11px;
    background: color-mix(in srgb, var(--c-bg) 94%, var(--c-text));
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .8), 0 0 0 1px rgba(0, 0, 0, .3), inset 0 1px 0 rgba(var(--c-overlay-rgb), .06);
    font: 13px/1.5 var(--font-mono);
    color: var(--c-text-muted);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 10px) scale(.98);
    transition: opacity .18s, transform .25s cubic-bezier(.2, .85, .25, 1);
  }
  html[data-mode="light"] .nc-win { background: var(--c-bg); box-shadow: 0 24px 60px -20px rgba(31, 35, 40, .4), 0 0 0 1px rgba(31, 35, 40, .06), inset 0 1px 0 #fff; }
  html.nc-open .nc-win { opacity: 1; pointer-events: auto; transform: translate(-50%, 0) scale(1); }
  .nc-tb { position: relative; display: flex; align-items: center; height: 30px; padding: 0 12px; border-bottom: 1px solid rgba(var(--c-overlay-rgb), .07); background: rgba(var(--c-overlay-rgb), .025); }
  .nc-tb .t { position: absolute; left: 0; right: 0; text-align: center; font-size: 11px; color: var(--c-text-dim); pointer-events: none; }
  .nc-in { display: flex; align-items: center; gap: 0; padding: 12px 14px 10px; border-bottom: 1px solid rgba(var(--c-overlay-rgb), .07); white-space: nowrap; }
  .nc-in label { flex: none; }
  .nc-in input {
    flex: 1;
    min-width: 40px;
    margin-left: 8px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--c-text);
    font: inherit;
    caret-color: var(--accent);
  }
  .nc-in input::placeholder { color: var(--c-text-dim); }
  .nc-list { overflow-y: auto; overscroll-behavior: contain; padding: 6px 0; scrollbar-width: thin; }
  .nc-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 4px 14px;
    border: 0;
    background: transparent;
    color: var(--c-text-muted);
    font: inherit;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }
  .nc-row .m { flex: none; width: 10ch; font-size: 11px; color: var(--c-text-dim); }
  .nc-row .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--c-text); }
  .nc-row .fx { flex: none; font-size: 11px; color: var(--c-text-dim); }
  .nc-row .cm { min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: 12px; color: var(--c-text-dim); }
  .nc-row .r { margin-left: auto; flex: none; font-size: 11px; color: var(--c-text-dim); }
  .nc-row.dir { margin-top: 6px; }
  .nc-row.dir:first-child { margin-top: 0; }
  .nc-row.dir .nm { flex: none; color: var(--accent); font-weight: 700; }
  .nc-row.file .nm { padding-left: 2ch; }
  .nc-row.here .r { color: var(--accent); }
  .nc-row.sel { background: rgba(var(--accent-rgb), .10); box-shadow: inset 2px 0 0 var(--accent); }
  .nc-row.sel .nm { color: var(--c-text); }
  .nc-row.sel.dir .nm { color: var(--accent); }
  .nc-row mark { background: rgba(var(--accent-rgb), .25); color: inherit; border-radius: 2px; }
  .nc-empty { padding: 18px 14px; color: var(--c-text-dim); }
  .nc-ft { display: flex; gap: 14px; padding: 8px 14px; border-top: 1px solid rgba(var(--c-overlay-rgb), .07); font-size: 11px; color: var(--c-text-dim); white-space: nowrap; overflow: hidden; }
  .nc-ft b { font-weight: 400; color: var(--c-text-muted); }
  .nc-ft .n { margin-left: auto; }
  @media (max-width: 760px) {
    .nc-ps { max-width: calc(100vw - 128px); padding: 0 12px; gap: 8px; font-size: 12px; }
    .nc-ps .nc-u-host, .nc-kbd { display: none; }
    .nc-win { top: auto; bottom: 0; width: 100vw; max-height: 78vh; border-radius: 14px 14px 0 0; border-bottom: 0; transform: translate(-50%, 104%); padding-bottom: env(safe-area-inset-bottom); }
    html.nc-open .nc-win { transform: translate(-50%, 0); }
    .nc-row .m, .nc-row .cm .dd { display: none; }
    .nc-row { padding: 7px 16px; }
    .nc-in { padding: 12px 16px; font-size: 13px; }
    .nc-in .nc-u-host { display: none; }
    .nc-ft .k { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nc-cur { animation: none; }
    .nc-ps, .nc-win, .nc-scrim { transition: none; }
  }
</style>
