---
/**
 * Filmstrip index (胶片 C, `$ ranger figures/`). Only rendered when the post's
 * frontmatter has `filmstrip: true`. Desktop: a sticky ranger in the comment
 * rail; everywhere: a strip of all figures at the bottom of the image lightbox.
 * Logic: lib/article-filmstrip-rail.ts. Fewer than 3 figures: nothing.
 */
interface Props { lang?: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props;
const t = lang === 'en'
  ? { untitled: 'Intro', figure: 'fig {n}', keys: '↑↓ ⏎', lightboxKeys: '← → switch · esc close', prev: 'Previous image', next: 'Next image' }
  : { untitled: '开头', figure: '图 {n}', keys: '↑↓ ⏎', lightboxKeys: '← → 切换 · esc 关闭', prev: '上一张', next: '下一张' };
---

<template data-article-filmstrip data-strings={JSON.stringify(t)}></template>

<style is:global>
  html.has-filmstrip .comment-rail { align-self: stretch; }
  html.has-filmstrip .cr-cards .cm-card { z-index: 2; }
  .filmstrip {
    position: sticky; top: 40px; z-index: 1; margin: 28px 0 0 16px; padding: 12px;
    border: 1px solid rgba(var(--c-overlay-rgb), .08); border-radius: 8px; background: rgba(var(--c-overlay-rgb), .03);
    font-family: var(--font-mono); outline: none;
    transition: opacity .3s, filter .3s, transform .35s cubic-bezier(.3, .8, .3, 1);
  }
  .filmstrip:focus-visible { box-shadow: 0 0 0 2px rgba(var(--accent-rgb), .5); }
  .filmstrip.is-tucked { opacity: .14; filter: grayscale(1); }
  .fs-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; font-size: 12px; color: var(--c-text-muted); }
  .fs-head b { color: var(--accent); font-weight: 400; }
  .fs-count { font-variant-numeric: tabular-nums; letter-spacing: .04em; color: var(--c-text-dim); font-size: 11px; }
  .fs-count b { font-weight: 600; }
  .fs-preview { position: relative; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 4px; background: var(--c-bg-alt); }
  .fs-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fs-preview-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 8px 6px; font-size: 11px; line-height: 1.4; color: #e6edf3; background: linear-gradient(transparent, rgba(0, 0, 0, .72)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fs-list {
    max-height: max(150px, calc(100vh - 520px)); margin-top: 8px; padding: 6px 0; overflow-y: auto; scrollbar-width: none; overscroll-behavior: contain;
    -webkit-mask: linear-gradient(transparent, #000 14px, #000 calc(100% - 14px), transparent); mask: linear-gradient(transparent, #000 14px, #000 calc(100% - 14px), transparent);
  }
  .fs-list::-webkit-scrollbar { display: none; }
  .fs-row {
    display: grid; grid-template-columns: 18px 30px minmax(0, 1fr) auto; gap: 7px; align-items: center; width: 100%; margin: 0;
    padding: 3px 5px; border: 0; border-radius: 3px; background: none; font: 12px/20px var(--font-mono); text-align: left;
    color: var(--c-text-muted); cursor: pointer !important;
  }
  .fs-row:hover { background: rgba(var(--c-overlay-rgb), .05); color: var(--c-text); }
  .fs-row:focus-visible { outline: 1px solid var(--accent); outline-offset: -1px; }
  .fs-no { color: var(--c-text-dim); font-variant-numeric: tabular-nums; }
  .fs-thumb { width: 30px; height: 20px; border-radius: 2px; overflow: hidden; background: var(--c-bg-alt); }
  .fs-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fs-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fs-sec { color: var(--c-text-dim); font-size: 11px; }
  .fs-row.is-cur { background: var(--accent); color: #08130c; }
  .fs-row.is-cur .fs-no, .fs-row.is-cur .fs-sec { color: rgba(8, 19, 12, .7); }
  [data-mode="light"] .fs-row.is-cur { color: #fff; }
  [data-mode="light"] .fs-row.is-cur .fs-no, [data-mode="light"] .fs-row.is-cur .fs-sec { color: rgba(255, 255, 255, .8); }
  .filmstrip.is-before .fs-row.is-cur { background: rgba(var(--accent-rgb), .14); color: var(--c-text); }
  .filmstrip.is-before .fs-row.is-cur .fs-no, .filmstrip.is-before .fs-row.is-cur .fs-sec { color: var(--c-text-dim); }
  .fs-status { display: flex; justify-content: space-between; gap: 8px; margin-top: 8px; padding-top: 7px; border-top: 1px solid var(--c-border); font-size: 11px; color: var(--c-text-dim); white-space: nowrap; }
  .fs-status-l { overflow: hidden; text-overflow: ellipsis; color: var(--c-text-muted); white-space: pre; }

  /* Lightbox: the same figures as a strip along the bottom. */
  .img-zoom-overlay.has-filmstrip .img-zoom-img { max-height: calc(100vh - 190px); margin-bottom: 120px; }
  .fs-lightbox {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 8px 0 16px;
    background: rgba(13, 17, 23, .96); border-top: 1px solid #30363d; font-family: var(--font-mono); cursor: default;
  }
  .fs-lb-bar { display: flex; gap: 12px; align-items: baseline; max-width: 900px; margin: 0 auto 8px; padding: 0 20px; font-size: 12px; color: rgba(230, 237, 243, .7); white-space: nowrap; }
  .fs-lb-bar::before { content: '$ feh'; color: #4ade80; }
  .fs-lb-n { color: #4ade80; font-variant-numeric: tabular-nums; }
  .fs-lb-t { flex: 1; overflow: hidden; text-overflow: ellipsis; color: #e6edf3; }
  .fs-lb-k { color: rgba(230, 237, 243, .45); font-size: 11px; }
  .fs-lb-roll { display: flex; overflow-x: auto; scrollbar-width: none; padding: 0 50vw; scroll-snap-type: x proximity; }
  .fs-lb-roll::-webkit-scrollbar { display: none; }
  .fs-lb-frame {
    position: relative; flex: none; width: 76px; height: 54px; padding: 4px; margin: 0 4px 0 0; border: 0; border-radius: 4px;
    background: transparent; cursor: pointer !important; scroll-snap-align: center;
  }
  .fs-lb-frame img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 1px; opacity: .72; transition: opacity .2s; }
  .fs-lb-frame em { position: absolute; left: 6px; bottom: 6px; padding: 0 3px; font: 600 8px/1.3 var(--font-mono); font-style: normal; background: rgba(0, 0, 0, .65); color: #8b949e; }
  .fs-lb-frame:hover img, .fs-lb-frame.is-cur img { opacity: 1; }
  .fs-lb-frame.is-cur { background: #4ade80; }
  .fs-lb-frame.is-cur em { background: #4ade80; color: #08130c; }
  .fs-lb-nav {
    position: fixed; top: calc(50% - 90px); z-index: 4; width: 44px; height: 64px; border: 0; border-radius: 6px;
    background: rgba(0, 0, 0, .35); color: #e6edf3; font: 32px/1 var(--font-mono); cursor: pointer !important;
  }
  .fs-lb-prev { left: 16px; }
  .fs-lb-next { right: 16px; }
  .fs-lb-nav:hover { background: rgba(0, 0, 0, .6); }
  @media (max-width: 600px) {
    .fs-lb-k, .fs-lb-nav { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .filmstrip, .fs-lb-frame img { transition: none; }
  }
</style>

<script>
  import { mountArticleFilmstrip } from '../../lib/article-filmstrip-rail';
  const mount = () => {
    const host = document.querySelector<HTMLElement>('[data-article-filmstrip]');
    if (!host || host.dataset.mounted) return;
    host.dataset.mounted = 'true';
    const start = () => {
      const dispose = mountArticleFilmstrip(host);
      document.addEventListener('astro:before-swap', dispose, { once: true });
    };
    // Captions and positions need laid-out images; the list itself is cheap.
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  };
  mount();
  document.addEventListener('astro:page-load', mount);
</script>
