---
import EditorialActor from "./EditorialActor.astro";

interface Props {
  lang?: "zh" | "en";
}

const { lang = "zh" } = Astro.props;
---

<!-- Narrow screens only (≤ 1100px): the IP panda sits on the like card and
     closes its book. Desktop keeps the corner panda, which closes in place. -->
<div class="article-reading-dock" id="reading-end" data-article-pet-dock data-dock-state="floating">
  <button
    type="button"
    class="article-reading-replay"
    data-pet-replay
    aria-label={lang === "en" ? "Replay the panda closing its book" : "再看一次熊猫合上书"}
  >
    <EditorialActor kind="panda" motion="ip-panda/close" width={96} height={96} />
  </button>
</div>

<style>
  .article-reading-dock {
    --editorial-dock-size: 96px;
    inline-size: var(--editorial-dock-size);
    block-size: var(--editorial-dock-size);
  }
  .article-reading-dock[hidden] {
    display: none;
  }
  .article-reading-replay {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
  }
  .article-reading-replay:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  /* Dark mode: the same faint light rim as the corner panda. */
  :global(html:not([data-mode="light"])) .article-reading-dock :global(.editorial-actor) {
    filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.35)) drop-shadow(0 0 0.5px rgba(255, 255, 255, 0.3));
  }
  @media (min-width: 1101px) {
    .article-reading-dock {
      display: none;
    }
  }
  @media print {
    .article-reading-dock {
      display: none;
    }
  }
</style>

<script>
  import { createArticlePetDock } from "../../lib/article-pet-dock";

  const mount = () => {
    for (const dock of document.querySelectorAll<HTMLElement>("[data-article-pet-dock]")) {
      if (dock.dataset.dockReady) continue;
      dock.dataset.dockReady = "true";
      const dispose = createArticlePetDock(dock);
      document.addEventListener("astro:before-swap", dispose, { once: true });
    }
  };
  mount();
  document.addEventListener("astro:page-load", mount);
</script>
