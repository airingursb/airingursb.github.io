---
interface Props { slug: string }
const { slug } = Astro.props;
---
<living-cover data-slug={slug} hidden></living-cover>
<script>
  import './living-cover';
</script>
<style is:global>
  .article-card-art .living-cover-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    pointer-events: none; opacity: 0; transition: opacity 300ms ease;
  }
  .article-card-art .living-cover-video[data-playing] { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .article-card-art .living-cover-video { display: none; }
  }
</style>
