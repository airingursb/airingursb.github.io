---
interface Props {
  readonly slug: string;
  readonly mode?: 'card' | 'article';
}
const { slug, mode = 'card' } = Astro.props;
---
<living-cover data-slug={slug} data-mode={mode} hidden></living-cover>
<script>
  import './living-cover';
</script>
<style is:global>
  :is(.article-card-art, .article-cover-art) .living-cover-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    pointer-events: none; opacity: 0; transition: opacity 300ms ease;
  }
  :is(.article-card-art, .article-cover-art) .living-cover-video[data-playing] { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    :is(.article-card-art, .article-cover-art) .living-cover-video { display: none; }
  }
</style>
