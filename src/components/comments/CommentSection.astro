---
/**
 * Bottom comment thread + compose form shared by posts and notes.
 * Behaviour lives in comments-client.js (see CommentsRuntime.astro); the
 * surrounding page decides the outer layout (.bottom-comments padding) and the
 * font through --cm-font / --cm-title-font.
 */
import { commentStrings, type CommentLang } from './strings';
import './comments.css';

interface Props { lang?: CommentLang }
const { lang = 'zh' } = Astro.props;
const t = commentStrings(lang);
---
<section class="bottom-comments" id="bottomComments">
  <div class="bc-inner">
    <div class="bc-header">
      <h2 class="bc-title">{t.title}</h2>
      <span class="bc-count" id="bcCount">{t.countPending}</span>
    </div>
    <div class="bc-thread" id="bcThread"></div>
    <div class="bc-compose">
      <div class="bc-compose-avatar">
        <img id="bcComposeAvatar" src="https://gravatar.com/avatar/00000000000000000000000000000000?d=robohash&s=80" alt="" class="bc-avatar-img" />
      </div>
      <div class="bc-compose-form">
        <div class="bc-compose-fields">
          <input type="text" class="bc-input" id="bcNickname" placeholder={t.nickname} />
          <input type="email" class="bc-input" id="bcEmail" placeholder={t.email} />
          <input type="url" class="bc-input" id="bcWebsite" placeholder={t.website} />
        </div>
        <textarea class="bc-textarea" id="bcTextarea" placeholder={t.placeholder} rows="4"></textarea>
        <div class="bc-compose-footer">
          <label class="bc-notify-label">
            <input type="checkbox" id="bcNotify" />
            <span>{t.notify}</span>
          </label>
          <button type="button" class="bc-submit" id="bcSubmit">{t.submit}</button>
        </div>
      </div>
    </div>
  </div>
</section>
